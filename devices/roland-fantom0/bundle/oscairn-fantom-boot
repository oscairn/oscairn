#!/bin/sh
# What Roland's start script (/home/root/go.sh) runs before its application, once the owner
# changes it (docs/fantom-0.md, "Starting at power-on"), through the stable link
# /home/root/oscairn-current to the bundle in use:
#
#   [ -x /home/root/oscairn-current/oscairn-fantom-boot ] && /home/root/oscairn-current/oscairn-fantom-boot && [ -e /run/oscairn-boot-started ] && exit 0
#   /home/root/mi078
#
# Roland's application always starts first: on a cold start (Oscairn in its place, before it ever
# ran) the outputs stayed silent though the engine's ALSA output ran, and the screen twice stayed
# blank, while every start after Roland's application had run sounded and drew. Its start
# evidently sets up the audio path. So this script never starts Oscairn itself; it exits 3 (go.sh
# runs mi078) and, unless Roland's application was asked for, first leaves a takeover running in a
# unit of its own that starts Oscairn through the warm path a little later. By then go.sh has
# turned swap on, read the factory-test GPIO, set the date, written its register and loaded
# libcomposite, g_serial and tickgen.
#
#   1. Roland's application alone when: this script already ran this boot
#      (/run/oscairn-boot-tried); TEMPO is held (gpio-keys, key 152; WRITE held at power-on is the
#      bootloader's update mode; Roland's application waits for its release, held into its start
#      it opens its expansion screen) or cannot be read within 10 seconds; the file stock-next-boot
#      in the boot folder exists (removed as it is honored); the last power-on's takeover did not
#      finish (the file attempt is left while Oscairn takes over and removed once it runs or gives
#      up: a takeover that crashes or hangs the unit gives the next power-on to Roland's
#      application alone, and the one after it to the takeover again); the file dry-run in the boot
#      folder exists (the decision is logged, nothing is started); a file there cannot be written
#      (a full disk); or systemd-run fails.
#   2. Otherwise: systemd-run --unit=oscairn-takeover starts "oscairn-fantom-boot --takeover" as a
#      transient service, out of weston-term.service's control group (go.sh is that unit's main
#      process, and systemd kills the whole group when the unit ends or is stopped, which
#      oscairn-fantom-start does to stop Roland's application). Then exit 3 without
#      /run/oscairn-boot-started: go.sh runs mi078 as on a stock boot.
#   3. --takeover: waits for mi078 to run (60 s at most), then for it to hold the panel's device
#      /dev/i2c-slave-2 (60 s at most), the sign it has started its hardware, then
#      OSCAIRN_TAKEOVER_SETTLE seconds (10; a first guess, to be measured); TEMPO held (or
#      unreadable) now leaves Roland's application. Then oscairn-fantom-start, the warm path every
#      start by hand has used (it stops weston-term and mi078 and takes the panel within about a
#      second), given 120 seconds. Once Oscairn runs, attempt is removed,
#      /run/oscairn-boot-started left (for information) and step 4 follows.
#   4. It stays in the foreground while Oscairn runs, checking each second: what
#      oscairn-fantom-start started lives in this unit's control group, killed if the unit's main
#      process ended. Stopped on purpose (oscairn-fantom-stop leaves var/oscairn/run/stopped), it
#      stays while the panel holder runs (Oscairn started again by hand is watched the same way),
#      and ends once nothing of it runs.
#   5. The fallback, when the warm start fails or runs out of time, or the app and engine end
#      without oscairn-fantom-stop: oscairn-fantom-stop --panel. Roland's application is not
#      started again: started again after it had run earlier in the same boot it showed "program
#      version error". A power cycle, TEMPO held if Oscairn would take over again, gives Roland's
#      system. A start that failed before Roland's application was stopped leaves it running.
#
# Logged to stdout and boot.log in the boot folder, /home/root/oscairn-boot (outside the bundle,
# so it outlives a bundle's replacement), each line synced (a power cut seconds later lost the
# last lines of a boot).
#
#   ./oscairn-fantom-boot [--dry-run] [--takeover] [--supervise]
#
# --dry-run reads TEMPO (mounting the chroot to run oscairn-key-held) and the files, and prints
# what it would do, changing nothing but the log; with --takeover, the waits it would make and the
# warm start's --dry-run. --supervise is step 4 alone, for an Oscairn already started (and for
# tests: with --dry-run, the fallback is printed and not taken).
set -u
root=$(cd -P "$(dirname "$0")" && pwd -P) # the real folder: /proc/mounts names it so, never the oscairn-current link
dry="" supervise="" takeover=""
for a in "$@"; do
	case "$a" in
	--dry-run) dry=1 ;;
	--supervise) supervise=1 ;;
	--takeover) takeover=1 ;;
	*) echo "usage: $0 [--dry-run] [--takeover] [--supervise]" >&2; exit 2 ;;
	esac
done
# Stand-ins for a test, off the unit; on the unit these are left unset.
key_held=${OSCAIRN_KEY_HELD:-'"$root/start-chroot.sh" /usr/bin/oscairn-key-held gpio-keys 152'}
panel=${OSCAIRN_PANEL_DEVICE:-/dev/i2c-slave-2}
proc=${OSCAIRN_PROC:-/proc}
poll=${OSCAIRN_BOOT_POLL:-1}
boot=${OSCAIRN_BOOT_DIR:-/home/root/oscairn-boot}
run=${OSCAIRN_BOOT_RUN:-/run}
limit=${OSCAIRN_BOOT_LIMIT:-120}
systemd_run=${OSCAIRN_SYSTEMD_RUN:-systemd-run}
settle=${OSCAIRN_TAKEOVER_SETTLE:-10}
wait_limit=${OSCAIRN_TAKEOVER_WAIT:-60}
state=$root/var/oscairn
log=$boot/boot.log
mkdir -p "$boot" 2>/dev/null

say() {
	echo "oscairn-fantom-boot: $*"
	echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$log" 2>/dev/null
	sync
}
named() { for c in "$proc"/[0-9]*/comm; do [ "$(cat "$c" 2>/dev/null)" = "$1" ] && { p=${c#"$proc"/}; echo "${p%%/*}"; }; done; }
holding() {
	for f in "$proc"/[0-9]*/fd/*; do
		case "$(readlink "$f" 2>/dev/null)" in *"$1") p=${f#"$proc"/}; echo "${p%%/*}" ;; esac
	done | sort -u
}
mi078_holds() { h=" $(echo $(holding "$panel")) "; for p in $(named mi078); do case $h in *" $p "*) return 0 ;; esac; done; return 1; }
# A command given $1 seconds, then ended (status 143).
bounded() {
	lim=$1; shift
	"$@" & pid=$!
	# Its own output closed: a sleep outliving the killed watchdog holds no one's pipe.
	( exec > /dev/null 2>&1; sleep "$lim" && kill "$pid" ) & dog=$!
	wait "$pid"; st=$?
	kill "$dog" 2>/dev/null
	return $st
}
# Roland's application: go.sh starts it when this exits non-zero.
roland() {
	say "Roland's application: $1"
	others=$(holding "$panel")
	if [ -n "$others" ]; then
		say "process $(echo $others) still holds $panel; Roland's application is not started (a second open can crash the kernel)"
		exit 0
	fi
	say "go.sh runs /home/root/mi078"
	exit 3
}
# The takeover ending without Oscairn: Roland's application left as it is, attempt removed.
leave() { say "$1; Roland's application stays"; [ -n "$dry" ] || rm -f "$boot/attempt"; exit 0; }

# 5. The fallback: what Oscairn started stopped, the panel holder too.
fallback() {
	say "$1; stopping what it started"
	if [ -n "$takeover" ] && [ -n "$(named mi078)" ]; then leave "Roland's application (mi078) was not stopped"; fi
	if [ -n "$dry" ]; then say "would run: $root/oscairn-fantom-stop --panel"; else bounded 60 "$root/oscairn-fantom-stop" --panel; rm -f "$boot/attempt"; fi
	if [ -n "$takeover" ]; then
		say "Roland's application cannot be started again this boot (it shows \"program version error\" after a restart); a power cycle, holding TEMPO if needed, gives Roland's system"
		exit 0
	fi
	roland "Oscairn did not start or did not keep running"
}
# 4. In the foreground for as long as Oscairn runs (above).
watch() {
	quiet=""
	while :; do
		if [ -n "$(named Oscairn)$(named oscairn-engine)$(named oscairn-ui)" ]; then
			[ -n "$quiet" ] || say "Oscairn runs; staying in the foreground while it does"
			quiet=1
		elif [ -e "$state/run/stopped" ]; then
			[ -n "$(named oscairn-panel-h)" ] || { say "stopped on purpose and the panel holder is gone: nothing left to keep"; exit 0; }
			[ "$quiet" = held ] || say "Oscairn was stopped on purpose (oscairn-fantom-stop); staying while the panel holder runs"
			quiet=held
		else
			fallback "the app and its engine ended without oscairn-fantom-stop"
		fi
		sleep "$poll"
	done
}
[ -z "$supervise" ] || watch

# 3. The takeover, in its own unit, once Roland's application has set up the hardware.
if [ -n "$takeover" ]; then
	say "takeover: waiting for Roland's application"
	if [ -n "$dry" ]; then
		say "would wait (at most $wait_limit s) for mi078 to run, then (at most $wait_limit s) for it to hold $panel, then $settle s"
	else
		i=0
		until [ -n "$(named mi078)" ]; do
			i=$((i + 1)); [ $i -le "$wait_limit" ] || leave "mi078 did not start within $wait_limit seconds"; sleep 1
		done
		i=0
		until mi078_holds; do
			i=$((i + 1)); [ $i -le "$wait_limit" ] || leave "mi078 did not open $panel within $wait_limit seconds"; sleep 1
		done
		say "mi078 holds $panel; waiting $settle seconds for it to settle"
		sleep "$settle"
	fi
	bounded 10 eval "$key_held"
	held=$?
	[ $held -eq 1 ] || leave "TEMPO held or unreadable at takeover (oscairn-key-held exited $held)"
	if [ -n "$dry" ]; then
		bounded "$limit" "$root/oscairn-fantom-start" --dry-run || fallback "oscairn-fantom-start --dry-run failed"
		say "would remove $boot/attempt, write $run/oscairn-boot-started and stay in the foreground while Oscairn runs"
		exit 0
	fi
	say "starting Oscairn (oscairn-fantom-start)"
	bounded "$limit" "$root/oscairn-fantom-start" || fallback "oscairn-fantom-start failed or ran out of its $limit seconds"
	rm -f "$boot/attempt"
	: > "$run/oscairn-boot-started"
	watch
fi

# 1. Roland's application alone when asked for, or when anything is not as expected.
say "power-on, bundle $root"
if [ -z "$dry" ]; then
	[ ! -e "$run/oscairn-boot-tried" ] || roland "this script already ran this boot"
	: > "$run/oscairn-boot-tried" || roland "cannot write $run/oscairn-boot-tried"
fi
bounded 10 eval "$key_held"
held=$?
if [ $held -eq 0 ]; then
	# Roland's app opens its expansion screen when it starts with TEMPO still down: wait (60 s at
	# most) for the hand to let go first.
	i=0
	while [ $i -lt "${OSCAIRN_BOOT_RELEASE:-120}" ]; do bounded 10 eval "$key_held"; [ $? -eq 0 ] || break; i=$((i + 1)); sleep 0.5 2>/dev/null || sleep 1; done
	roland "TEMPO was held"
fi
[ $held -eq 1 ] || roland "TEMPO cannot be read (oscairn-key-held exited $held)"
if [ -e "$boot/stock-next-boot" ]; then
	if [ -n "$dry" ]; then say "would remove $boot/stock-next-boot"; else rm -f "$boot/stock-next-boot"; fi
	roland "stock-next-boot was set"
fi
if [ -e "$boot/attempt" ]; then
	if [ -n "$dry" ]; then say "would remove $boot/attempt"; else rm -f "$boot/attempt"; fi
	roland "the last power-on's takeover by Oscairn did not finish ($boot/attempt was left)"
fi
[ ! -e "$boot/dry-run" ] || dry=1

# 2. Oscairn at once: oscairn-fantom-start --cold sets up the audio port's receive side itself
# (its step 5b), which is all a cold start lacked for sound. The file roland-first in the boot
# folder keeps the takeover below instead (Roland's application first, Oscairn after it).
if [ ! -e "$boot/roland-first" ]; then
	say "starting Oscairn (oscairn-fantom-start --cold)"
	if [ -n "$dry" ]; then
		bounded "$limit" "$root/oscairn-fantom-start" --dry-run --cold || roland "oscairn-fantom-start --dry-run --cold failed"
		say "would stay in the foreground while the engine runs, and fall back to Roland's application if it ends without oscairn-fantom-stop"
		roland "a dry run"
	fi
	: > "$boot/attempt" || roland "cannot write $boot/attempt"
	: > "$run/oscairn-boot-started" || roland "cannot write $run/oscairn-boot-started"
	bounded "$limit" "$root/oscairn-fantom-start" --cold || fallback "oscairn-fantom-start --cold failed or ran out of its $limit seconds"
	rm -f "$boot/attempt"
	watch
fi

# 2b. The takeover scheduled, then Roland's application.
set -- --unit=oscairn-takeover --collect --no-block --description="Oscairn takes over from Roland's application" "$root/oscairn-fantom-boot" --takeover
if [ -n "$dry" ]; then
	say "would write $boot/attempt and run: $systemd_run $*"
	roland "a dry run"
fi
: > "$boot/attempt" || roland "cannot write $boot/attempt"
if ! "$systemd_run" "$@"; then
	rm -f "$boot/attempt"
	roland "$systemd_run failed; no takeover this boot"
fi
say "Roland's application first; Oscairn takes over once it has set up the sound (oscairn-takeover.service)"
roland "first, as on a stock boot"
