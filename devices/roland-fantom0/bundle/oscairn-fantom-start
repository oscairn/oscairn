#!/bin/sh
# Starts Oscairn on a Roland FANTOM-0 from the chroot bundle this script sits in
# (docs/fantom-0.md, "Starting Oscairn on the unit"). Run by hand, as root, from outside the
# chroot; nothing starts it at boot and Roland's go.sh is not touched. In order:
#
#   1. refuses to run while another start runs or Oscairn's engine already runs, and removes
#      the SysV shared memory that ended processes left unattached (a killed app's window image);
#   2. mounts the bundle's /proc, /sys, /dev, /run and /tmp (start-chroot.sh), so the panel
#      holder can start the moment Roland's application has gone;
#   3. stops Roland's application (systemctl stop weston-term) if it runs, and waits until its
#      process (mi078) is gone;
#   4. at once takes the panel: checks that no process holds /dev/i2c-slave-2 and starts
#      oscairn-panel-holder, which holds it until the system goes down. The panel only keeps
#      reporting while something holds the device: left unheld for about a minute it went
#      silent until the next power-on, so the gap between Roland's application letting go and
#      the holder taking over must stay under about a second. A holder already running is kept;
#   5. holds every CPU at its top frequency (the performance governor) while Oscairn runs,
#      recording what each had for oscairn-fantom-stop;
#   6. starts the app on the display (/usr/bin/Oscairn --profile with the profile's id, on :0),
#      which starts its own engine with the profile's audio device, keys, panel and input keys,
#      when the profile has a screen. The display is Oscairn's own first: Roland's Weston is
#      stopped (systemctl stop weston.service; oscairn-fantom-stop starts it again) and the
#      bundle's X server serves :0 with the bundle's /etc/X11/xorg.conf, started again with the
#      app if it ends; if it does not come up, Weston is started again and the app goes on it.
#      With --engine-only, or for a profile without one, the
#      engine alone (oscairn-engine-run) with the profile's options instead
#      (etc/default/oscairn-engine, written from the profile when the bundle was built), its
#      startup Performance played by the panel through the profile's control groups. Either way
#      the engine reads the panel from the holder and, as it opens /dev/ttyGS0, tells Roland's
#      sound engine Local Switch off (the profile's keyboard.localOff), so it does not sound the
#      keys under Oscairn; Roland's application has stopped by then. It stays off until a power
#      cycle;
#   7. reports whether the engine came up: its session.status, asked within 20 seconds of its
#      start (40 for the app's), or its log's last lines and a failure.
#
# Between Roland's application stopping and the engine opening /dev/ttyGS0 nothing reads the
# keys' link; Roland's sound engine then queues what is not read, and after a long gap on the
# unit it was left with notes stuck on. A few seconds, as this script takes, were harmless.
#
# Each step is logged here and to var/oscairn/log/oscairn-fantom.log in the bundle (the bundle's
# var/log is a link to its /tmp, which stop-chroot.sh unmounts). oscairn-fantom-stop stops it.
#
#   ./oscairn-fantom-start [--dry-run] [--cold] [--engine-only]
#
# --dry-run checks what it can without changing anything (another start, Roland's application,
# who holds the panel) and prints the steps it would take instead of taking them. --cold is for
# a boot on which Roland's application never ran (oscairn-fantom-boot): there is nothing to stop,
# and Roland's application running is a failure. --engine-only starts the engine without the
# app, for measuring the engine alone and for tests.
set -u
root=$(cd "$(dirname "$0")" && pwd)
dry="" cold="" alone=""
for a in "$@"; do
	case "$a" in
	--dry-run) dry=1 ;;
	--cold) cold=1 ;;
	--engine-only) alone=1 ;;
	*) echo "usage: $0 [--dry-run] [--cold] [--engine-only]" >&2; exit 2 ;;
	esac
done
# Stand-ins for a test, off the unit; on the unit these are left unset.
panel=${OSCAIRN_PANEL_DEVICE:-/dev/i2c-slave-2}
proc=${OSCAIRN_PROC:-/proc}
ipcrm=${OSCAIRN_IPCRM:-ipcrm}
state=$root/var/oscairn
log=$state/log/oscairn-fantom.log
[ -n "$dry" ] || mkdir -p "$state/log" "$state/run" || exit 1

say() {
	echo "oscairn-fantom-start: $*"
	[ -n "$dry" ] || echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$log"
}
fail() { say "$*"; exit 1; }
# Runs a step, or under --dry-run prints it.
run() { if [ -n "$dry" ]; then say "would run: $*"; else "$@"; fi; }
nap() { sleep 0.1 2>/dev/null || sleep 1; }
# Processes by name, and processes holding a path open (through the bundle's /dev too).
named() { for c in "$proc"/[0-9]*/comm; do [ "$(cat "$c" 2>/dev/null)" = "$1" ] && { p=${c#"$proc"/}; echo "${p%%/*}"; }; done; }
holding() {
	for f in "$proc"/[0-9]*/fd/*; do
		case "$(readlink "$f" 2>/dev/null)" in *"$1") p=${f#"$proc"/}; echo "${p%%/*}" ;; esac
	done | sort -u
}
holder_running() { grep -q '@oscairn-panel$' "$proc/net/unix" 2>/dev/null; }

# 1. Once only.
if [ -z "$dry" ]; then
	mkdir "$state/run/start.lock" 2>/dev/null || fail "another oscairn-fantom-start is running (or left $state/run/start.lock behind)"
	trap 'rmdir "$state/run/start.lock" 2>/dev/null' EXIT
fi
engine=$(named oscairn-engine)
[ -z "$engine" ] || fail "Oscairn's engine already runs (pid $engine); oscairn-fantom-stop stops it"
app=$(named Oscairn)
[ -z "$app" ] || fail "Oscairn's app already runs (pid $app); oscairn-fantom-stop stops it"

# SysV shared memory left behind by earlier app processes: before JUCE's window image was marked
# for removal at creation (hosts/juce-patches), each killed app left a 3.7 MB segment that filled
# swap after a crash loop (docs/fantom-0.md). Removed only when nothing can still use it: a
# private segment (key 0), attached nowhere, of this user, whose creator has ended.
left=$(awk -v me="$(id -u)" 'NR == 1 { for (i = 1; i <= NF; i++) c[$i] = i; next }
	$c["key"] == 0 && $c["nattch"] == 0 && $c["uid"] == me && $c["cuid"] == me { print $c["shmid"], $c["cpid"], $c["size"] }' "$proc/sysvipc/shm" 2>/dev/null |
	while read -r id cpid size; do [ -d "$proc/$cpid" ] || echo "$id:$cpid:$size"; done)
if [ -n "$left" ] && ! command -v "$ipcrm" > /dev/null 2>&1; then
	say "no $ipcrm here: not removing the shared memory ended processes left ($(echo $left | wc -w) segments)"
else
	for s in $left; do
		id=${s%%:*} rest=${s#*:}
		say "removing shared memory $id left by ended process ${rest%%:*} (${rest#*:} bytes)"
		run "$ipcrm" -m "$id" || say "$ipcrm -m $id failed; continuing"
	done
fi

# 2. The chroot's mounts first: mounting changes nothing Roland's application uses, and done
# now it is not in the gap below.
say "mounting the bundle's /proc, /sys, /dev, /run and /tmp"
run "$root/start-chroot.sh" true || fail "start-chroot.sh failed"

# 3. Roland's application.
if [ -n "$cold" ]; then
	[ -z "$(named mi078)" ] || fail "--cold, but Roland's application (mi078) runs"
elif command -v systemctl > /dev/null 2>&1 && systemctl is-active --quiet weston-term; then
	say "stopping Roland's application (systemctl stop weston-term)"
	run systemctl stop weston-term || fail "systemctl stop weston-term failed"
elif [ -n "$(named mi078)" ]; then
	fail "Roland's application (mi078) runs, but not as weston-term: stop it first"
fi
if [ -z "$dry" ]; then
	i=0
	while [ -n "$(named mi078)" ]; do
		i=$((i + 1))
		[ $i -le 150 ] || fail "Roland's application (mi078) has not ended after 15 seconds; the panel is not taken"
		nap
	done
fi
say "Roland's application is not running"

# 4. The panel, at once.
if holder_running; then
	say "the panel holder already runs: kept"
else
	[ -e "$panel" ] || say "the panel device $panel is not here: the panel will not be read"
	others=$(holding "$panel")
	[ -z "$others" ] || fail "process $(echo $others) holds $panel; not opening it (a second open can crash the kernel)"
	say "taking the panel: oscairn-panel-holder $panel"
	if [ -z "$dry" ]; then
		: > "$state/log/oscairn-panel-holder.log"
		"$root/start-chroot.sh" /usr/bin/oscairn-panel-holder "$panel" >> "$state/log/oscairn-panel-holder.log" 2>&1 &
		i=0
		until grep -q "holding $panel" "$state/log/oscairn-panel-holder.log"; do
			i=$((i + 1))
			if [ $i -gt 50 ] || ! kill -0 $! 2>/dev/null; then
				tail -n 5 "$state/log/oscairn-panel-holder.log"
				fail "the panel holder did not take $panel"
			fi
			nap
		done
		say "the panel is held (var/oscairn/log/oscairn-panel-holder.log)"
	else
		say "would run: $root/start-chroot.sh /usr/bin/oscairn-panel-holder $panel"
	fi
fi

# The start word, on a boot on which Roland's application never ran: when Roland's application
# starts it sends the panel 0c 00 75 00 80 30 00 00 .. 04 (to 0x75 over /dev/ttyGS0). A takeover
# after Roland's application had run needed none, and the word did not revive a panel that had
# gone silent; whether a cold panel waits for it is not known. Disabled: to be tried on the unit
# before it is enabled.
# [ -n "$cold" ] && send the start word here

# -- Not done yet; each goes here when it is known: --------------------------------------------
# USB MIDI on USB MEMORY: modprobe snd-usb-audio, outside the chroot (Roland's module); on
#   November 12 the kernel loaded it by itself when a keyboard was plugged in.
# ------------------------------------------------------------------------------------------------

# 5. The CPUs at their top frequency: on the unit, with ondemand at 128 frames the engine took
# 0.23 of a block at rest, with performance 0.20 (docs/fantom-0.md). A sysfs setting: it is back
# at power-on, and oscairn-fantom-stop puts back what is recorded here.
saved=$state/run/governors
for g in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do
	[ -w "$g" ] || continue
	if [ -n "$dry" ]; then say "would set $g to performance (now $(cat "$g"))"; continue; fi
	grep -q "^$g " "$saved" 2>/dev/null || echo "$g $(cat "$g")" >> "$saved"
	echo performance > "$g" && say "$g: performance" || say "cannot set $g; continuing"
done
[ -e "$g" ] || say "no CPU frequency governor here: nothing to set"

# 6. The app, or the engine alone, with the profile's options. The cores its audio threads keep to: this script's
# environment's OSCAIRN_AUDIO_THREAD_CORES ("1-3"), else the file's (the profile's
# compute.audioThreadCores); none, anywhere. OSCAIRN_WORKER_BUDGET_US and
# OSCAIRN_WORKER_EXTRA_BLOCK (RFC 0045), OSCAIRN_THP (keep: transparent huge pages left on, for
# measuring), OSCAIRN_CPU_LATENCY (keep: no CPU wake-up latency request, for measuring) and
# OSCAIRN_WORKER_SPIN_US (the profile's compute.workerSpin; 0: none) are handed over the same way,
# and OSCAIRN_WORKER_DEADLINE (1: each worker waits to its wave's deadline, RFC 0045 step 6),
# and OSCAIRN_SHARING (cpu: parts' instruments not shared on their own),
# and OSCAIRN_PLUGIN_HOSTS (the profile's compute.pluginHosts; 0: a worker per plugin instance, RFC 0045)
# and OSCAIRN_OWN_HOST (plugin IDs given workers of their own),
# and so is every OSCAIRN_SAMPLER_*, OSCAIRN_ANALOG_*, OSCAIRN_FM_*,
# OSCAIRN_ARPEGGIATOR_* and OSCAIRN_EFFECTS_* (the first-party plugins' device settings, which
# they read when an instance is created): refused, with a failure, when a value holds anything
# but letters, digits and . , : / = @ % + _ - (no quoting is attempted). start-chroot.sh passes
# no environment on, so they are handed over here.
cores=${OSCAIRN_AUDIO_THREAD_CORES:-} budget=${OSCAIRN_WORKER_BUDGET_US:-} extra=${OSCAIRN_WORKER_EXTRA_BLOCK:-} thp=${OSCAIRN_THP:-} latency=${OSCAIRN_CPU_LATENCY:-} spin=${OSCAIRN_WORKER_SPIN_US:-} deadline=${OSCAIRN_WORKER_DEADLINE:-} sharing=${OSCAIRN_SHARING:-} hosts=${OSCAIRN_PLUGIN_HOSTS:-} own=${OSCAIRN_OWN_HOST:-}
# The plugin settings: the caller's, taken before the file is sourced (it would overwrite an
# exported one), then the file's, the first of a name winning (a shortcut: a value holding a
# newline is not handled).
plugvars='^OSCAIRN_(SAMPLER|ANALOG|FM|ARPEGGIATOR|EFFECTS)_[A-Za-z0-9_]+=.'
callers=$(env | grep -E "$plugvars")
[ -f "$root/etc/default/oscairn-engine" ] && . "$root/etc/default/oscairn-engine"
merged=$( { printf '%s\n' "$callers"; ( set -a; [ -f "$root/etc/default/oscairn-engine" ] && . "$root/etc/default/oscairn-engine"; env | grep -E "$plugvars" ); } | awk -F= 'NF && !seen[$1]++' | sort )
plug=""
if [ -n "$merged" ]; then
	bad=$(printf '%s\n' "$merged" | grep -vE '^[A-Za-z0-9_]+=[A-Za-z0-9_.,:/=@%+-]*$' | head -n 1)
	[ -z "$bad" ] || fail "${bad%%=*}: the value must hold only letters, digits and . , : / = @ % + _ - (nothing is quoted for it)"
	plug="$(printf '%s\n' "$merged" | tr '\n' ' ')" # unquoted below: no spaces in a value
fi
cores=${cores:-${OSCAIRN_AUDIO_THREAD_CORES:-}}
budget=${budget:-${OSCAIRN_WORKER_BUDGET_US:-}} extra=${extra:-${OSCAIRN_WORKER_EXTRA_BLOCK:-}} thp=${thp:-${OSCAIRN_THP:-}} latency=${latency:-${OSCAIRN_CPU_LATENCY:-}} spin=${spin:-${OSCAIRN_WORKER_SPIN_US:-}} deadline=${deadline:-${OSCAIRN_WORKER_DEADLINE:-}} sharing=${sharing:-${OSCAIRN_SHARING:-}} hosts=${hosts:-${OSCAIRN_PLUGIN_HOSTS:-}} own=${own:-${OSCAIRN_OWN_HOST:-}}
tuning="${budget:+OSCAIRN_WORKER_BUDGET_US=$budget }${extra:+OSCAIRN_WORKER_EXTRA_BLOCK=$extra }${thp:+OSCAIRN_THP=$thp }${latency:+OSCAIRN_CPU_LATENCY=$latency }${spin:+OSCAIRN_WORKER_SPIN_US=$spin }${deadline:+OSCAIRN_WORKER_DEADLINE=$deadline }${sharing:+OSCAIRN_SHARING=$sharing }${hosts:+OSCAIRN_PLUGIN_HOSTS=$hosts }${own:+OSCAIRN_OWN_HOST=$own }" # unquoted below: no spaces in a value
[ -n "${OSCAIRN_ENGINE_ARGS:-}" ] || fail "no OSCAIRN_ENGINE_ARGS in $root/etc/default/oscairn-engine"
rm -f "$state/run/stopped" # not stopped on purpose (oscairn-fantom-stop's mark)
# The display (docs/fantom-0.md, "The display"). Under Roland's Weston, with its GPU 2D renderer,
# the audio threads stalled while the app drew (ST Final, 41 s: 774 deadline misses against 0 on
# the bundle's own X server), so Oscairn owns the display: weston.service stopped (nothing of
# Roland's changed; oscairn-fantom-stop starts it again) and the bundle's Xorg on :0, configured
# by the bundle's /etc/X11/xorg.conf, logged to var/oscairn/log/Xorg.log.
xorg_ours() { for p in $(named Xorg); do [ "$(readlink "$proc/$p/root")" = "$root" ] && echo "$p"; done; }
display_up() { grep -q '@/tmp/.X11-unix/X0$' "$proc/net/unix" 2>/dev/null; }
# A client served on :0 within 5 seconds: the socket alone is not enough, as the X server opens it
# before its screen, and one failing on its configuration had it for a moment.
display_serves() {
	"$root/start-chroot.sh" xwininfo -display :0 -root > /dev/null 2>&1 &
	q=$! j=0
	while kill -0 $q 2>/dev/null; do j=$((j + 1)); [ $j -le 50 ] || { kill $q; return 1; }; nap; done
	wait $q
}
# Roland's Weston back, its Xwayland on :0 (it starts on the first client), as before Oscairn owned the display.
weston_back() {
	command -v systemctl > /dev/null 2>&1 && systemctl start weston.service || return 1
	i=0
	until display_up && display_serves; do i=$((i + 1)); [ $i -le 150 ] || return 1; nap; done
}
# The app, by its full path, which it finds its engine and plugins beside; its locked memory
# unlimited for the engine it starts, as oscairn-engine-run does for one alone. Started again
# after the X server ended, it reconnects to the engine that went on playing.
app_start() {
	"$root/start-chroot.sh" setsid env DISPLAY=:0 ${cores:+OSCAIRN_AUDIO_THREAD_CORES="$cores"} $tuning$plug\
		sh -c 'ulimit -l unlimited || echo "oscairn-fantom-start: cannot raise the locked-memory limit; continuing" >&2; exec "$@"' sh \
		/usr/bin/Oscairn --profile "$OSCAIRN_PROFILE" --plugins /usr/lib/clap >> "$state/log/oscairn-app.log" 2>&1 &
	echo $! > "$state/run/app.pid"
}
# Runs the X server, and runs it again whenever it ends without oscairn-fantom-stop (whose mark
# it then finds), the app too once the new server is up if the app ended with the old one (an X
# client ends with its server; the engine plays on meanwhile). Ended three times within a minute
# of starting, it gives the display back to Weston and puts the app there.
keep_display() {
	fails=0
	# This keeper's mark: a restart left waiting from an earlier one, or after a stop, starts nothing.
	token=$(cat "$proc/sys/kernel/random/uuid" 2>/dev/null || date +%s)
	echo "$token" > "$state/run/display.keeper"
	while :; do
		t0=$(date +%s)
		"$root/start-chroot.sh" /usr/bin/Xorg :0 vt7 -novtswitch -nolisten tcp -noreset -nocursor -logfile /var/oscairn/log/Xorg.log < /dev/null
		status=$?
		[ ! -e "$state/run/stopped" ] || exit 0
		ran=$(($(date +%s) - t0))
		[ $ran -lt 60 ] || fails=0
		fails=$((fails + 1))
		if [ $fails -ge 3 ]; then
			say "the X server ended (status $status) a third time within a minute of starting: Roland's Weston back (systemctl start weston.service), the app on it"
			weston_back || say "Weston did not come back either: the screen stays dark; the engine plays on, oscairn-fantom-stop and start again"
			# Not on the first start, before the app was started at all: the start puts it there itself.
			[ -n "$(named Oscairn)" ] || [ ! -e "$state/run/app.pid" ] || app_start
			exit 1
		fi
		say "the X server ended (status $status) after $ran s without oscairn-fantom-stop: starting it again, and the app if it ended with it"
		# Once this X server is up, and only for an app that was started (not before the first
		# start's own) and only one at a time: Weston's display, if it comes to that, gets the app
		# from the fallback above.
		(
			i=0
			until [ -n "$(xorg_ours)" ] && display_up && display_serves; do i=$((i + 1)); [ $i -le 100 ] || exit 0; nap; done
			ours() { [ ! -e "$state/run/stopped" ] && [ "$(cat "$state/run/display.keeper" 2>/dev/null)" = "$token" ]; }
			ours && [ -e "$state/run/app.pid" ] && mkdir "$state/run/app-restart.lock" 2>/dev/null || exit 0
			i=0
			while [ -n "$(named Oscairn)" ] && [ $i -lt 30 ]; do i=$((i + 1)); nap; done # the old app ending with its server
			if [ -n "$(named Oscairn)" ]; then say "the app outlived the X server: left as it is"
			elif ours; then say "starting the app again"; app_start
			fi
			sleep 5; rmdir "$state/run/app-restart.lock"
		) &
	done
}
# The app, on a profile with a screen (OSCAIRN_HEADLESS=0), on the display above.
if [ -z "$alone" ] && [ "${OSCAIRN_HEADLESS:-1}" = 0 ] && [ -n "${OSCAIRN_PROFILE:-}" ]; then
	if [ -n "$dry" ]; then
		say "would run: systemctl stop weston.service (when it is active)"
		say "would run: $root/start-chroot.sh /usr/bin/Xorg :0 vt7 -novtswitch -nolisten tcp -noreset -nocursor -logfile /var/oscairn/log/Xorg.log (with the bundle's /etc/X11/xorg.conf), started again if it ends"
	else
		if command -v systemctl > /dev/null 2>&1 && systemctl is-active --quiet weston.service; then
			say "stopping Roland's display server (systemctl stop weston.service)"
			systemctl stop weston.service || say "systemctl stop weston.service failed"
		fi
		xorg=$(xorg_ours)
		if [ -n "$xorg" ]; then
			say "the bundle's X server already runs (pid $(echo $xorg)): kept"
		elif display_up; then
			say "something other than the bundle's X server serves :0: the app goes on it"
		else
			say "starting the bundle's X server on :0 (var/oscairn/log/Xorg.log)"
			rm -f "$state/run/app.pid"; rmdir "$state/run/app-restart.lock" 2>/dev/null
			( trap '' HUP; keep_display ) < /dev/null >> "$state/log/xorg.out" 2>&1 &
			keeper=$!
			i=0
			until display_up && display_serves; do
				i=$((i + 1))
				if [ $i -gt 100 ] || ! kill -0 $keeper 2>/dev/null; then
					kill $keeper 2>/dev/null
					xorg=$(xorg_ours)
					[ -z "$xorg" ] || kill -9 $xorg
					tail -n 5 "$root/var/oscairn/log/Xorg.log" 2>/dev/null
					say "the bundle's X server did not come up: Roland's Weston back (systemctl start weston.service), the app on it as before"
					weston_back || fail "Weston did not come back either: no display for the app"
					break
				fi
				nap
			done
		fi
	fi
	set -- /usr/bin/Oscairn --profile "$OSCAIRN_PROFILE" --plugins /usr/lib/clap
	say "starting the app: $*${cores:+ (audio threads on cores $cores)}"
	if [ -n "$dry" ]; then
		say "would run: $root/start-chroot.sh setsid env DISPLAY=:0 ${cores:+OSCAIRN_AUDIO_THREAD_CORES=$cores }${tuning}${plug}sh -c 'ulimit -l unlimited; exec \"\$@\"' sh $*"
		exit 0
	fi
	rm -rf "$root/tmp/oscairn-0"
	app_start
	# Its engine's control socket, in the app's runtime folder (the bundle's /tmp/oscairn-0).
	i=0
	until sock=$(ls "$root"/tmp/oscairn-0/engine-*.sock 2>/dev/null | head -n 1) && [ -S "$sock" ]; do
		i=$((i + 1))
		[ $i -le 400 ] && kill -0 "$(cat "$state/run/app.pid")" 2>/dev/null || { tail -n 20 "$state/log/oscairn-app.log"; fail "the app's engine did not start (var/oscairn/log/oscairn-app.log)"; }
		nap
	done
	inside=/tmp/oscairn-0/${sock##*/}
	"$root/start-chroot.sh" /usr/bin/oscairn-control-request "$inside" '{"jsonrpc":"2.0","id":1,"method":"session.status"}' > "$state/run/status" 2>&1 &
	request=$!
	while kill -0 $request 2>/dev/null; do
		i=$((i + 1))
		[ $i -le 600 ] || { kill $request 2>/dev/null; break; }
		nap
	done
	wait $request && grep -q '"result"' "$state/run/status" || { tail -n 20 "$state/log/oscairn-app.log"; fail "the app's engine does not answer session.status (var/oscairn/log/oscairn-app.log)"; }
	say "session.status: $(cut -c1-400 "$state/run/status")"
	say "the app runs (pid $(cat "$state/run/app.pid")); its engine's control socket is $sock"
	exit 0
fi
say "starting the engine: oscairn-engine-run $OSCAIRN_ENGINE_ARGS${cores:+ (audio threads on cores $cores)}"
if [ -n "$dry" ]; then
	say "would run: $root/start-chroot.sh setsid env ${cores:+OSCAIRN_AUDIO_THREAD_CORES=$cores }${tuning}${plug}oscairn-engine-run $OSCAIRN_ENGINE_ARGS"
	exit 0
fi
rm -f "$root/run/oscairn/engine.sock"
eval "set -- $OSCAIRN_ENGINE_ARGS"
# setsid: the bundle's own, as the panel holder detaches itself with; the ssh session ending
# then does not take the engine with it.
"$root/start-chroot.sh" setsid env OSCAIRN_RELIABILITY="${OSCAIRN_RELIABILITY:-instrument}" ${cores:+OSCAIRN_AUDIO_THREAD_CORES="$cores"} ${tuning}${plug}oscairn-engine-run "$@" \
	>> "$state/log/oscairn-engine.log" 2>&1 &
echo $! > "$state/run/engine.pid"

# 7. Whether it came up: its control socket, then an answer to session.status, all within 20
# seconds (the request is killed if it hangs).
broke() { tail -n 20 "$state/log/oscairn-engine.log"; fail "$1 (var/oscairn/log/oscairn-engine.log)"; }
i=0
until [ -S "$root/run/oscairn/engine.sock" ]; do
	i=$((i + 1))
	[ $i -le 150 ] && kill -0 "$(cat "$state/run/engine.pid")" 2>/dev/null || broke "the engine did not start"
	nap
done
"$root/start-chroot.sh" /usr/bin/oscairn-control-request /run/oscairn/engine.sock '{"jsonrpc":"2.0","id":1,"method":"session.status"}' \
	> "$state/run/status" 2>&1 &
request=$!
while kill -0 $request 2>/dev/null; do
	i=$((i + 1))
	[ $i -le 200 ] || { kill $request 2>/dev/null; break; }
	nap
done
wait $request && grep -q '"result"' "$state/run/status" || broke "the engine does not answer session.status"
say "session.status: $(cut -c1-400 "$state/run/status")"
say "the engine runs (pid $(cat "$state/run/engine.pid")); its control socket is $root/run/oscairn/engine.sock"
