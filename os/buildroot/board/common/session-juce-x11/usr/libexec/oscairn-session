#!/bin/sh
# The Oscairn session: an X server for the JUCE app, then the app itself, restarted if it
# exits. Progress goes to the console; the app's output to /var/log/oscairn.log.
#
# This is the only place the image depends on X11. A device UI built another way replaces
# this script and the BR2_PACKAGE_OSCAIRN_STANDALONE option.

[ -f /etc/default/oscairn ] && . /etc/default/oscairn
export DISPLAY=:0 HOME=/root
say() { echo "oscairn-session: $*" > /dev/console; }

# The engine and its workers, started by the app, lock their memory (RFC 0025) and lock future
# mappings only under an unlimited RLIMIT_MEMLOCK; they inherit it from here.
ulimit -l unlimited
say "locked memory: $(ulimit -l)"

# RFC 0035: the audio cores the profile asks for (/etc/default/oscairn-cores, written when the
# image is built; the kernel's command line has nohz_full= and irqaffinity= for them). An isolated
# cpuset partition on them, which the engine moves itself into before it starts a thread or a
# worker, so nothing else runs there; every interrupt that can move kept off them; their frequency
# held at the top and idle states slower to leave than a tenth of a block turned off, for as long
# as the session runs.
[ -f /etc/default/oscairn-cores ] && . /etc/default/oscairn-cores
if [ -n "${OSCAIRN_AUDIO_CORES:-}" ]; then
	cg=/sys/fs/cgroup
	grep -q " $cg cgroup2 " /proc/mounts || mount -t cgroup2 none $cg
	echo +cpuset > $cg/cgroup.subtree_control
	mkdir -p $cg/oscairn-audio
	echo "$OSCAIRN_AUDIO_CORES" > $cg/oscairn-audio/cpuset.cpus
	echo isolated > $cg/oscairn-audio/cpuset.cpus.partition
	export OSCAIRN_AUDIO_CGROUP=$cg/oscairn-audio
	set_irqs=0 fixed_irqs=0
	for irq in /proc/irq/[0-9]*; do
		if echo "$OSCAIRN_HOUSEKEEPING_CORES" > $irq/smp_affinity_list 2>/dev/null; then
			set_irqs=$((set_irqs + 1))
		else
			fixed_irqs=$((fixed_irqs + 1))
		fi
	done
	held=""
	first=${OSCAIRN_AUDIO_CORES%-*} last=${OSCAIRN_AUDIO_CORES#*-}
	for cpu in $(seq "$first" "$last"); do
		d=/sys/devices/system/cpu/cpu$cpu
		[ -w $d/cpufreq/scaling_governor ] && echo performance > $d/cpufreq/scaling_governor && held="$held cpu$cpu-performance"
		for s in $d/cpuidle/state*; do
			[ -f $s/latency ] && [ "$(cat $s/latency)" -gt "$OSCAIRN_IDLE_LIMIT_US" ] && echo 1 > $s/disable && held="$held cpu$cpu-$(cat $s/name)-off"
		done
	done
	say "audio cores $OSCAIRN_AUDIO_CORES: partition $(cat $cg/oscairn-audio/cpuset.cpus.partition);" \
		"interrupts on $OSCAIRN_HOUSEKEEPING_CORES: $set_irqs, not movable: $fixed_irqs; held:${held:- nothing (no frequency or idle states to set)}"
fi

Xorg :0 -nolisten tcp -nocursor > /var/log/oscairn-xorg.log 2>&1 &
for i in $(seq 100); do
	[ -S /tmp/.X11-unix/X0 ] && break
	sleep 0.1
done
[ -S /tmp/.X11-unix/X0 ] && say "X server up" || say "X server did not start (see /var/log/oscairn-xorg.log)"

while true; do
	/usr/bin/Oscairn --plugins /usr/lib/clap $OSCAIRN_ARGS >> /var/log/oscairn.log 2>&1 &
	pid=$!
	sleep 5
	kill -0 "$pid" 2>/dev/null && say "Oscairn running (pid $pid)" && grep "^oscairn:" /var/log/oscairn.log | tail -n 1 > /dev/console
	# The audio device the engine opened: the engine is its own process with its own log.
	cat /tmp/oscairn-*/engine-*.sock.log 2>/dev/null | grep "audio output" | tail -n 1 > /dev/console
	wait "$pid"
	say "Oscairn exited ($?), restarting"
	tail -n 5 /var/log/oscairn.log > /dev/console
	sleep 2
done
