#!/bin/sh
# The Oscairn session: the engine, and the Rust UI (docs/rust-ui.md) on the display through
# KMS, with no X server, as the FANTOM bundle's start script runs them. Each is restarted if it
# exits. Progress goes to the console; the engine's output to /var/log/oscairn-engine.log, the
# UI's to /var/log/oscairn-ui.log. The engine gets the options the profile asks for
# (/etc/default/oscairn-engine, written from the profile when the image is built).
#
# Headless, when the profile has no screen or the board shows no display: the engine alone.
# No UI, until the session restarts.
#
# The UI runs with no --handover: a screen not yet ported to Rust (the Groovebox, Recordings)
# says in its tile that it is not here, where the FANTOM bundle hands the display to the JUCE app.

[ -f /etc/default/oscairn ] && . /etc/default/oscairn
[ -f /etc/default/oscairn-engine ] && . /etc/default/oscairn-engine
export HOME=/root
say() { echo "oscairn-session: $*" > /dev/console; }

# The engine and its workers lock their memory (RFC 0025) and lock future
# mappings only under an unlimited RLIMIT_MEMLOCK; they inherit it from here.
ulimit -l unlimited
say "locked memory: $(ulimit -l)"

# RFC 0035: the audio cores the profile asks for (/etc/default/oscairn-cores, written when the
# image is built; the kernel's command line has nohz_full= and irqaffinity= for them). An isolated
# cpuset partition on them, which the engine moves itself into before it starts a thread or a
# worker, so nothing else runs there; every interrupt that can move kept off them; their frequency
# held at the top and idle states slower to leave than a tenth of a block turned off, for as long
# as the session runs.
[ -f /etc/default/oscairn-cores ] && . /etc/default/oscairn-cores
if [ -n "${OSCAIRN_AUDIO_CORES:-}" ]; then
	cg=/sys/fs/cgroup
	grep -q " $cg cgroup2 " /proc/mounts || mount -t cgroup2 none $cg
	echo +cpuset > $cg/cgroup.subtree_control
	mkdir -p $cg/oscairn-audio
	echo "$OSCAIRN_AUDIO_CORES" > $cg/oscairn-audio/cpuset.cpus
	echo isolated > $cg/oscairn-audio/cpuset.cpus.partition
	export OSCAIRN_AUDIO_CGROUP=$cg/oscairn-audio
	set_irqs=0 fixed_irqs=0
	for irq in /proc/irq/[0-9]*; do
		if echo "$OSCAIRN_HOUSEKEEPING_CORES" > $irq/smp_affinity_list 2>/dev/null; then
			set_irqs=$((set_irqs + 1))
		else
			fixed_irqs=$((fixed_irqs + 1))
		fi
	done
	held=""
	first=${OSCAIRN_AUDIO_CORES%-*} last=${OSCAIRN_AUDIO_CORES#*-}
	for cpu in $(seq "$first" "$last"); do
		d=/sys/devices/system/cpu/cpu$cpu
		[ -w $d/cpufreq/scaling_governor ] && echo performance > $d/cpufreq/scaling_governor && held="$held cpu$cpu-performance"
		for s in $d/cpuidle/state*; do
			[ -f $s/latency ] && [ "$(cat $s/latency)" -gt "$OSCAIRN_IDLE_LIMIT_US" ] && echo 1 > $s/disable && held="$held cpu$cpu-$(cat $s/name)-off"
		done
	done
	say "audio cores $OSCAIRN_AUDIO_CORES: partition $(cat $cg/oscairn-audio/cpuset.cpus.partition);" \
		"interrupts on $OSCAIRN_HOUSEKEEPING_CORES: $set_irqs, not movable: $fixed_irqs; held:${held:- nothing (no frequency or idle states to set)}"
fi

# A display: a DRM output with something connected (an HDMI port with no monitor is not one), or
# a framebuffer where there is no DRM to ask. Its driver may still be loading, so wait a little.
# Without one the UI cannot draw and would exit in a loop.
display() {
	if ls -d /sys/class/drm/card*-* > /dev/null 2>&1; then
		grep -qx connected /sys/class/drm/card*-*/status 2> /dev/null
	else
		ls /dev/fb* > /dev/null 2>&1
	fi
}
headless=""
if [ "${OSCAIRN_HEADLESS:-0}" = 1 ]; then
	headless="the profile has no screen"
else
	for i in $(seq 100); do
		display && break
		sleep 0.1
	done
	display || headless="no display (no connected DRM output or framebuffer)"
fi
# A profile that asks for the JUCE app ("ui": "juce", OSCAIRN_UI) gets the Rust UI: this session
# no longer starts the app.
[ "${OSCAIRN_UI:-rust}" = rust ] || say "the profile asks for ui $OSCAIRN_UI; the Rust UI runs instead"

# The engine's control socket, in a directory only root can reach, as the engine requires.
mkdir -p /run/oscairn && chmod 700 /run/oscairn
export OSCAIRN_RELIABILITY="${OSCAIRN_RELIABILITY:-desktop}"
# The cores the audio threads may run on (the profile's compute.audioThreadCores).
[ -n "${OSCAIRN_AUDIO_THREAD_CORES:-}" ] && export OSCAIRN_AUDIO_THREAD_CORES
# Each plugin worker's allowance per block (the profile's compute.workerAllowance).
[ -n "${OSCAIRN_WORKER_BUDGET_US:-}" ] && export OSCAIRN_WORKER_BUDGET_US
keep_engine() {
	eval "set -- $OSCAIRN_ENGINE_ARGS"
	while true; do
		rm -f /run/oscairn/engine.sock
		/usr/bin/oscairn-engine --socket /run/oscairn/engine.sock --plugins /usr/lib/clap "$@" >> /var/log/oscairn-engine.log 2>&1 &
		pid=$!
		sleep 5
		kill -0 "$pid" 2>/dev/null && say "engine running (pid $pid)" && grep "audio output" /var/log/oscairn-engine.log | tail -n 1 > /dev/console
		wait "$pid"
		say "engine exited ($?), restarting"
		tail -n 5 /var/log/oscairn-engine.log > /dev/console
		sleep 2
	done
}

if [ -n "$headless" ]; then
	say "headless: $headless; running the engine without the UI"
	keep_engine
fi

keep_engine &
# Stopped (/etc/init.d/S95oscairn), its engine's keeper goes too, or it would start the engine again.
keeper=$!
trap 'kill $keeper 2>/dev/null; exit 0' TERM

# The Rust UI on the display (Slint's KMS backend; touch and keys through libinput), against the
# engine's socket, which it waits for. XKB_CONFIG_ROOT is for the keymap; the rotation is the
# profile's (OSCAIRN_UI_ROTATION).
while true; do
	env XKB_CONFIG_ROOT=/usr/share/X11/xkb SLINT_BACKEND=linuxkms-software SLINT_KMS_ROTATION="${OSCAIRN_UI_ROTATION:-0}" \
		/usr/bin/oscairn-ui --profile "$OSCAIRN_PROFILE" --socket /run/oscairn/engine.sock >> /var/log/oscairn-ui.log 2>&1 &
	pid=$!
	sleep 5
	kill -0 "$pid" 2>/dev/null && say "Rust UI running (pid $pid)" && grep "oscairn" /var/log/oscairn-ui.log | tail -n 1 > /dev/console
	wait "$pid"
	say "Rust UI exited ($?), restarting"
	tail -n 5 /var/log/oscairn-ui.log > /dev/console
	sleep 2
done
