# The i.MX8M Mini EVK's kernel: only what the board's hardware needs, over the kernel's defaults
# (a defconfig: options not named keep their default). board/common/linux.fragment adds the base
# every Oscairn image shares; the oscairn package's options take out what its profile lacks.
# Left out because the profile has no use for them: PCIe (the M.2 slot), the camera (CSI, OV5640),
# the PDM microphones, S/PDIF, the Bluetooth SCO link, the IR receiver, FlexSPI NOR, the backlight
# PWM and the SNVS power key and clock (no battery on the board).

# The SoC: clocks, pins, GPIO, power domains (the display's and USB's blocks), the system counter.
CONFIG_ARCH_NXP=y
CONFIG_ARCH_MXC=y
CONFIG_SOC_IMX8M=y
CONFIG_CLK_IMX8MM=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_IMX8MM=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_MXC=y
CONFIG_NVMEM=y
CONFIG_NVMEM_IMX_OCOTP=y
CONFIG_IMX2_WDT=y
CONFIG_WATCHDOG=y
CONFIG_THERMAL=y
CONFIG_IMX8MM_THERMAL=y
CONFIG_CPU_THERMAL=y

# The BD71847 PMIC on I2C1, which feeds the cores.
CONFIG_I2C=y
CONFIG_I2C_IMX=y
CONFIG_MFD_ROHM_BD718XX=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_BD718XX=y

# Frequency and idle states, which RFC 0035 holds on the audio cores while anything sounds.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_IMX_CPUFREQ_DT=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y

# The console, on UART2 (the debug micro-USB port's second serial port).
CONFIG_SERIAL_IMX=y
CONFIG_SERIAL_IMX_CONSOLE=y

# The microSD slot (uSDHC2) and the eMMC (uSDHC3).
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_ESDHC_IMX=y

# Audio: the WM8524 on SAI3 through simple-audio-card, fed by SDMA. SDMA is a module so its
# firmware (imx/sdma/sdma-imx7d.bin, from firmware-imx) loads from the root filesystem.
CONFIG_DMADEVICES=y
CONFIG_IMX_SDMA=m
CONFIG_SND_SOC=y
CONFIG_SND_SOC_FSL_SAI=m
CONFIG_SND_SIMPLE_CARD=m
CONFIG_SND_SOC_WM8524=m

# USB: the one USB-C port (usbotg1, ChipIdea, OTG), its PTN5110 port controller switching the
# role. As a host: USB MIDI controllers and audio interfaces. As a device: the gadget (USB MIDI
# and audio to a computer), taken out by the oscairn package without BR2_PACKAGE_OSCAIRN_USB_GADGET.
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_TCPCI=y
CONFIG_SND_USB_AUDIO=m
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_F_MIDI=y
CONFIG_USB_CONFIGFS_F_UAC2=y

# Ethernet (the profile's network.ethernet): FEC with its AR8031 PHY.
CONFIG_NETDEVICES=y
CONFIG_PACKET=y
CONFIG_FEC=y
CONFIG_AT803X_PHY=y

# The display (the profile's screen): LCDIF, the Samsung DSIM MIPI-DSI host and the ADV7535
# bridge to HDMI, with a framebuffer for X. Taken out by the oscairn package without the app.
CONFIG_DRM=y
CONFIG_DRM_MXSFB=m
CONFIG_DRM_SAMSUNG_DSIM=m
CONFIG_DRM_I2C_ADV7511=m
# CONFIG_DRM_I2C_ADV7511_CEC is not set
CONFIG_DRM_DISPLAY_CONNECTOR=m
CONFIG_FB=y
