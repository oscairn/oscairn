# Added to the arm64 defconfig for the i.MX8M Mini EVK: the WM8524 codec on SAI3 through
# simple-audio-card, the ALSA sequencer for MIDI, USB device-mode MIDI and audio, the HDMI path
# (LCDIF, the Samsung DSIM MIPI-DSI host, the ADV7535 bridge) with a framebuffer for X, and a
# low-latency kernel. SDMA is a module so its firmware loads from the root filesystem.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SEQUENCER=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_FSL_SAI=m
CONFIG_SND_SOC_WM8524=m
CONFIG_SND_SIMPLE_CARD=m
CONFIG_IMX_SDMA=m
CONFIG_USB_GADGET=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_F_MIDI=y
CONFIG_USB_CONFIGFS_F_UAC2=y
CONFIG_DRM_MXSFB=m
CONFIG_DRM_SAMSUNG_DSIM=m
CONFIG_DRM_I2C_ADV7511=m
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_PREEMPT=y
