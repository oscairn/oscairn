# The QEMU virt machine's kernel: only the devices os/build.sh and boot-test.py give it, over the
# kernel's defaults (a defconfig: options not named keep their default). board/common/linux.fragment
# adds the base every Oscairn image shares; the oscairn package's options take out what its profile
# lacks.

# The machine: PCI (ECAM) and virtio over PCI and MMIO, the PL011 console, the PL031 clock.
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PL031=y

# The root filesystem on virtio-blk.
CONFIG_VIRTIO_BLK=y

# Audio: the dummy card (plays silently) and virtio sound, which os/build.sh record uses.
CONFIG_SND_DRIVERS=y
CONFIG_SND_DUMMY=y
CONFIG_SND_VIRTIO=y

# Ethernet (the profile's network.ethernet): virtio-net.
CONFIG_NETDEVICES=y
CONFIG_PACKET=y
CONFIG_VIRTIO_NET=y

# Input: the virtio keyboard and tablet.
CONFIG_VIRTIO_INPUT=y

# The display (the profile's screen): virtio-gpu with a framebuffer for X. Taken out by the
# oscairn package without the app.
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_FB=y
