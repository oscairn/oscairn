# Oscairn for a chroot on a Roland FANTOM-0's own Linux (docs/fantom-0.md): a root filesystem
# with Oscairn and its own glibc, libstdc++ and ALSA, packed as a tarball (os/fantom-bundle.sh).
# No kernel, bootloader or device tree: Roland's stay as they are. glibc will not start on a
# kernel older than its headers, so they are Linux 4.19's, the instrument's kernel (4.19.35).
# The userspace is the EVK image's; tuned for the Cortex-A53, so ARMv8.0 (RFC 0035).
BR2_aarch64=y
BR2_cortex_a53=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_VERSION=y
BR2_DEFAULT_KERNEL_VERSION="4.19.35"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_4_19=y
BR2_CCACHE=y
# The 4.19.35 headers' hash.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_OSCAIRN_PATH)/board/fantom-bundle/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_TARGET_GENERIC_HOSTNAME="oscairn"
BR2_TARGET_GENERIC_ISSUE="Oscairn"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_OSCAIRN_PATH)/board/common/session-juce-x11 $(BR2_EXTERNAL_OSCAIRN_PATH)/board/fantom-bundle/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_OSCAIRN_PATH)/board/common/post-build.sh"
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XSERVER_XORG_SERVER=y
BR2_PACKAGE_XSERVER_XORG_SERVER_MODULAR=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_LIBINPUT=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_FBDEV=y
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
# HTTPS for package repositories (RFC 0039 step 1); the curl tool is for development.
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_MBEDTLS=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_MBEDTLS=y
BR2_PACKAGE_OSCAIRN=y
BR2_PACKAGE_OSCAIRN_STANDALONE=y
BR2_PACKAGE_OSCAIRN_ROLAND_FANTOM0=y
# BR2_TARGET_ROOTFS_EXT2 is not set
BR2_TARGET_ROOTFS_TAR=y
BR2_TARGET_ROOTFS_TAR_GZIP=y
BR2_PACKAGE_RT_TESTS=y
BR2_PACKAGE_XAPP_XWD=y
BR2_PACKAGE_XAPP_XWININFO=y
BR2_PACKAGE_XAPP_XPROP=y
