// The Controls page (src/controls.rs), the JUCE Edit view's controls page (hosts/standalone/
// PartsView.cpp, `controlsShown`): a row per control (its name, a fader, + Target, Remove) with a row
// under it per target (what it drives, the two ends of its range as sliders, the curve, Relative, Now,
// Scenes, Remove); or, with By scene, a table of every mapping against every scene. A cursor is a
// focus border round a cell; a slider being changed takes the accent border. How many rows a view
// holds and how many lines a target takes is not counted here: the screen reads the sizes below and
// fills the height, so the window, the theme's spacing and the type scale reflow it.

import { Theme, Section, Button, Cursor, SliderBar, Mark } from "theme.slint";

export struct ControlRowData {
    kind: int, // 0 a control, 1 one of its targets
    name: string, // a control's name; what a target drives
    value: float, // a control's fader
    start: float,
    end: float,
    curve: string,
    relative: bool,
    scenes: string, // "Scenes: all" or "Scenes..."
    now: bool, // "Now..." can be used (not on a morph)
    cell: int, // the cell the cursor is on: -1 none
    editing: bool, // the dial changes the slider under the cursor
}

export struct TableRowData {
    label: string, // the control and what it drives
    cursor: bool,
}

export struct TableCellData {
    row: int,
    col: int,
    on: bool,
    cursor: bool,
}

export struct ControlToolData {
    label: string,
    on: bool, // a toggle that is on
    cursor: bool,
}

export global ControlsState {
    in property <[ControlRowData]> rows;
    in property <bool> empty;
    in property <bool> has-scenes; // the Performance has scenes: each target has Scenes
    in property <bool> table; // By scene: the table instead of the rows
    in property <[TableRowData]> table-rows;
    in property <[TableCellData]> table-cells;
    in property <[string]> scene-names; // the columns shown
    in property <bool> more-columns;
    in property <[ControlToolData]> tools;
    in property <string> view;
    in property <string> message;
    // What the screen needs to fill the height with rows: set by the screen's component.
    in-out property <length> area-height: 0px;
    in-out property <length> control-pitch: 1px;
    in-out property <length> target-pitch: 1px;
    in-out property <length> table-pitch: 1px;
    in-out property <length> slack: 0px;
    in-out property <int> columns: 1; // scene columns the table shows
    callback resized();
    callback level(int, float); // a control's row, the fader's place
    callback range(int, bool, float); // a target's row, the end (true) or the start, the slider's place
    callback held(int, int, bool); // a row, its cell, a finger on the slider or off it
    callback press(int, int); // a row, its cell
    callback table-press(int, int); // a row and column of the table
    callback tool(int);
    callback turn-columns(int);
}

// How the rows lay out by the width they have, which the rows and the screen's count of what fits both read.
global ControlsLayout {
    pure public function ideal-name() -> length {
        return 150px * Theme.font-scale;
    }
    pure public function control-one-line(width: length) -> bool {
        return width >= 2 * ideal-name() + 2 * Theme.button-width + 4 * Theme.gap + 2 * Theme.pad;
    }
    pure public function target-line2(scenes: bool) -> length {
        return 2 * 110px + (130px + 100px + 70px + 80px + (scenes ? 100px : 0px)) * Theme.font-scale;
    }
    // One line (the name first), else the name and Remove over the rest, else three.
    pure public function target-lines(width: length, scenes: bool) -> int {
        return width >= target-line2(scenes) + 200px * Theme.font-scale + 8 * Theme.gap + 2 * Theme.pad-tight ? 1 : width >= target-line2(scenes) + 6 * Theme.gap + 2 * Theme.pad-tight ? 2 : 3;
    }
}

// A slider that follows a value: dragged or tapped it says where, a finger on it or off it is told.
component Value inherits Rectangle {
    in property <float> norm;
    in property <bool> cursor;
    in property <bool> editing;
    callback moved(float);
    callback held(bool);
    SliderBar {
        x: Theme.thumb / 2;
        width: parent.width - Theme.thumb;
        height: parent.height;
        norm: root.norm;
        lit: root.cursor;
    }
    touch := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.held(true); }
            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { root.held(false); }
        }
        moved => { root.moved(max(0, min(1, (touch.mouse-x - Theme.thumb / 2) / (root.width - Theme.thumb)))); }
        clicked => { root.moved(max(0, min(1, (touch.mouse-x - Theme.thumb / 2) / (root.width - Theme.thumb)))); }
    }
    Cursor {
        shown: root.cursor;
        editing: root.editing;
        corner: Theme.field-radius(root.height);
    }
}

// A cell that is pressed: a button with the cursor's border round it.
component Cell inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <bool> enabled: true;
    in property <bool> cursor;
    callback clicked();
    Button {
        text: root.text;
        on: root.on;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Cursor {
        shown: root.cursor;
        corner: Theme.button-radius(root.height);
    }
}

component ControlRow inherits Section {
    in property <ControlRowData> data;
    callback level(float);
    callback held(bool);
    callback press(int);
    property <length> ideal-name: ControlsLayout.ideal-name();
    property <bool> one-line: ControlsLayout.control-one-line(root.width);
    fill: Theme.surface;
    VerticalLayout {
        padding: Theme.pad-tight;
        spacing: Theme.pad-tight;
        HorizontalLayout {
            spacing: Theme.gap;
            // The name: a press renames it.
            Rectangle {
                preferred-width: root.ideal-name;
                min-width: root.ideal-name * 0.5;
                horizontal-stretch: 1;
                Text {
                    x: Theme.pad-narrow;
                    width: parent.width - 2 * Theme.pad-narrow;
                    height: parent.height;
                    text: data.name;
                    color: Theme.text;
                    font-size: Theme.body;
                    font-weight: 700;
                    overflow: elide;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { root.press(0); }
                }
                Cursor {
                    shown: data.cell == 0;
                    corner: Theme.field-radius(self.height);
                }
            }
            if root.one-line: Value {
                preferred-width: root.ideal-name * 1.5;
                min-width: root.ideal-name * 0.5;
                horizontal-stretch: 2;
                norm: data.value;
                cursor: data.cell == 1;
                editing: data.cell == 1 && data.editing;
                moved(f) => { root.level(f); }
                held(down) => { root.held(down); }
            }
            Cell {
                preferred-width: Theme.button-width;
                text: "+ Target";
                cursor: data.cell == 2;
                clicked => { root.press(2); }
            }
            Cell {
                preferred-width: Theme.button-width;
                text: "Remove";
                cursor: data.cell == 3;
                clicked => { root.press(3); }
            }
        }
        if !root.one-line: Value {
            height: Theme.touch;
            norm: data.value;
            cursor: data.cell == 1;
            editing: data.cell == 1 && data.editing;
            moved(f) => { root.level(f); }
            held(down) => { root.held(down); }
        }
    }
}

// One target: what it drives, its range (two sliders), curve, Relative, Now, Scenes and Remove, in
// one line when the width allows, else in two or three.
component TargetRow inherits Section {
    in property <ControlRowData> data;
    callback range(bool, float);
    callback held(int, bool);
    callback press(int);
    property <float> fs: Theme.font-scale;
    property <length> w-slider: 110px;
    property <length> w-curve: 130px * fs;
    property <length> w-relative: 100px * fs;
    property <length> w-now: 70px * fs;
    property <length> w-scenes: 100px * fs;
    property <length> w-remove: 80px * fs;
    property <length> w-name: 200px * fs;
    property <int> lines: ControlsLayout.target-lines(root.width, ControlsState.has-scenes);
    property <length> indent: min(Theme.pad-wide * 2, root.width * 0.05);
    fill: Theme.surface.mix(Theme.background, 0.4);
    VerticalLayout {
        padding: Theme.pad-tight;
        padding-left: Theme.pad-tight + root.indent;
        spacing: Theme.pad-tight;
        HorizontalLayout {
            spacing: Theme.gap;
            Text {
                preferred-width: root.w-name;
                min-width: root.w-name * 0.4;
                horizontal-stretch: 2;
                text: data.name;
                color: Theme.text;
                font-size: Theme.body;
                overflow: elide;
                vertical-alignment: center;
            }
            if root.lines == 1: Value {
                preferred-width: root.w-slider;
                min-width: Theme.touch;
                horizontal-stretch: 1;
                norm: data.start;
                cursor: data.cell == 0;
                editing: data.cell == 0 && data.editing;
                moved(f) => { root.range(false, f); }
                held(down) => { root.held(0, down); }
            }
            if root.lines == 1: Value {
                preferred-width: root.w-slider;
                min-width: Theme.touch;
                horizontal-stretch: 1;
                norm: data.end;
                cursor: data.cell == 1;
                editing: data.cell == 1 && data.editing;
                moved(f) => { root.range(true, f); }
                held(down) => { root.held(1, down); }
            }
            if root.lines == 1: Cell {
                preferred-width: root.w-curve;
                text: data.curve;
                cursor: data.cell == 2;
                clicked => { root.press(2); }
            }
            if root.lines == 1: Cell {
                preferred-width: root.w-relative;
                text: "Relative";
                on: data.relative;
                cursor: data.cell == 3;
                clicked => { root.press(3); }
            }
            if root.lines == 1: Cell {
                preferred-width: root.w-now;
                text: "Now...";
                enabled: data.now;
                cursor: data.cell == 4;
                clicked => { root.press(4); }
            }
            if root.lines == 1 && ControlsState.has-scenes: Cell {
                preferred-width: root.w-scenes;
                text: data.scenes;
                cursor: data.cell == 5;
                clicked => { root.press(5); }
            }
            Cell {
                preferred-width: root.w-remove;
                text: "Remove";
                cursor: data.cell == 6;
                clicked => { root.press(6); }
            }
        }
        if root.lines == 2: HorizontalLayout {
            spacing: Theme.gap;
            Value {
                preferred-width: root.w-slider;
                min-width: Theme.touch;
                horizontal-stretch: 1;
                norm: data.start;
                cursor: data.cell == 0;
                editing: data.cell == 0 && data.editing;
                moved(f) => { root.range(false, f); }
                held(down) => { root.held(0, down); }
            }
            Value {
                preferred-width: root.w-slider;
                min-width: Theme.touch;
                horizontal-stretch: 1;
                norm: data.end;
                cursor: data.cell == 1;
                editing: data.cell == 1 && data.editing;
                moved(f) => { root.range(true, f); }
                held(down) => { root.held(1, down); }
            }
            Cell {
                preferred-width: root.w-curve;
                text: data.curve;
                cursor: data.cell == 2;
                clicked => { root.press(2); }
            }
            Cell {
                preferred-width: root.w-relative;
                text: "Relative";
                on: data.relative;
                cursor: data.cell == 3;
                clicked => { root.press(3); }
            }
            Cell {
                preferred-width: root.w-now;
                text: "Now...";
                enabled: data.now;
                cursor: data.cell == 4;
                clicked => { root.press(4); }
            }
            if ControlsState.has-scenes: Cell {
                preferred-width: root.w-scenes;
                text: data.scenes;
                cursor: data.cell == 5;
                clicked => { root.press(5); }
            }
        }
        if root.lines == 3: HorizontalLayout {
            spacing: Theme.gap;
            Value {
                horizontal-stretch: 1;
                norm: data.start;
                cursor: data.cell == 0;
                editing: data.cell == 0 && data.editing;
                moved(f) => { root.range(false, f); }
                held(down) => { root.held(0, down); }
            }
            Value {
                horizontal-stretch: 1;
                norm: data.end;
                cursor: data.cell == 1;
                editing: data.cell == 1 && data.editing;
                moved(f) => { root.range(true, f); }
                held(down) => { root.held(1, down); }
            }
        }
        if root.lines == 3: HorizontalLayout {
            spacing: Theme.gap;
            Cell {
                text: data.curve;
                cursor: data.cell == 2;
                clicked => { root.press(2); }
            }
            Cell {
                text: "Relative";
                on: data.relative;
                cursor: data.cell == 3;
                clicked => { root.press(3); }
            }
            Cell {
                text: "Now...";
                enabled: data.now;
                cursor: data.cell == 4;
                clicked => { root.press(4); }
            }
            if ControlsState.has-scenes: Cell {
                text: data.scenes;
                cursor: data.cell == 5;
                clicked => { root.press(5); }
            }
        }
    }
}

export component Controls inherits Rectangle {
    // The sections' gap (none in a theme whose sections join).
    property <length> gap: Theme.gap-between(Theme.gap);
    property <length> footer: Theme.small + 2 * Theme.pad-tight;
    property <int> tool-count: ControlsState.tools.length;
    property <int> across: max(1, min(tool-count, floor((self.width - 2 * Theme.margin + Theme.gap) / (Theme.button-width + Theme.gap))));
    property <int> lines: tool-count == 0 ? 0 : ceil(tool-count / across);
    property <length> tool-width: (self.width - 2 * Theme.margin - (across - 1) * Theme.gap) / across;
    property <length> tools-height: lines * Theme.touch + max(0, lines - 1) * Theme.gap;
    property <length> list-y: Theme.margin;
    property <length> tools-y: self.height - Theme.margin - footer - Theme.gap - tools-height;
    property <length> list-height: max(0px, tools-y - Theme.gap - list-y);
    property <length> list-width: self.width - 2 * Theme.margin;
    // A control's row, and a target's by the lines it takes (as the row itself works them out).
    property <bool> one-line: ControlsLayout.control-one-line(list-width);
    property <length> control-height: (one-line ? 1 : 2) * Theme.touch + (one-line ? 0px : Theme.pad-tight) + 2 * Theme.pad-tight;
    property <int> target-lines: ControlsLayout.target-lines(list-width, ControlsState.has-scenes);
    property <length> target-height: target-lines * Theme.touch + (target-lines - 1) * Theme.pad-tight + 2 * Theme.pad-tight;
    property <length> table-height: Theme.touch;
    property <length> name-width: min(320px, self.list-width / 3);
    property <length> column: max(Theme.touch + Theme.gap, min(140px, (list-width - name-width) / max(1, ControlsState.scene-names.length)));
    property <int> fit-columns: max(1, floor((list-width - name-width) / (Theme.touch + Theme.gap)));
    changed list-height => { ControlsState.area-height = list-height; ControlsState.resized(); }
    changed control-height => { ControlsState.control-pitch = control-height + gap; ControlsState.resized(); }
    changed target-height => { ControlsState.target-pitch = target-height + gap; ControlsState.resized(); }
    changed gap => { ControlsState.control-pitch = control-height + gap; ControlsState.target-pitch = target-height + gap; ControlsState.table-pitch = table-height + gap; ControlsState.slack = gap; ControlsState.resized(); }
    changed fit-columns => { ControlsState.columns = fit-columns; ControlsState.resized(); }
    init => {
        ControlsState.area-height = list-height;
        ControlsState.control-pitch = control-height + gap;
        ControlsState.target-pitch = target-height + gap;
        ControlsState.table-pitch = table-height + gap;
        ControlsState.slack = gap;
        ControlsState.columns = fit-columns;
    }

    if !ControlsState.table: VerticalLayout {
        x: Theme.margin;
        y: root.list-y;
        width: root.list-width;
        height: root.list-height;
        spacing: root.gap;
        alignment: start;
        for row[i] in ControlsState.rows: Rectangle {
            height: row.kind == 0 ? root.control-height : root.target-height;
            if row.kind == 0: ControlRow {
                width: parent.width;
                height: parent.height;
                data: row;
                level(f) => { ControlsState.level(i, f); }
                held(down) => { ControlsState.held(i, 1, down); }
                press(cell) => { ControlsState.press(i, cell); }
            }
            if row.kind == 1: TargetRow {
                width: parent.width;
                height: parent.height;
                data: row;
                range(end, f) => { ControlsState.range(i, end, f); }
                held(cell, down) => { ControlsState.held(i, cell, down); }
                press(cell) => { ControlsState.press(i, cell); }
            }
        }
    }
    if ControlsState.table: Rectangle {
        x: Theme.margin;
        y: root.list-y;
        width: root.list-width;
        height: root.list-height;
        // The scenes' names over their columns.
        for name[c] in ControlsState.scene-names: Text {
            x: root.name-width + c * root.column;
            y: 0;
            width: root.column;
            height: root.table-height;
            text: name;
            color: Theme.muted;
            font-size: Theme.small;
            font-weight: 700;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        for row[r] in ControlsState.table-rows: Section {
            y: (r + 1) * (root.table-height + root.gap);
            width: parent.width;
            height: root.table-height;
            Text {
                x: Theme.pad-narrow;
                width: root.name-width - Theme.pad-narrow;
                height: parent.height;
                text: row.label;
                color: Theme.text;
                font-size: Theme.small;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        for cell in ControlsState.table-cells: Rectangle {
            property <length> side: root.table-height - 2 * Theme.pad-tight;
            x: root.name-width + cell.col * root.column + (root.column - self.side) / 2;
            y: (cell.row + 1) * (root.table-height + root.gap) + Theme.pad-tight;
            width: self.side;
            height: self.side;
            Mark {
                letter: cell.on ? "✓" : "";
                tint: Theme.accent;
                on: cell.on;
                clicked => { ControlsState.table-press(cell.row, cell.col); }
            }
            Cursor {
                shown: cell.cursor;
                corner: Theme.mark-radius(parent.width);
            }
        }
    }
    if ControlsState.empty: Text {
        x: Theme.margin;
        y: root.list-y;
        width: root.list-width;
        height: root.list-height;
        text: "No controls yet. A control is a knob that drives any number of parameters, part levels or other controls, each with its own range and curve. Bind a panel knob to it with control:NAME.";
        color: Theme.muted;
        font-size: Theme.body;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    for tool[i] in ControlsState.tools: Rectangle {
        x: Theme.margin + mod(i, root.across) * (root.tool-width + Theme.gap);
        y: root.tools-y + floor(i / root.across) * (Theme.touch + Theme.gap);
        width: root.tool-width;
        height: Theme.touch;
        Button {
            on: tool.on;
            text: tool.label;
            clicked => { ControlsState.tool(i); }
        }
        Cursor {
            shown: tool.cursor;
            corner: Theme.button-radius(Theme.touch);
        }
    }
    Text {
        x: Theme.margin;
        y: root.height - Theme.margin - root.footer;
        width: root.width - 2 * Theme.margin;
        height: root.footer;
        vertical-alignment: center;
        overflow: elide;
        font-size: Theme.small;
        color: Theme.muted;
        text: ControlsState.message == "" ? ControlsState.view : ControlsState.message + "   " + ControlsState.view;
    }
}
