// SPDX-License-Identifier: AGPL-3.0-or-later
// The grid framework's widgets (src/grid.rs lays them out from the plugin's data; ui/GRID.md):
// tiles placed by the Rust side, each its name, its value as the plugin writes it, and its control:
// a knob, a slider across or upright, a drawbar, a switch, a dropdown, split buttons (one stop per
// value), a two-sided range, or the value alone; linked tiles on one card; view panels (an
// envelope's curve) above them. Without touch the cursor is a focus border and a tile being changed
// an accent one; by touch knobs and sliders drag, switches, stops and dropdowns tap.

import { Theme, Section, Button, Cursor, Field, FitText, TabPages, TabLabel, Thumb, SliderBar, SliderStyle, DepthStyle, SectionStyle } from "theme.slint";
import { ScrollBar } from "part.slint";

export struct GridTile {
    x: length,
    y: length,
    w: length,
    h: length,
    kind: int, // 0 slider, 1 knob, 2 buttons, 3 switch, 4 list, 5 range, 6 value, 7 upright slider, 8 drawbar
    name: string,
    value: string,
    norm: float, // the value from 0 to 1 (a range's low end)
    high: float, // a range's high end
    bipolar: bool, // filled from the middle
    arc: string, // a knob's value arc in a 100 x 100 box
    choices: [string],
    icons: [int], // a waveform icon per choice (0 none), see src/grid.rs `wave_icon`
    icon: int, // the same for a dropdown's value
    chosen: int,
    on: bool,
    cursor: bool,
    editing: bool,
    part: int, // a range being changed: 0 its low end, 1 its high end
    linked: bool,
    cell: bool, // a compact knob too small to be one (src/grid.rs `knob_is_cell`): a value and a thin bar instead
    compact: bool, // a compact control of a master's detail (Theme.compact-height): the name over a small control and its value
}

export struct GridCard {
    x: length,
    y: length,
    w: length,
    h: length,
}

export struct GridHeading {
    y: length,
    text: string,
}

// A handle of a view (an envelope's node): where it is, whether the cursor's tile sets it, whether a touch holds it.
export struct GridPoint {
    x: length,
    y: length,
    lit: bool,
    held: bool,
}

// A path in the panel's own pixels, drawn unscaled: `ink` is a theme color (see `ViewPanel.ink`), `width` a hairline (0), thin (1) or the cursor's (2).
export struct GridShape {
    ink: int,
    fill: bool,
    width: int,
    commands: string,
}

export struct GridLabel {
    x: length,
    y: length,
    w: length,
    h: length,
    text: string,
    ink: int,
    bold: bool,
    align: int, // 0 from the left, 1 centered, 2 from the right
}

export struct GridBox {
    x: length,
    y: length,
    w: length,
    h: length,
    fill: int,
    edge: int, // -1 none
    text: string,
    text-ink: int,
    bold: bool,
    mark: bool, // drawn with a mark's corners (the theme's mute and solo mark)
}

export struct GridPanel {
    x: length,
    y: length,
    w: length,
    h: length,
    title: string,
    shapes: [GridShape],
    points: [GridPoint],
    labels: [GridLabel],
    boxes: [GridBox],
}

export global GridState {
    in property <string> name;
    in property <[string]> pages;
    in property <int> page;
    in property <[string]> tabs;
    in property <int> tab;
    // The short forms of the names (what each has that the others do not, on two lines) and what they share, for a rail
    // and for a strip that overflows (src/tabs.rs `abbreviate`); the names above stay whole.
    in property <[TabLabel]> page-labels;
    in property <string> page-heading;
    in property <[TabLabel]> tab-labels;
    in property <string> tab-heading;
    // The cursor on a page, or a tab (-1: not on one).
    in property <int> page-cursor: -1;
    in property <int> tab-cursor: -1;
    // The tabs' placement the screen has: 0 two strips, 1 two rails at the left (set by the screen).
    in-out property <int> layout;
    // A rail's width, and how much of the small type each rail's labels got (1, or down to 0.7), for the tests of the side
    // placement.
    in-out property <length> rail;
    in-out property <float> page-fit: 1.0;
    in-out property <float> tab-fit: 1.0;
    in property <[GridTile]> tiles;
    in property <[GridCard]> cards;
    in property <[GridHeading]> headings;
    in property <[GridPanel]> panels;
    in property <length> scroll; // how far the tiles are scrolled up
    in property <length> content; // how high the page is in all: a mark at the right edge says where the view is when it is more
    in property <string> message;
    // The search button in the header (a plugin of more than 24 parameters): the text searched for, and the cursor on it.
    in property <bool> search-shown;
    in property <string> search;
    // A dropdown open over the grid: its values and the one under the cursor.
    in property <bool> list-open;
    in property <string> list-title;
    in property <[string]> list;
    in property <[int]> list-icons;
    in property <int> list-cursor;
    in property <int> list-first; // the first value in view
    // The tiles' area, set by the screen: what grid.rs lays out for and scrolls within.
    in-out property <length> view-width: 600px;
    in-out property <length> view-height: 400px;
    in-out property <int> list-per-view: 6;
    callback grab(int, int); // a tile and its part (a range's end): a drag begins
    callback drag(int, int, float); // a tile, its part and the value from 0 to 1
    callback release(int);
    callback tap(int, int); // a tile and a stop (buttons), or -1
    callback choose(int); // a dropdown's value, or -1 to close it
    callback list-scrolled(int); // a dropdown's scroll bar or finger drag: a view's first value
    // A touch on a view's panel (its index, the place in the panel's pixels): down says whether it took a handle.
    callback view-down(int, length, length) -> bool;
    callback view-move(int, length, length);
    callback view-up(int, length, length);
    callback show-page(int);
    callback show-tab(int);
    callback scrolled(length);
    callback resized(); // the tiles' area changed size: laid out again
}

// A waveform drawn as a path (a saw, square, sine, triangle, noise, pulse, saw down, sample and hold), in the text's color.
component WaveIcon inherits Path {
    in property <int> kind;
    in property <color> ink: Theme.text;
    viewbox-width: 24;
    viewbox-height: 16;
    stroke: root.ink;
    stroke-width: Theme.hair * 1.5;
    stroke-line-join: round;
    stroke-line-cap: round;
    commands: root.kind == 1 ? "M 2 13 L 10 3 L 10 13 L 18 3 L 18 13" : root.kind == 2 ? "M 2 13 L 2 3 L 9 3 L 9 13 L 16 13 L 16 3 L 22 3 L 22 13" : root.kind == 3 ? "M 2 8 C 5 0 9 0 12 8 C 15 16 19 16 22 8" : root.kind == 4 ? "M 2 8 L 7 3 L 17 13 L 22 8" : root.kind == 5 ? "M 2 8 L 4 3 L 6 12 L 8 5 L 10 13 L 12 4 L 14 11 L 16 3 L 18 12 L 20 6 L 22 9" : root.kind == 6 ? "M 2 13 L 2 3 L 6 3 L 6 13 L 14 13 L 14 3 L 18 3 L 18 13 L 22 13" : root.kind == 7 ? "M 2 3 L 10 13 L 10 3 L 18 13 L 18 3" : root.kind == 8 ? "M 2 10 L 5 10 L 5 4 L 9 4 L 9 12 L 14 12 L 14 6 L 17 6 L 17 13 L 22 13" : "M 0 0";
}

// A value's label with its waveform icon when it has one: both when they fit `room` wide, else the
// icon alone; no icon, the label (shrunk to 80% where it would not fit, then cut).
component Label inherits Rectangle {
    in property <string> text;
    in property <int> icon;
    in property <color> ink: Theme.text;
    in property <length> room: self.width;
    in property <length> size: Theme.button;
    in property <bool> bold;
    in property <bool> left; // from the start, not centered
    property <length> icon-width: self.size * 1.5;
    property <bool> both: root.icon > 0 && measure.preferred-width + root.icon-width + Theme.pad-narrow <= root.room;
    property <bool> shrink: measure.preferred-width > root.room;
    property <length> text-width: min(measure.preferred-width, root.room);
    property <length> content: root.icon > 0 ? (root.both ? root.icon-width + Theme.pad-narrow + root.text-width : root.icon-width) : root.text-width;
    property <length> start: root.left ? 0px : (root.width - root.content) / 2;
    measure := Text {
        visible: false;
        text: root.text;
        font-size: root.size;
        font-weight: root.bold ? 700 : 400;
    }
    if root.icon > 0: WaveIcon {
        x: root.start;
        y: (root.height - root.size) / 2;
        width: root.icon-width;
        height: root.size;
        kind: root.icon;
        ink: root.ink;
    }
    if root.icon == 0 || root.both: Text {
        x: root.start + (root.icon > 0 ? root.icon-width + Theme.pad-narrow : 0px);
        width: root.text-width;
        height: root.height;
        text: root.text;
        color: root.ink;
        font-size: root.shrink ? root.size * 0.8 : root.size;
        font-weight: root.bold ? 700 : 400;
        overflow: elide;
        vertical-alignment: center;
    }
}

component Knob inherits Rectangle {
    in property <string> arc: "";
    in property <float> norm;
    in property <bool> lit;
    // The disc and pointer in the box's units (drawRotarySlider: the disc 1.3 of the radius, the pointer from .15 to .55 of it).
    property <length> disc: self.width * 0.62;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: Theme.track-line;
        stroke-width: Theme.arc;
        commands: "M 21.72 78.28 A 40 40 0 1 1 78.28 78.28";
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: root.lit ? Theme.accent : Theme.accent-dim;
        stroke-width: Theme.arc;
        commands: root.arc == "" ? "M 50 50" : root.arc;
    }
    if Theme.depth == DepthStyle.soft: Rectangle {
        x: (parent.width - root.disc) / 2;
        y: (parent.height - root.disc) / 2 + Theme.hair;
        width: root.disc;
        height: root.disc;
        border-radius: root.disc / 2;
        background: Theme.thumb-shadow;
    }
    Rectangle {
        x: (parent.width - root.disc) / 2;
        y: (parent.height - root.disc) / 2;
        width: root.disc;
        height: root.disc;
        border-radius: root.disc / 2;
        background: Theme.knob-disc;
        border-width: Theme.hair;
        border-color: Theme.thumb-edge;
    }
    // The pointer.
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: Theme.knob-pointer;
        stroke-width: Theme.cursor-width + Theme.hair;
        commands: "M " + (50 + 7 * cos((-225 + 270 * root.norm) * 1deg)) + " " + (50 + 7 * sin((-225 + 270 * root.norm) * 1deg)) + " L " + (50 + 26 * cos((-225 + 270 * root.norm) * 1deg)) + " " + (50 + 26 * sin((-225 + 270 * root.norm) * 1deg));
    }
}

component Tile inherits Rectangle {
    in property <GridTile> data;
    in property <int> index;
    // What a touch does, said to whoever shows the tile: a page of the grid (`Grid`) or a row of tiles (`TileRow`).
    callback grab(int, int);
    callback drag(int, int, float);
    callback release(int);
    callback tap(int, int);
    // A tile's insides (ParameterGrid's): the name line, the control under it, a knob at most 76 wide, a drag of 150 for the whole range.
    // A compact tile (a master's detail, Theme.compact-height): tight paddings, the name line as high as its type, the
    // control as high as what is left, a knob at the left with its value beside it.
    property <bool> compact: data.compact;
    property <length> pad: compact ? Theme.pad-tight : Theme.pad;
    property <length> name-y: compact ? Theme.pad-tight : Theme.pad-narrow;
    property <length> control-y: compact ? Theme.pad-tight + Theme.compact-name : Theme.pad-narrow + Theme.small + Theme.pad-narrow;
    property <length> control-h: compact ? self.height - self.control-y - Theme.pad-tight : min(Theme.touch, self.height - self.control-y - Theme.pad-narrow);
    property <length> knob-max: compact ? Theme.touch : 76px;
    property <length> drag-span: 150px;
    property <length> reach: Theme.thumb / 2; // a slider's thumb reaches past its ends
    property <bool> lit: data.editing || data.cursor;
    // A split button of icons says the chosen one's name at the top right.
    property <bool> says: data.kind == 2 && data.chosen >= 0 && data.chosen < data.icons.length && data.icons[data.chosen] > 0;
    // A tile alone is a section; one in a run is drawn by its card.
    if !data.linked: Section {
        width: parent.width;
        height: parent.height;
    }
    if !root.compact: Text {
        x: root.pad;
        y: root.name-y;
        width: (data.kind == 2 && !root.says) || data.kind == 3 || data.kind == 4 || (root.compact && data.kind == 1) ? parent.width - 2 * root.pad : parent.width * 0.55 - root.pad;
        text: data.name;
        color: Theme.muted;
        font-size: Theme.small;
        font-weight: 700;
        overflow: elide;
    }
    // A compact control's name: shrunk to 70% before it is cut.
    if root.compact: FitText {
        x: root.pad;
        y: root.name-y;
        width: (data.kind == 2 && !root.says) || data.kind == 3 || data.kind == 4 || data.kind == 1 ? parent.width - 2 * root.pad : parent.width * 0.55 - root.pad;
        height: Theme.compact-name;
        text: data.name;
        ink: Theme.muted;
        size: Theme.small;
        bold: true;
        align: TextHorizontalAlignment.left;
    }
    // The value as the plugin writes it (the control says it for lists, switches and buttons).
    if ((data.kind != 2 && data.kind != 3 && data.kind != 4) || root.says) && !(root.compact && data.kind == 1): Text {
        x: parent.width * 0.55;
        y: root.name-y;
        width: parent.width * 0.45 - root.pad;
        text: data.value;
        color: data.editing ? Theme.accent : Theme.text;
        font-size: data.kind == 6 ? Theme.body : Theme.small;
        font-weight: data.kind == 6 ? 700 : 400;
        horizontal-alignment: right;
        overflow: elide;
    }
    if data.kind == 0 || data.kind == 5: SliderBar {
        x: root.pad + root.reach;
        y: root.control-y;
        width: parent.width - 2 * root.pad - 2 * root.reach;
        height: root.control-h;
        norm: data.norm;
        high: data.kind == 5 ? data.high : -1;
        bipolar: data.bipolar;
        lit: root.lit;
    }
    if data.kind == 7 || data.kind == 8: SliderBar {
        x: root.pad;
        y: root.control-y + Theme.pad-tight;
        width: parent.width - 2 * root.pad;
        height: parent.height - self.y - Theme.pad;
        norm: data.norm;
        upright: true;
        from-top: data.kind == 8;
        lit: root.lit;
    }
    property <length> knob-side: min(min(self.height - self.control-y - (self.compact ? Theme.pad-tight : Theme.margin), self.width - 2 * self.pad), self.knob-max);
    property <length> knob-x: self.compact ? self.pad : (self.width - self.knob-side) / 2;
    // A compact knob under 28 px is a value cell instead: the value and a thin bar of where it stands (the operator table's
    // level bar); the whole tile stays the touch target.
    property <bool> cell: data.cell;
    property <length> cell-bar: Theme.pad-tight;
    if root.cell: FitText {
        x: root.pad;
        y: root.control-y;
        width: parent.width - 2 * root.pad;
        height: max(0px, root.control-h - root.cell-bar - Theme.hair);
        text: data.value;
        ink: data.editing ? Theme.accent : Theme.text;
        size: Theme.small;
        bold: true;
        align: TextHorizontalAlignment.left;
    }
    if root.cell: Rectangle {
        x: root.pad;
        y: root.control-y + root.control-h - root.cell-bar;
        width: parent.width - 2 * root.pad;
        height: root.cell-bar;
        border-radius: root.cell-bar / 2;
        background: Theme.slider-track;
        Rectangle {
            x: data.bipolar ? min(parent.width / 2, parent.width * data.norm) : 0px;
            width: data.bipolar ? abs(data.norm - 0.5) * parent.width : parent.width * data.norm;
            border-radius: parent.border-radius;
            background: root.lit ? Theme.accent : Theme.accent-dim;
        }
    }
    if data.kind == 1 && !root.cell: Knob {
        x: root.knob-x;
        y: root.control-y;
        width: root.knob-side;
        height: root.knob-side;
        arc: data.arc;
        norm: data.norm;
        lit: root.lit;
    }
    // A compact knob's value beside it, shrunk to 70% before it is cut.
    if data.kind == 1 && root.compact && !root.cell: FitText {
        x: root.knob-x + root.knob-side + root.pad;
        y: root.control-y;
        width: max(0px, parent.width - self.x - root.pad);
        height: root.control-h;
        text: data.value;
        ink: data.editing ? Theme.accent : Theme.text;
        size: Theme.small;
        bold: true;
        align: TextHorizontalAlignment.left;
    }
    // A switch is a button, on in the accent.
    if data.kind == 3: Button {
        x: root.pad;
        y: root.control-y;
        width: parent.width - 2 * root.pad;
        height: root.control-h;
        text: data.value;
        on: data.on;
        size: root.compact ? Theme.small : Theme.button;
    }
    if data.kind == 4: Field {
        x: root.pad;
        y: root.control-y;
        width: parent.width - 2 * root.pad;
        height: root.control-h;
        Label {
            x: Theme.pad;
            width: parent.width - Theme.pad - parent.height;
            height: parent.height;
            text: data.value;
            icon: data.icon;
            room: self.width;
            size: root.compact ? Theme.small : Theme.button;
            left: true;
        }
        Image {
            x: parent.width - parent.height;
            width: parent.height;
            height: parent.height;
            source: @image-url("../../hosts/standalone/icons/chevron-down.svg");
            image-fit: contain;
            colorize: Theme.text;
        }
    }
    // Split buttons (ParameterGrid's Choices): a raised track with the theme's button ends and edge, equal cells,
    // the chosen one a lifted accent cell inside it; no dividers.
    if data.kind == 2: split := Rectangle {
        x: root.pad;
        y: root.control-y;
        width: parent.width - 2 * root.pad;
        height: root.control-h;
        property <length> corner: Theme.button-radius(self.height);
        property <length> lift: Theme.cursor-width;
        if Theme.depth == DepthStyle.soft: Rectangle {
            y: Theme.shadow-offset;
            border-radius: parent.corner;
            background: Theme.shadow;
        }
        Rectangle {
            border-radius: parent.corner;
            background: Theme.raised;
            border-width: Theme.edge-width;
            border-color: Theme.edge-color;
        }
        for c[k] in data.choices: Rectangle {
            x: k * parent.width / data.choices.length;
            width: parent.width / data.choices.length;
            if k == data.chosen: Rectangle {
                x: split.lift;
                y: split.lift;
                width: parent.width - 2 * split.lift;
                height: parent.height - 2 * split.lift;
                border-radius: max(0px, split.corner - split.lift);
                background: Theme.accent;
            }
            TouchArea {
                clicked => { root.tap(root.index, k); }
            }
            Label {
                x: Theme.pad-tight;
                width: parent.width - 2 * Theme.pad-tight;
                height: parent.height;
                text: c;
                icon: k < data.icons.length ? data.icons[k] : 0;
                ink: k == data.chosen ? Theme.on-accent : Theme.muted;
            }
        }
    }
    // Touch: drag on knobs and sliders (a range takes the nearer end), tap on switches and dropdowns.
    if data.kind != 2 && data.kind != 6: TouchArea {
        property <float> start;
        property <int> end;
        property <float> across: (self.mouse-x - root.pad - root.reach) / max(1px, root.width - 2 * root.pad - 2 * root.reach);
        property <float> up: 1 - (self.mouse-y - root.control-y - Theme.pad-tight) / max(1px, root.height - root.control-y - Theme.pad - Theme.pad-tight);
        pointer-event(e) => {
            if (data.kind != 0 && data.kind != 1 && data.kind != 5 && data.kind != 7 && data.kind != 8) { return; }
            if (e.kind == PointerEventKind.down) {
                self.start = data.norm;
                self.end = data.kind == 5 && abs(self.across - data.high) < abs(self.across - data.norm) ? 1 : 0;
                root.grab(root.index, self.end);
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                root.release(root.index);
            }
        }
        moved => {
            if (data.kind == 1) {
                root.drag(root.index, 0, max(0, min(1, self.start + (self.pressed-y - self.mouse-y) / root.drag-span)));
            } else if (data.kind == 7) {
                root.drag(root.index, 0, max(0, min(1, self.up)));
            } else if (data.kind == 8) {
                root.drag(root.index, 0, max(0, min(1, 1 - self.up)));
            } else if (data.kind == 0 || data.kind == 5) {
                root.drag(root.index, self.end, max(0, min(1, self.across)));
            }
        }
        clicked => {
            if (data.kind == 3 || data.kind == 4) { root.tap(root.index, -1); }
        }
    }
    Cursor {
        shown: data.cursor;
        editing: data.editing;
    }
}

// A view's panel (an envelope's curve, a filter's response...): a section with its title and what the view draws,
// from one set of points: paths in the panel's own pixels (no scaling), boxes, labels and handles.
component ViewPanel inherits Section {
    in property <GridPanel> data;
    in property <int> index;
    property <bool> taken; // a touch holds a handle
    property <length> last;
    // The theme's color for a view's ink (src/views.rs `Ink`).
    pure function ink(i: int) -> color {
        // 32 and up: an operator's color dimmed; 24 and up: the text on it; 16 and up: the color (src/palette.rs).
        if (i >= 32) {
            return Theme.operators[i - 32].with-alpha(Theme.dim);
        }
        if (i >= 24) {
            return Theme.operators-on[i - 24];
        }
        if (i >= 16) {
            return Theme.operators[i - 16];
        }
        return i == 0 ? Theme.accent : i == 1 ? Theme.muted : i == 2 ? Theme.border : i == 3 ? Theme.text : i == 4 ? Theme.raised : i == 5 ? Theme.track : i == 6 ? Theme.background : i == 7 ? Theme.accent.with-alpha(Theme.wash-light) : i == 8 ? Theme.keys-white : i == 9 ? Theme.wash-color : i == 10 ? Theme.zone-faint : i == 12 ? Theme.focus : i == 13 ? transparent : i == 14 ? Theme.danger : i == 15 ? Theme.mark-off : Theme.on-accent;
    }
    pure function stroke(w: int) -> length {
        return w == 0 ? Theme.hair : w == 1 ? Theme.thin : Theme.cursor-width;
    }
    Text {
        x: Theme.pad-wide + Theme.pad-tight / 2;
        y: Theme.pad-tight + Theme.pad-tight / 2;
        text: data.title;
        color: Theme.muted;
        font-size: Theme.small;
        font-weight: 700;
    }
    for s in data.shapes: Path {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        fit: preserve; // the commands are in pixels of this panel: no scaling, no stroke inset
        fill: s.fill ? root.ink(s.ink) : transparent;
        stroke: s.fill ? transparent : root.ink(s.ink); // a fill keeps the stroke width of a line, so both are placed alike
        stroke-width: root.stroke(s.width);
        commands: s.commands;
    }
    for b in data.boxes: Rectangle {
        x: b.x;
        y: b.y;
        width: b.w;
        height: b.h;
        border-radius: b.mark ? Theme.mark-radius(min(b.w, b.h)) : (b.h < Theme.touch ? Theme.scaled-radius(b.h) : Theme.radius / 2);
        background: root.ink(b.fill);
        border-width: b.edge >= 0 ? Theme.hair : 0px;
        border-color: b.edge >= 0 ? root.ink(b.edge) : transparent;
        // As drawFittedText with a least scale of 0.7: a text too wide for its box shrinks to 70% before it is cut.
        measure := Text {
            visible: false;
            text: b.text;
            font-size: Theme.small;
            font-weight: b.bold ? 700 : 400;
        }
        Text {
            width: parent.width;
            height: parent.height;
            text: b.text;
            color: root.ink(b.text-ink);
            font-size: Theme.small * max(0.7, min(1.0, (parent.width - 2 * Theme.pad-tight) / max(1px, measure.preferred-width), (parent.height - 2 * Theme.hair) / max(1px, Theme.small * 1.25)));
            font-weight: b.bold ? 700 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    // A label too wide for its box shrinks to 70% before it is cut.
    for l in data.labels: Rectangle {
        x: l.x;
        y: l.y;
        width: l.w;
        height: l.h;
        label-measure := Text {
            visible: false;
            text: l.text;
            font-size: Theme.small;
            font-weight: l.bold ? 700 : 400;
        }
        Text {
            width: parent.width;
            height: parent.height;
            text: l.text;
            color: root.ink(l.ink);
            font-size: Theme.small * max(0.7, min(1.0, parent.width / max(1px, label-measure.preferred-width)));
            font-weight: l.bold ? 700 : 400;
            horizontal-alignment: l.align == 1 ? center : l.align == 2 ? right : left;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    for p in data.points: Rectangle {
        x: p.x - Theme.node / 2;
        y: p.y - Theme.node / 2;
        width: Theme.node;
        height: Theme.node;
        border-radius: Theme.node / 2;
        background: Theme.text;
        border-width: p.lit || p.held ? 1.5 * Theme.cursor-width : Theme.cursor-width;
        border-color: p.lit ? Theme.focus : Theme.accent;
    }
    // Touch: a handle is taken and dragged; a drag elsewhere scrolls the page.
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.taken = GridState.view-down(root.index, self.mouse-x, self.mouse-y);
                root.last = self.absolute-position.y + self.mouse-y;
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                if (root.taken) { GridState.view-up(root.index, self.mouse-x, self.mouse-y); }
                root.taken = false;
            }
        }
        moved => {
            if (root.taken) {
                GridState.view-move(root.index, self.mouse-x, self.mouse-y);
            } else {
                // The panel moves as the page scrolls: the place on the window, not in the panel.
                GridState.scrolled(root.last - (self.absolute-position.y + self.mouse-y));
                root.last = self.absolute-position.y + self.mouse-y;
            }
        }
    }
}

// A row of the grid's own tiles (src/grid.rs `row_layout` places them in the area): the same tiles,
// theme and cursor as a page's, for a screen that shows a few controls (Play's knob row). Touch and
// the callbacks are the page's, said to the screen that owns the row.
export component TileRow inherits Rectangle {
    in property <[GridTile]> tiles;
    callback grab(int, int); // a tile and its part: a drag begins
    callback drag(int, int, float); // a tile, its part and the value from 0 to 1
    callback release(int);
    callback tap(int, int); // a tile and a stop, or -1
    for t[i] in root.tiles: Tile {
        x: t.x;
        y: t.y;
        width: t.w;
        height: t.h;
        data: t;
        index: i;
        grab(k, part) => { root.grab(k, part); }
        drag(k, part, norm) => { root.drag(k, part, norm); }
        release(k) => { root.release(k); }
        tap(k, stop) => { root.tap(k, stop); }
    }
}

// A screen on the grid: Back, the title and Search over the pages and their tabs (TabPages), and under
// them the tiles.
export component Grid inherits Rectangle {
    // The sections' gap (none in a theme whose sections join); a heading's height (ParameterGrid's).
    property <length> gap: Theme.gap-between(Theme.gap);
    property <length> heading: 28px;
    // The tabs' placement: the theme's choice, or the one that leaves the content the larger area (TabPages).
    property <int> layout: tabs.mode;
    property <length> top: Theme.margin;
    property <length> footer: GridState.message == "" ? 0 : Theme.touch;
    property <length> area-width: tabs.content-width;
    property <length> area-height: tabs.content-height;
    changed area-width => {
        GridState.view-width = area-width;
        GridState.resized();
    }
    changed area-height => {
        GridState.view-height = area-height;
        GridState.resized();
    }
    property <length> rail: tabs.rail;
    changed rail => { GridState.rail = root.rail; }
    property <float> pages-fit: tabs.pages-fit;
    property <float> tabs-fit: tabs.tabs-fit;
    changed pages-fit => { GridState.page-fit = root.pages-fit; }
    changed tabs-fit => { GridState.tab-fit = root.tabs-fit; }
    changed layout => { GridState.layout = root.layout; }
    init => {
        GridState.layout = root.layout;
        GridState.rail = root.rail;
        GridState.page-fit = root.pages-fit;
        GridState.tab-fit = root.tabs-fit;
        GridState.view-width = area-width;
        GridState.view-height = area-height;
    }

    // The whole of the screen below the bar: the rails of the side placement run its full height.
    tabs := TabPages {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        reserve: root.footer;
        pages: GridState.pages;
        page-labels: GridState.page-labels;
        page-heading: GridState.page-heading;
        page: GridState.page;
        page-cursor: GridState.page-cursor;
        tabs: GridState.tabs;
        tab-labels: GridState.tab-labels;
        tab-heading: GridState.tab-heading;
        tab: GridState.tab;
        tab-cursor: GridState.tab-cursor;
        page-picked(i) => { GridState.show-page(i); }
        tab-picked(i) => { GridState.show-tab(i); }
    }
    area := Rectangle {
        x: tabs.x + tabs.content-x;
        y: tabs.y + tabs.content-y;
        width: root.area-width;
        height: root.area-height;
        clip: true;
        // Touch: a drag on the background scrolls.
        TouchArea {
            property <length> last;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) { self.last = self.mouse-y; }
            }
            moved => {
                GridState.scrolled(self.last - self.mouse-y);
                self.last = self.mouse-y;
            }
        }
        for h in GridState.headings: Text {
            y: h.y - GridState.scroll;
            height: root.heading;
            width: parent.width;
            vertical-alignment: center;
            text: h.text;
            color: Theme.muted;
            font-size: Theme.small;
            font-weight: 700;
            overflow: elide;
        }
        for p[i] in GridState.panels: ViewPanel {
            x: p.x;
            y: p.y - GridState.scroll;
            width: p.w;
            height: p.h;
            data: p;
            index: i;
        }
        for c in GridState.cards: Section {
            x: c.x;
            y: c.y - GridState.scroll;
            width: c.w;
            height: c.h;
        }
        for t[i] in GridState.tiles: Tile {
            x: t.x;
            y: t.y - GridState.scroll;
            width: t.w;
            height: t.h;
            data: t;
            index: i;
            grab(k, part) => { GridState.grab(k, part); }
            drag(k, part, norm) => { GridState.drag(k, part, norm); }
            release(k) => { GridState.release(k); }
            tap(k, stop) => { GridState.tap(k, stop); }
        }
        // The page is higher than its view: a track at the right edge and in it where the view is, so nothing is cut without a mark.
        if GridState.content > root.area-height + 0.5px: Rectangle {
            x: parent.width - Theme.pad-tight;
            width: Theme.pad-tight;
            height: parent.height;
            background: Theme.track;
            border-radius: self.width / 2;
            Rectangle {
                property <length> thumb: max(Theme.pad-tight * 3, parent.height * root.area-height / GridState.content);
                y: (parent.height - self.height) * GridState.scroll / max(1px, GridState.content - root.area-height);
                height: self.thumb;
                background: Theme.accent;
                border-radius: parent.border-radius;
            }
        }
        // Lines between a card's tiles.
        for t in GridState.tiles: Rectangle {
            visible: t.linked && t.x > 0;
            x: t.x - Theme.hair;
            y: t.y - GridState.scroll + Theme.pad;
            width: Theme.hair;
            height: t.h - 2 * Theme.pad;
            background: Theme.border;
        }
    }
    if GridState.message != "": Text {
        x: tabs.content-x;
        y: root.height - Theme.margin - root.footer;
        width: tabs.content-width;
        height: root.footer;
        vertical-alignment: center;
        overflow: elide;
        font-size: Theme.small;
        color: Theme.muted;
        text: GridState.message;
    }
    // A dropdown open: its values over the grid, the chosen one under the cursor; the shared scroll bar and a finger
    // drag turn its view when it holds more than fits (issue #269), as the shared lists scroll.
    property <bool> dz-on: false;
    property <int> dz-last: 0;
    if GridState.list-open: Rectangle {
        property <int> per: max(1, floor((root.height - root.top - 2 * Theme.margin - Theme.touch) / (Theme.touch + root.gap)));
        init => { GridState.list-per-view = self.per; }
        changed per => { GridState.list-per-view = self.per; }
        background: Theme.scrim;
        TouchArea {
            clicked => { GridState.choose(-1); }
        }
        Section {
            x: (parent.width - self.width) / 2;
            y: root.top - Theme.touch;
            width: min(Theme.overlay-width, parent.width - 2 * Theme.margin);
            height: Theme.touch + min(GridState.list.length, parent.per) * (Theme.touch + root.gap) + Theme.margin;
            Text {
                x: Theme.pad-wide;
                height: Theme.touch;
                vertical-alignment: center;
                text: GridState.list-title;
                color: Theme.muted;
                font-size: Theme.small;
                font-weight: 700;
            }
            bar := ScrollBar {
                visible: root.long;
                x: parent.width - Theme.scroll-lane - Theme.margin;
                y: Theme.touch + Theme.pad-tight;
                width: Theme.scroll-lane;
                height: parent.height - Theme.touch - 2 * Theme.pad-tight - Theme.margin;
                total: GridState.list.length;
                first: GridState.list-first;
                per-view: root.per-list;
                scrolled(page) => { GridState.list-scrolled(page); }
            }
            for v[k] in GridState.list: Section {
                property <int> place: k - GridState.list-first;
                visible: self.place >= 0 && self.place < root.per-list;
                property <length> press-y: 0px;
                property <bool> armed: false;
                property <bool> dragging: false;
                x: Theme.margin;
                y: Theme.touch + self.place * (Theme.touch + root.gap);
                width: parent.width - 2 * Theme.margin - root.lane;
                height: Theme.touch;
                fill: k == GridState.list-cursor ? Theme.wash-color : Theme.raised;
                TouchArea {
                    pointer-event(e) => {
                        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                            parent.press-y = self.mouse-y;
                            parent.armed = true;
                            parent.dragging = false;
                            root.dz-last = GridState.list-first;
                        } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                            if (parent.armed && !parent.dragging && e.kind == PointerEventKind.up) {
                                GridState.choose(k);
                            }
                            parent.armed = false;
                            parent.dragging = false;
                            root.dz-on = false;
                        }
                    }
                    moved => {
                        if (parent.armed && !parent.dragging) {
                            let dy = self.mouse-y - parent.press-y;
                            if (dy < -Theme.scroll-drag-threshold || dy > Theme.scroll-drag-threshold) {
                                parent.dragging = true;
                            }
                        }
                        if (parent.dragging) {
                            let up = round((parent.press-y - self.mouse-y) / (Theme.touch + root.gap));
                            let target = max(0, min(root.dz-last + up, GridState.list.length - 1));
                            if (target != GridState.list-first) { GridState.list-scrolled(target); }
                        }
                    }
                }
                Label {
                    x: Theme.pad;
                    width: parent.width - 2 * Theme.pad;
                    height: parent.height;
                    text: v;
                    icon: k < GridState.list-icons.length ? GridState.list-icons[k] : 0;
                    room: self.width;
                    left: true;
                }
                Cursor {
                    shown: k == GridState.list-cursor;
                }
            }
        }
    }
    property <int> per-list: GridState.list-per-view;
    property <bool> long: GridState.list-open && GridState.list.length > per-list;
    property <length> lane: long ? Theme.scroll-lane + Theme.scroll-gap : 0px;
}
