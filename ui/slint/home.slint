// Home (RFC 0030): a tile per app, as the JUCE Launcher lays them out on a device's screen
// (Launcher.cpp: columns of about 200 pixels, 120 tall, the least gap), the cursor a border.

import { Theme, Section, Cursor } from "theme.slint";

export struct TileData {
    name: string,
    line: string,
    icon: int,
    cursor: bool,
}

// What Home shows, set by shell.rs.
export global HomeState {
    in property <[TileData]> tiles;
    callback tapped(int);
}

export component Home inherits Rectangle {
    out property <int> columns: clamp(floor((self.width - 2 * Theme.margin) / 200px), 1, max(1, HomeState.tiles.length));
    property <length> tile-width: (self.width - 2 * Theme.margin - (columns - 1) * gap) / columns;
    // Launcher.cpp's tile: about 200 wide, 120 tall, an icon chip 48 square with its 24 glyph, a 18 line under the name.
    // The paddings grow the tile with the theme's spacing, so the chip, the name and the line keep their room.
    property <length> tile-height: 120px + 24px * (Theme.spacing - 1);
    property <length> icon-chip: 48px;
    property <length> icon: 24px;
    property <length> line: 18px;
    property <length> gap: Theme.gap-between(Theme.gap);
    // As home.rs's APPS: Performance, Library, Setlist, Groovebox, Recordings, Settings.
    property <[image]> icons: [
        @image-url("../../hosts/standalone/icons/piano.svg"),
        @image-url("../../hosts/standalone/icons/library-big.svg"),
        @image-url("../../hosts/standalone/icons/list-music.svg"),
        @image-url("../../hosts/standalone/icons/layout-grid.svg"),
        @image-url("../../hosts/standalone/icons/audio-lines.svg"),
        @image-url("../../hosts/standalone/icons/settings.svg"),
    ];
    for tile[i] in HomeState.tiles: Section {
        x: Theme.margin + mod(i, root.columns) * (root.tile-width + gap);
        y: Theme.margin + floor(i / root.columns) * (root.tile-height + gap);
        width: root.tile-width;
        height: root.tile-height;
        Rectangle {
            x: Theme.pad-wide;
            y: Theme.pad-wide;
            width: root.icon-chip;
            height: root.icon-chip;
            background: Theme.raised;
            border-radius: Theme.button-radius(self.height);
            Image {
                width: root.icon;
                height: root.icon;
                source: root.icons[tile.icon];
                colorize: Theme.text;
            }
        }
        Text {
            x: Theme.pad-wide;
            y: parent.height - Theme.pad-wide - root.line - self.height;
            width: parent.width - 2 * Theme.pad-wide;
            overflow: elide;
            font-size: Theme.title;
            font-weight: 700;
            color: Theme.text;
            text: tile.name;
        }
        Text {
            x: Theme.pad-wide;
            y: parent.height - Theme.pad-wide - self.height;
            width: parent.width - 2 * Theme.pad-wide;
            overflow: elide;
            font-size: Theme.small;
            color: Theme.muted;
            text: tile.line;
        }
        TouchArea {
            clicked => { HomeState.tapped(i); }
        }
        Cursor {
            shown: tile.cursor;
        }
    }
}
