// The on-screen text keyboard (src/keyboard.rs), the JUCE TextKeyboard's layout: the text with its
// caret and Left, Right, Clear, Cancel and Done in the top row, then four rows of keys.

import { Theme, Field, Cursor, DepthStyle } from "theme.slint";

export struct KeyData {
    label: string,
    x: float, // in key units from the row's left
    w: float, // in key units
    total: float, // the row's width in key units
    row: int,
    index: int, // in the layout, which `pressed` names
    cursor: bool,
    on: bool,
    special: bool,
    disabled: bool,
    done: bool,
}

export global KeyboardState {
    in property <bool> open;
    in property <string> title;
    in property <string> before; // the text before the caret
    in property <string> after;
    in property <float> line; // the text's share of the top row
    in property <bool> keys-shown: true; // false: a typing keyboard does the typing
    in property <[KeyData]> keys;
    // The overlay on a screen with no typing keyboard (the reference's, TextKeyboard.cpp: the lower part of the screen):
    // a caption line, then five rows of keys each a touch target tall.
    out property <length> overlay-height: Theme.pad-narrow + (Theme.body + Theme.pad-narrow) + Theme.gap + 5 * Theme.touch + 4 * Theme.gap + Theme.margin;
    callback pressed(int); // a tap types at once, as the JUCE keys are triggered on mouse down
    callback released();
    callback cancel();
}

export component Keyboard inherits Rectangle {
    property <length> gutter: Theme.gap;
    property <length> row-width: self.width - 2 * Theme.margin;
    // The caption (what is being typed) over the rows: in the overlay a line of the body type, with a typing keyboard
    // (a whole screen, the top row only) a touch target.
    property <length> caption: KeyboardState.keys-shown ? Theme.body + Theme.pad-narrow : Theme.touch;
    property <length> top: (KeyboardState.keys-shown ? Theme.pad-narrow : Theme.margin) + root.caption + root.gutter;
    // A touch target tall each, as the reference's; with a typing keyboard as tall as the screen allows.
    property <length> key-height: KeyboardState.keys-shown ? Theme.touch : min(2 * Theme.touch, (self.height - 2 * Theme.margin - Theme.touch - 6 * gutter) / 5);
    background: Theme.surface;
    // Takes every tap while it is open, so nothing under it is pressed.
    TouchArea { }
    Text {
        x: Theme.margin;
        y: KeyboardState.keys-shown ? Theme.pad-narrow : Theme.margin;
        width: parent.width - 2 * Theme.margin;
        height: root.caption;
        text: KeyboardState.title;
        color: Theme.muted;
        font-size: KeyboardState.keys-shown ? Theme.small : Theme.body;
        overflow: elide;
        vertical-alignment: center;
    }
    Field {
        x: Theme.margin;
        y: root.top;
        width: KeyboardState.line * root.row-width - root.gutter;
        height: root.key-height;
        fill: Theme.background;
        clip: true;
        Text {
            x: Theme.pad-narrow;
            width: parent.width - 2 * Theme.pad-narrow;
            height: parent.height;
            text: KeyboardState.before + "|" + KeyboardState.after;
            color: Theme.text;
            font-size: Theme.body;
            overflow: elide;
            vertical-alignment: center;
        }
    }
    // A key is a button as the theme draws them: its corners, edge and shadow.
    for key[i] in KeyboardState.keys: Rectangle {
        x: Theme.margin + key.x / key.total * root.row-width;
        y: root.top + (key.row == 0 ? 0px : (key.row) * (root.key-height + root.gutter));
        width: key.w / key.total * root.row-width - root.gutter;
        height: root.key-height;
        opacity: key.disabled ? Theme.disabled : 1;
        if Theme.depth == DepthStyle.soft: Rectangle {
            y: Theme.shadow-offset;
            border-radius: Theme.scaled-radius(parent.height);
            background: Theme.shadow;
        }
        Rectangle {
            border-radius: Theme.scaled-radius(parent.height);
            background: key.done ? Theme.accent : key.on ? Theme.accent.with-alpha(Theme.wash-strong) : key.special ? Theme.raised : Theme.key-fill;
            border-width: Theme.edge-width;
            border-color: Theme.edge-color;
        }
        Text {
            text: key.label;
            color: key.done ? Theme.on-accent : Theme.text;
            font-size: Theme.button;
            font-weight: key.special ? 700 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            enabled: !key.disabled;
            pointer-event(e) => {
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                    KeyboardState.pressed(key.index);
                } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                    KeyboardState.released();
                }
            }
        }
        Cursor {
            shown: key.cursor;
            always: true;
            corner: Theme.scaled-radius(parent.height);
        }
    }
}
