// The Library app (src/library): the tabs of the kinds it shows (Performances, Sounds, Setlists; the
// Catalog's four) in the shared tab family, which the theme's tabPlacement puts in a strip or a rail.
// The list under them is the shared list screen (part.slint's Part, which the shell lays in the
// area these tabs leave: content-x, content-y, content-width and content-height), so this component
// draws nothing else.

import { TabPages, TabLabel } from "theme.slint";

export global LibraryState {
    in property <[string]> pages;
    in property <[TabLabel]> page-labels;
    in property <string> page-heading;
    in property <int> page;
    in property <int> page-cursor: -1;
    callback show-page(int);
}

export component Library inherits Rectangle {
    out property <length> content-x: tabs.content-x;
    out property <length> content-y: tabs.content-y;
    out property <length> content-width: tabs.content-width;
    out property <length> content-height: tabs.content-height;
    out property <length> rail: tabs.rail;
    out property <length> rail-need: tabs.rail-need;
    out property <float> rail-fit: tabs.pages-fit;
    tabs := TabPages {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        pages: LibraryState.pages;
        page-labels: LibraryState.page-labels;
        page-heading: LibraryState.page-heading;
        page: LibraryState.page;
        page-cursor: LibraryState.page-cursor;
        page-picked(i) => { LibraryState.show-page(i); }
    }
}
