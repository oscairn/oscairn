// SPDX-License-Identifier: AGPL-3.0-or-later
// The Library app (src/library): under the top bar one row, the kinds it shows (Performances, Sounds, Setlists; the
// Catalog's four) as the shared tabs in a strip, then a search box. Under it, for the kinds, a sidebar (Favorites,
// Recent, the libraries and the tags) at the left and the list at the right. The list is the shared list screen
// (part.slint's Part, which the shell lays in the area this leaves: content-x, content-y, content-width and
// content-height); this component draws the row and the sidebar.

import { Theme, TabBar, TabLabel, Field, Cursor, FitText, Button, Section } from "theme.slint";
import { Row, ScrollBar, SettingData, PartState } from "part.slint";

// Where a sidebar line is in the view: its line (counted from the view's first), and for bubbles its place along it,
// its top in the view and its height (a heading line is a compact label, a bubble line a touch target).
export struct SideGeo {
    line: int,
    x: length,
    w: length,
    y: length,
    h: length,
}

export global LibraryState {
    in property <[string]> pages;
    in property <[TabLabel]> page-labels;
    in property <string> page-heading;
    in property <int> page;
    in property <int> page-cursor: -1;
    callback show-page(int);
    // The row under the top bar (the tabs and the search box): shown in the list and in the Catalog.
    in property <bool> header;
    in property <string> search;
    in property <bool> search-cursor;
    in property <bool> clear-cursor;
    callback search-tapped();
    callback search-cleared();
    // The panel (what the item under the cursor is) shown in the sidebar's place, and the button that shows it.
    in property <bool> info-on;
    in property <bool> info-cursor;
    callback info-toggled();
    // The sidebar's entries as wrapping bubbles (pills), not one to a line: its button in the row under the top bar.
    in property <bool> bubbles;
    in property <bool> view-cursor;
    callback view-toggled();
    // Compact: the rows and the entries closer (its button is in the same row), and the sections of the sidebar that fold.
    in property <bool> compact;
    in property <bool> compact-cursor;
    callback compact-toggled();
    // Each line's place in the view, and the width the sidebar's entries have (set here, read by the lines' layout).
    in property <[SideGeo]> side-geo;
    in-out property <length> side-room: 280px;
    // The height the sidebar has to show its lines (set here from the window; read by the entries' layout).
    in-out property <length> side-height: 0px;
    // The list with the sidebar at its left (the kinds), else the list as the other screens have it.
    in property <bool> list-only;
    in property <[SettingData]> side-rows;
    in property <int> side-total;
    in property <int> side-first;
    in-out property <int> side-per-view: 1;
    callback side-tapped(int);
    callback side-scrolled(int);
    callback side-resized();
}

// An icon button in the row under the top bar: a toggle (`on`), with its name for the accessibility tree and a cursor ring.
component ToolButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> on;
    in property <bool> cursor;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.on;
    Button {
        text: "";
        on: root.on;
        clicked => { root.clicked(); }
    }
    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Theme.icon * 0.85;
        height: Theme.icon * 0.85;
        source: root.icon;
        colorize: root.on ? Theme.on-accent : Theme.text;
    }
    Cursor {
        corner: Theme.button-radius(parent.height);
        shown: root.cursor;
        always: true;
    }
}

// A sidebar section's heading: it folds the section (a press or a touch), its chevron says whether the entries under it are shown
// (`value`, "open" or "closed"); "No tags" (a line with nothing to fold) is the same line without the chevron (`value` empty).
component Heading inherits Rectangle {
    in property <SettingData> data;
    callback tapped();
    property <bool> folds: root.data.fluid;
    accessible-role: text;
    accessible-label: root.data.label;
    if root.folds: Rectangle {
        accessible-role: button;
        accessible-label: root.data.label + (root.data.value == "open" ? ", expanded" : ", collapsed");
        TouchArea {
            clicked => { root.tapped(); }
        }
    }
    Text {
        x: Theme.pad;
        width: parent.width - 2 * Theme.pad - (root.folds ? Theme.icon : 0px);
        height: parent.height;
        vertical-alignment: center;
        overflow: elide;
        font-size: Theme.small;
        font-weight: 700;
        color: Theme.muted;
        text: root.data.label;
    }
    if root.folds: Image {
        x: parent.width - Theme.pad - self.width;
        y: (parent.height - self.height) / 2;
        width: Theme.icon * 0.7;
        height: Theme.icon * 0.7;
        source: root.data.value == "open" ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg");
        colorize: Theme.muted;
    }
    Cursor {
        corner: Theme.button-radius(parent.height);
        shown: root.data.cursor;
    }
}

// A sidebar entry as a bubble: the family's corner, the accent when chosen, the tag's color as a dot before its name.
component Pill inherits Rectangle {
    in property <SettingData> data;
    callback tapped();
    property <length> dot: Theme.small * 0.7;
    property <length> dot-room: root.data.tinted ? root.dot + Theme.pad-tight : 0px;
    background: root.data.on ? Theme.accent.with-alpha(Theme.wash) : Theme.raised;
    border-radius: Theme.button-radius(self.height);
    border-width: root.data.on ? 2 * Theme.hair : Theme.edge-width;
    border-color: root.data.on ? Theme.accent : Theme.edge-color;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.data.on;
    accessible-label: root.data.label;
    if root.data.tinted: Rectangle {
        x: Theme.pad;
        y: (parent.height - self.height) / 2;
        width: root.dot;
        height: root.dot;
        border-radius: self.width / 2;
        background: root.data.tint;
    }
    FitText {
        x: Theme.pad + root.dot-room;
        width: parent.width - 2 * Theme.pad - root.dot-room;
        height: parent.height;
        text: root.data.label;
        ink: root.data.on ? Theme.accent : Theme.text;
        bold: root.data.on;
    }
    TouchArea {
        clicked => { root.tapped(); }
    }
    Cursor {
        corner: Theme.button-radius(parent.height);
        shown: root.data.cursor;
    }
}

export component Library inherits Rectangle {
    // The sidebar's and the list's top and the sidebar's height are the Part's (its rows, gap and footer).
    property <length> gap: Theme.dense(Theme.list-gap, LibraryState.compact);
    property <length> head: LibraryState.header ? Theme.touch + Theme.dense(Theme.gap, LibraryState.compact) : 0px;
    out property <length> side-width: LibraryState.list-only ? (root.width - 3 * Theme.margin) * Theme.sidebar-share : 0px;
    out property <length> content-x: LibraryState.list-only ? 2 * Theme.margin + root.side-width : Theme.margin;
    out property <length> content-y: Theme.margin + root.head;
    out property <length> content-width: max(0px, root.width - root.content-x - Theme.margin);
    out property <length> content-height: max(0px, root.height - root.content-y - Theme.margin);
    property <length> side-height: max(0px, root.content-height - Theme.footer(LibraryState.compact) - Theme.gap);
    // Bubbles are as far apart as the dense gap (a joined theme has no gap between its lines, but pills are apart).
    property <length> step-gap: LibraryState.bubbles ? Theme.dense(Theme.gap, LibraryState.compact) : root.gap;
    // The lines that fit are the Rust layout's (their heights vary: a heading is compact); it writes them to the state, read here.
    property <int> side-per-view: LibraryState.side-per-view;
    // What the entries share across: the sidebar less its lane (kept in bubbles whether or not a bar shows, so that the lines
    // that wrap do not change with the bar) and the overlap the rows take.
    property <length> side-room: max(0px, root.side-width - (LibraryState.bubbles || root.side-long ? Theme.scroll-lane - Theme.scroll-overlap : 0px));
    changed side-room => { LibraryState.side-room = root.side-room; LibraryState.side-resized(); }
    changed side-height => { LibraryState.side-height = root.side-height; LibraryState.side-resized(); }
    property <bool> side-long: LibraryState.side-total > root.side-per-view;
    init => {
        LibraryState.side-room = root.side-room;
    }
    out property <length> tabs-width: min(tabs.natural, root.width * 0.55);
    out property <length> search-x: Theme.margin + root.tabs-width + Theme.margin;
    // The buttons at the right end of the row: the sidebar's view, then the panel.
    property <length> tool: Theme.touch + Theme.margin;
    property <length> tools: LibraryState.list-only ? 3 * root.tool : 0px;
    out property <length> search-width: max(0px, root.width - root.search-x - Theme.margin - root.tools);
    property <length> line: Theme.body + Theme.margin;

    tabs := TabBar {
        visible: LibraryState.header;
        x: Theme.margin;
        y: Theme.margin;
        width: root.tabs-width;
        height: Theme.touch;
        names: LibraryState.pages;
        labels: LibraryState.page-labels;
        heading: LibraryState.page-heading;
        current: LibraryState.page;
        cursor: LibraryState.page-cursor;
        picked(i) => { LibraryState.show-page(i); }
    }
    // The search box: a tap asks for the text on the keyboard, the cross takes it away.
    if LibraryState.header: Field {
        x: root.search-x;
        y: Theme.margin;
        width: root.search-width;
        height: Theme.touch;
        TouchArea {
            clicked => { LibraryState.search-tapped(); }
        }
        Text {
            x: Theme.pad;
            width: parent.width - 2 * Theme.pad - (LibraryState.search == "" ? 0px : Theme.touch);
            height: parent.height;
            vertical-alignment: center;
            overflow: elide;
            font-size: Theme.body;
            color: LibraryState.search == "" ? Theme.muted : Theme.text;
            text: LibraryState.search == "" ? "Search" : LibraryState.search;
        }
        Cursor {
            corner: Theme.field-radius(parent.height);
            shown: LibraryState.search-cursor;
            always: true;
        }
        if LibraryState.search != "": Rectangle {
            x: parent.width - Theme.touch;
            width: Theme.touch;
            height: parent.height;
            TouchArea {
                clicked => { LibraryState.search-cleared(); }
            }
            Text {
                width: parent.width;
                height: parent.height;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: Theme.body;
                color: Theme.text;
                text: "×";
            }
            Cursor {
                x: Theme.hair * 2;
                y: Theme.hair * 2;
                width: parent.width - 4 * Theme.hair;
                height: parent.height - 4 * Theme.hair;
                corner: Theme.field-radius(parent.height);
                shown: LibraryState.clear-cursor;
                always: true;
            }
        }
    }
    // The buttons at the right of the row: the sidebar as bubbles, and the panel in place of the sidebar (and back).
    if LibraryState.header && LibraryState.list-only: ToolButton {
        x: root.width - Theme.margin - 3 * root.tool + Theme.margin;
        y: Theme.margin;
        width: Theme.touch;
        height: Theme.touch;
        label: "Bubbles";
        icon: @image-url("icons/view-bubbles.svg");
        on: LibraryState.bubbles;
        cursor: LibraryState.view-cursor;
        clicked => { LibraryState.view-toggled(); }
    }
    if LibraryState.header && LibraryState.list-only: ToolButton {
        x: root.width - Theme.margin - 2 * root.tool + Theme.margin;
        y: Theme.margin;
        width: Theme.touch;
        height: Theme.touch;
        label: "Compact";
        icon: @image-url("icons/compact.svg");
        on: LibraryState.compact;
        cursor: LibraryState.compact-cursor;
        clicked => { LibraryState.compact-toggled(); }
    }
    if LibraryState.header && LibraryState.list-only: ToolButton {
        x: root.width - Theme.margin - Theme.touch;
        y: Theme.margin;
        width: Theme.touch;
        height: Theme.touch;
        label: "Details";
        icon: @image-url("icons/info.svg");
        on: LibraryState.info-on;
        cursor: LibraryState.info-cursor;
        clicked => { LibraryState.info-toggled(); }
    }
    // The panel in the sidebar's place: what the item under the cursor is, a few lines a view, turned by the arrows.
    if LibraryState.list-only && LibraryState.info-on: Section {
        x: Theme.margin;
        y: root.content-y;
        width: root.side-width;
        height: root.side-height;
        clip: true;
        for text[i] in PartState.info: FitText {
            x: Theme.pad;
            y: Theme.pad-narrow + i * root.line;
            width: parent.width - 2 * Theme.pad;
            height: root.line;
            text: text.text;
            opacity: text.off ? Theme.dim : 1;
            ink: text.head ? Theme.muted : text.failed ? Theme.danger : Theme.text;
            size: text.head ? Theme.small : Theme.body;
            bold: text.head;
            align: TextHorizontalAlignment.left;
        }
        if PartState.info-more: Button {
            x: parent.width - 2 * Theme.touch - Theme.pad-narrow;
            y: parent.height - Theme.touch - Theme.pad-tight;
            width: Theme.touch;
            height: Theme.touch;
            text: "▲";
            clicked => { PartState.info-scroll(-1); }
        }
        if PartState.info-more: Button {
            x: parent.width - Theme.touch - Theme.pad-tight;
            y: parent.height - Theme.touch - Theme.pad-tight;
            width: Theme.touch;
            height: Theme.touch;
            text: "▼";
            clicked => { PartState.info-scroll(1); }
        }
    }
    // The sidebar: one line an entry, or bubbles that wrap; a heading over each section.
    for row[i] in LibraryState.side-rows: Rectangle {
        property <SideGeo> geo: LibraryState.side-geo[i];
        x: Theme.margin + (LibraryState.bubbles ? self.geo.x : 0px);
        y: root.content-y + (LibraryState.bubbles ? self.geo.y : i * (Theme.touch + root.step-gap));
        width: LibraryState.bubbles ? self.geo.w : root.side-room;
        height: LibraryState.bubbles ? self.geo.h : Theme.touch;
        if row.kind == 4: Heading {
            width: parent.width;
            height: parent.height;
            data: row;
            tapped => { LibraryState.side-tapped(i); }
        }
        if row.kind != 4 && !LibraryState.bubbles: Row {
            width: parent.width;
            height: parent.height;
            data: row;
            tapped => { LibraryState.side-tapped(i); }
        }
        if row.kind != 4 && LibraryState.bubbles: Pill {
            width: parent.width;
            height: parent.height;
            data: row;
            tapped => { LibraryState.side-tapped(i); }
        }
    }
    ScrollBar {
        visible: root.side-long && LibraryState.list-only;
        x: Theme.margin + root.side-width - Theme.scroll-lane;
        y: root.content-y;
        width: Theme.scroll-lane;
        height: root.side-height;
        total: LibraryState.side-total;
        first: LibraryState.side-first;
        per-view: root.side-per-view;
        scrolled(first) => { LibraryState.side-scrolled(first); }
    }
}
