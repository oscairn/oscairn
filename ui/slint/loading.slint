// SPDX-License-Identifier: AGPL-3.0-or-later
// A wait the player expects (a Performance opening, a package installing, an export): a line saying what, over a thin
// bar that fills to `progress` when the engine reports one (0..1) and sweeps when it does not (negative). The only
// moving thing in the UI: it is drawn while it exists, so it is shown only while the wait lasts (docs/rust-ui.md,
// "Waits"). Its sizes, colors and the sweep's period are the theme's. With no text it is the bar alone (a tile's edge).

import { Theme } from "theme.slint";

export component Loading inherits Rectangle {
    in property <string> text;
    in property <float> progress: -1;
    // The text's width as it would be set whole, so a bar can make room for it.
    out property <length> wanted: measure.preferred-width;
    // The sweep's place in its period, 0 to 1 and round again.
    property <float> phase: mod(animation-tick() / Theme.loading-period, 1.0);
    property <length> segment: track.width * Theme.loading-segment;
    // The text's line leaves room for its descenders before the bar.
    property <length> line: Theme.small * 1.3;
    height: root.text == "" ? Theme.loading-bar : line + Theme.pad-tight + Theme.loading-bar;
    measure := Text {
        visible: false;
        font-size: Theme.small;
        text: root.text;
    }
    if root.text != "": Text {
        width: parent.width;
        height: root.line;
        overflow: elide;
        vertical-alignment: center;
        font-size: Theme.small;
        color: Theme.text;
        text: root.text;
    }
    track := Rectangle {
        y: parent.height - Theme.loading-bar;
        height: Theme.loading-bar;
        background: Theme.track;
        border-radius: self.height / 2;
        clip: true;
        if root.progress >= 0: Rectangle {
            width: parent.width * min(root.progress, 1.0);
            background: Theme.accent;
            border-radius: parent.border-radius;
        }
        if root.progress < 0: Rectangle {
            x: -root.segment + root.phase * (parent.width + root.segment);
            width: root.segment;
            background: Theme.accent;
            border-radius: parent.border-radius;
        }
    }
}
