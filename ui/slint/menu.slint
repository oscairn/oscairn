// SPDX-License-Identifier: AGPL-3.0-or-later
// A menu over the screen (src/menu.rs): the JUCE popup menus of the Edit view's pages (a control's
// targets, a curve, the scenes a mapping works in, Routing's connections) as a list with a border
// cursor. A row is a choice (ticked or not), a submenu (opens the next list), or a heading. The
// dial and the knobs move the cursor, a press chooses or opens, Cancel goes up a level and closes at
// the first. How many rows show is what fills the height, so it follows the window, the spacing and
// the type scale.

import { Theme, Section, Button, Cursor } from "theme.slint";
import { ScrollBar } from "part.slint";

export struct MenuRow {
    label: string,
    tick: int, // -1 no tick, 0 unticked, 1 ticked
    enabled: bool,
    sub: bool, // opens another list
    head: bool, // a heading: not chosen
    cursor: bool,
}

export global MenuState {
    in property <bool> open;
    in property <string> title; // the path to the list: "Plugin parameter › Synth"
    in property <[MenuRow]> rows;
    in property <string> view; // "1–8 of 30"
    in property <bool> more; // some rows are out of this view
    in property <bool> up; // a submenu is open: Back goes up a level
    // How many rows fit: set by the component.
    in-out property <int> rows-per-view: 1;
    // The list's size and the view's first row, for its scroll bar (0: no bar); a drag or a tap on
    // the bar asks for a view, as the shared lists do.
    in property <int> total;
    in property <int> first;
    callback scrolled(int);
    callback resized();
    callback tapped(int); // a row of the view
    callback back(); // up a level, or closes at the first
    callback close();
    callback turn(int); // a view towards the start (-1) or the end (1)
}

component Entry inherits Section {
    in property <MenuRow> data;
    callback tapped();
    // A finger drag on this row: once the drag passes the theme's threshold it is a scroll (`drag-move`,
    // the vertical offset since the press), not a tap; a press and a release within the threshold are a tap.
    callback drag-move(length);
    callback drag-end();
    property <length> press-y: 0px;
    property <bool> armed: false;
    property <bool> dragging: false;
    opacity: data.enabled || data.head ? 1 : Theme.disabled;
    fill: data.head ? Theme.background : Theme.surface;
    if !data.head: TouchArea {
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.press-y = self.mouse-y;
                root.armed = true;
                root.dragging = false;
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                if (root.armed && !root.dragging && e.kind == PointerEventKind.up) {
                    root.tapped();
                }
                root.armed = false;
                root.dragging = false;
                root.drag-end();
            }
        }
        moved => {
            if (root.armed && !root.dragging) {
                let dy = self.mouse-y - root.press-y;
                if (dy < -Theme.scroll-drag-threshold || dy > Theme.scroll-drag-threshold) {
                    root.dragging = true;
                }
            }
            if (root.dragging) {
                root.drag-move(self.mouse-y - root.press-y);
            }
        }
    }
    Text {
        x: Theme.pad;
        width: parent.width - 2 * Theme.pad - Theme.touch;
        height: parent.height;
        text: data.label;
        color: data.head ? Theme.muted : Theme.text;
        font-size: data.head ? Theme.small : Theme.body;
        font-weight: data.head ? 700 : 400;
        overflow: elide;
        vertical-alignment: center;
    }
    Text {
        x: parent.width - Theme.pad - Theme.touch;
        width: Theme.touch;
        height: parent.height;
        text: data.sub ? "›" : data.tick == 1 ? "✓" : "";
        color: data.tick == 1 ? Theme.accent : Theme.muted;
        font-size: Theme.body;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Cursor {
        shown: data.cursor;
        always: true;
    }
}

export component Menu inherits Rectangle {
    property <length> gap: Theme.gap-between(Theme.gap);
    property <length> header: Theme.touch;
    property <length> footer: Theme.small + 2 * Theme.pad-tight;
    property <length> panel-width: min(Theme.overlay-width, self.width - 2 * Theme.margin);
    property <length> available: self.height - 2 * Theme.margin - header - footer - 2 * Theme.gap;
    property <int> per-view: max(1, floor((available + gap) / (Theme.touch + gap)));
    property <int> shown: min(MenuState.rows.length, per-view);
    property <length> panel-height: header + footer + 2 * Theme.gap + max(1, shown) * Theme.touch + max(0, shown - 1) * gap;
    // The scroll bar's lane at the list's right edge, when the list is longer than the view; the rows are narrower by it.
    property <bool> long: MenuState.total > per-view;
    property <length> lane: long ? Theme.scroll-lane : 0px;
    // A finger drag on a list row scrolls the view (as the shared lists' drag does): the anchor and the row pitch.
    property <bool> dz-on: false;
    property <int> dz-first0: 0;
    property <length> dz-y0: 0px;
    property <length> dz-pitch: Theme.touch + root.gap;
    function dz-move(dy: length) {
        if (!root.dz-on) { root.dz-on = true; root.dz-first0 = MenuState.first; root.dz-y0 = dy; }
        let up = round((root.dz-y0 - dy) / root.dz-pitch);
        let target = max(0, min(root.dz-first0 + up, MenuState.total - 1));
        if (target != MenuState.first) { MenuState.scrolled(target); }
    }
    function dz-end() { root.dz-on = false; }
    changed per-view => { MenuState.rows-per-view = per-view; MenuState.resized(); }
    init => {
        MenuState.rows-per-view = per-view;
        MenuState.resized();
    }
    background: Theme.scrim;
    // A tap outside the list closes it; one inside is the list's own.
    TouchArea {
        clicked => { MenuState.close(); }
    }
    Section {
        x: (parent.width - root.panel-width) / 2;
        y: (parent.height - root.panel-height) / 2;
        width: root.panel-width;
        height: root.panel-height;
        fill: Theme.raised;
        TouchArea { }
        Button {
            x: Theme.pad-tight;
            y: Theme.pad-tight;
            width: Theme.touch * 1.6;
            height: root.header - 2 * Theme.pad-tight;
            text: MenuState.up ? "‹ Back" : "Close";
            clicked => { MenuState.back(); }
        }
        Text {
            x: Theme.touch * 1.6 + Theme.pad;
            y: 0;
            width: parent.width - self.x - Theme.pad - (MenuState.more ? 2 * (Theme.touch + Theme.pad-tight) : 0px);
            height: root.header;
            text: MenuState.title;
            color: Theme.muted;
            font-size: Theme.body;
            overflow: elide;
            vertical-alignment: center;
        }
        if MenuState.more: Button {
            x: parent.width - 2 * Theme.touch - Theme.pad-tight;
            y: Theme.pad-tight;
            width: Theme.touch;
            height: root.header - 2 * Theme.pad-tight;
            text: "▲";
            clicked => { MenuState.turn(-1); }
        }
        if MenuState.more: Button {
            x: parent.width - Theme.touch - Theme.pad-tight;
            y: Theme.pad-tight;
            width: Theme.touch;
            height: root.header - 2 * Theme.pad-tight;
            text: "▼";
            clicked => { MenuState.turn(1); }
        }
        for row[i] in MenuState.rows: Entry {
            x: Theme.pad-tight;
            y: root.header + root.gap + i * (Theme.touch + root.gap);
            width: parent.width - 2 * Theme.pad-tight - root.lane;
            height: Theme.touch;
            data: row;
            tapped => { MenuState.tapped(i); }
            drag-move(dy) => { root.dz-move(dy); }
            drag-end() => { root.dz-end(); }
        }
        bar := ScrollBar {
            visible: root.long;
            x: parent.width - Theme.scroll-lane - Theme.pad-tight;
            y: root.header + root.gap;
            width: Theme.scroll-lane;
            height: parent.height - root.header - root.footer - 2 * root.gap;
            total: MenuState.total;
            first: MenuState.first;
            per-view: root.per-view;
            scrolled(page) => { MenuState.scrolled(page); }
        }
        Text {
            x: Theme.pad;
            y: parent.height - root.footer;
            width: parent.width - 2 * Theme.pad;
            height: root.footer;
            text: MenuState.view;
            color: Theme.muted;
            font-size: Theme.small;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}
