// The Part screen (src/part.rs), the JUCE Part page's settings for one part: a list of settings on
// the left (each its name and value; a cursor is a focus border, a value being changed with the
// dial an accent one), what the part is made of on the right, read only.

import { Theme, Section, Button, Cursor, FitText } from "theme.slint";

export struct SettingData {
    label: string,
    value: string,
    kind: int, // 0 a value changed with the dial (and - +), 1 on or off, 2 an action, 3 a list
    on: bool,
    cursor: bool,
    editing: bool,
    switch: bool, // a kind 1 row drawn as a switch
    role: int, // a plugin's role: 1 an instrument, 2 an effect, 3 the rest, 0 not a plugin (the value's color)
    off: bool, // a plugin switched off: faint
    failed: bool, // a plugin that failed and is silent: outlined in the danger color
}

export struct InfoLine {
    head: bool,
    text: string,
    role: int,
    off: bool,
    failed: bool,
}

export global PartState {
    in property <string> name;
    in property <string> title; // what the list is while it is not the settings
    in property <[SettingData]> rows;
    in property <[InfoLine]> info;
    in property <string> view;
    in property <string> message;
    // How many rows the screen holds: set by the screen.
    in-out property <int> rows-per-view: 1;
    // How many lines of the read-only panel fit, and whether more are out of view: set by the screen.
    in-out property <int> info-per-view: 1;
    in property <bool> info-more;
    callback resized(); // the views' sizes changed (the window, or the theme's paddings and type): shown again
    callback info-scroll(int); // a view up (-1) or down (1)
    callback tapped(int);
    callback step(int, int); // a row and -1 or 1
    callback back();
}

component Row inherits Section {
    in property <SettingData> data;
    callback tapped();
    callback step(int);
    // A switch (kind 1) is drawn as one, left of its value text's end; its parts' sizes.
    property <length> switch-width: 38px;
    property <length> switch-height: 24px;
    property <length> switch-room: 56px;
    property <length> buttons: data.kind == 0 ? 2 * Theme.touch + Theme.pad-tight : data.kind == 1 && data.switch ? root.switch-room : 0px;
    fill: data.editing ? Theme.accent.with-alpha(Theme.wash-light) : Theme.surface;
    opacity: data.off ? Theme.dim : 1;
    TouchArea {
        clicked => { root.tapped(); }
    }
    FitText {
        x: Theme.pad;
        width: parent.width * 0.4 - Theme.pad;
        height: parent.height;
        text: data.label;
        align: TextHorizontalAlignment.left;
    }
    FitText {
        x: parent.width * 0.4;
        width: parent.width * 0.6 - Theme.pad - root.buttons;
        height: parent.height;
        text: data.value;
        ink: data.editing || data.on ? Theme.accent : data.role == 1 ? Theme.accent : data.role == 2 ? Theme.positive : data.role == 3 ? Theme.wire-notes : Theme.text;
        bold: true;
        align: TextHorizontalAlignment.right;
    }
    if data.kind == 1 && data.switch: Rectangle {
        x: parent.width - root.switch-width - Theme.pad;
        y: (parent.height - root.switch-height) / 2;
        width: root.switch-width;
        height: root.switch-height;
        border-radius: self.height / 2;
        background: data.on ? Theme.accent : Theme.raised;
        Rectangle {
            property <length> inset: Theme.hair * 2;
            x: data.on ? parent.width - self.width - self.inset : self.inset;
            y: self.inset;
            width: parent.height - 2 * self.inset;
            height: self.width;
            border-radius: self.height / 2;
            background: data.on ? Theme.on-accent : Theme.muted;
        }
    }
    if data.kind == 0: Button {
        x: parent.width - 2 * Theme.touch - Theme.pad-tight;
        width: Theme.touch;
        height: parent.height;
        text: "−";
        clicked => { root.step(-1); }
    }
    if data.kind == 0: Button {
        x: parent.width - Theme.touch;
        width: Theme.touch;
        height: parent.height;
        text: "+";
        clicked => { root.step(1); }
    }
    if data.failed: Rectangle {
        border-width: Theme.cursor-width;
        border-color: Theme.danger;
        border-radius: Theme.section-radius;
    }
    Cursor {
        shown: data.cursor;
        editing: data.cursor && data.editing;
    }
}

export component Part inherits Rectangle {
    // The sections' gap (none in a theme whose sections join); the read-only panel's line gap.
    property <length> gap: Theme.gap-between(Theme.gap);
    property <length> header: Theme.touch;
    property <length> footer: Theme.touch;
    property <length> list-width: (self.width - 3 * Theme.margin) * 0.58;
    property <length> list-y: Theme.margin + header + Theme.gap;
    property <length> list-height: self.height - list-y - footer - Theme.margin - Theme.gap;
    property <int> per-view: max(1, floor((list-height + gap) / (Theme.touch + gap)));
    property <length> line: Theme.body + Theme.margin;
    property <int> info-lines: max(1, floor((list-height - 2 * Theme.pad-narrow) / line));
    changed per-view => { PartState.rows-per-view = per-view; PartState.resized(); }
    changed info-lines => { PartState.info-per-view = info-lines; PartState.resized(); }
    init => {
        PartState.rows-per-view = per-view;
        PartState.info-per-view = info-lines;
    }

    Button {
        x: Theme.margin;
        y: Theme.margin;
        width: Theme.button-width;
        height: root.header;
        text: "Back";
        clicked => { PartState.back(); }
    }
    Text {
        x: Theme.margin + Theme.button-width + 2 * Theme.gap;
        y: Theme.margin;
        width: root.width - Theme.button-width - 2 * Theme.margin - 2 * Theme.gap;
        height: root.header;
        text: PartState.title == "" ? PartState.name : PartState.name + " · " + PartState.title;
        color: Theme.text;
        font-size: Theme.title;
        font-weight: 700;
        overflow: elide;
        vertical-alignment: center;
    }
    for row[i] in PartState.rows: Row {
        x: Theme.margin;
        y: root.list-y + i * (Theme.touch + root.gap);
        width: root.list-width;
        height: Theme.touch;
        data: row;
        tapped => { PartState.tapped(i); }
        step(by) => { PartState.step(i, by); }
    }
    Section {
        x: 2 * Theme.margin + root.list-width;
        y: root.list-y;
        width: root.width - self.x - Theme.margin;
        height: root.list-height;
        clip: true;
        for line[i] in PartState.info: Text {
            x: Theme.pad;
            y: Theme.pad-narrow + i * root.line;
            width: parent.width - 2 * Theme.pad;
            text: line.text;
            opacity: line.off ? Theme.dim : 1;
            color: line.head ? Theme.muted : line.failed ? Theme.danger : line.role == 1 ? Theme.accent : line.role == 2 ? Theme.positive : line.role == 3 ? Theme.wire-notes : Theme.text;
            font-size: line.head ? Theme.small : Theme.body;
            font-weight: line.head ? 700 : 400;
            overflow: elide;
        }
        if PartState.info-more: Button {
            x: parent.width - 2 * Theme.touch - Theme.pad-narrow;
            y: parent.height - Theme.touch - Theme.pad-tight;
            width: Theme.touch;
            height: Theme.touch;
            text: "▲";
            clicked => { PartState.info-scroll(-1); }
        }
        if PartState.info-more: Button {
            x: parent.width - Theme.touch - Theme.pad-tight;
            y: parent.height - Theme.touch - Theme.pad-tight;
            width: Theme.touch;
            height: Theme.touch;
            text: "▼";
            clicked => { PartState.info-scroll(1); }
        }
    }
    Text {
        x: Theme.margin;
        y: root.height - Theme.margin - root.footer;
        width: root.width - 2 * Theme.margin;
        height: root.footer;
        vertical-alignment: center;
        overflow: elide;
        font-size: Theme.small;
        color: Theme.muted;
        text: PartState.message == "" ? PartState.view : PartState.message + "   " + PartState.view;
    }
}
