// The Part screen (src/part.rs), the JUCE Part page's settings for one part: a list of settings on
// the left (each its name and value; a cursor is a focus border, a value being changed with the
// dial an accent one), what the part is made of on the right, read only.

import { Theme, Section, Button, Cursor, FitText, RowMark, RowStyle } from "theme.slint";
import { KeyStrip, StripState } from "strip.slint";

export struct SettingData {
    label: string,
    value: string,
    kind: int, // 0 a value changed with the dial (and - +), 1 on or off, 2 an action, 3 a list
    on: bool,
    cursor: bool,
    editing: bool,
    switch: bool, // a kind 1 row drawn as a switch
    role: int, // a plugin's role: 1 an instrument, 2 an effect, 3 the rest, 0 not a plugin (the value's color)
    off: bool, // a plugin switched off: faint
    failed: bool, // a plugin that failed and is silent: outlined in the danger color
    tint: color, // an item's own color, where the theme puts it (drawListRow): the whole row or a mark in it
    tinted: bool,
    columns: [string], // a row in columns (the Catalog's: name, version, publisher, state and summary), each shrunk then cut on its own
}

export struct InfoLine {
    head: bool,
    text: string,
    role: int,
    off: bool,
    failed: bool,
    // A line of one of the chain's ends (In, Out): drawn on a raised box with the lines of its end, rounded at the first
    // and the last.
    boxed: bool,
    first: bool,
    last: bool,
}

export global PartState {
    in property <string> name;
    in property <string> title; // what the list is while it is not the settings
    in property <[SettingData]> rows;
    in property <[InfoLine]> info;
    in property <string> view;
    in property <string> message;
    // How many rows the screen holds: set by the screen.
    in-out property <int> rows-per-view: 1;
    // How many lines of the read-only panel fit, and whether more are out of view: set by the screen.
    in-out property <int> info-per-view: 1;
    in property <bool> info-more;
    callback resized(); // the views' sizes changed (the window, or the theme's paddings and type): shown again
    callback info-scroll(int); // a view up (-1) or down (1)
    callback tapped(int);
    callback step(int, int); // a row and -1 or 1
}

component Row inherits Section {
    in property <SettingData> data;
    callback tapped();
    callback step(int);
    // A switch (kind 1) is drawn as one, left of its value text's end; its parts' sizes.
    property <length> switch-width: 38px;
    property <length> switch-height: 24px;
    property <length> switch-room: 56px;
    property <length> buttons: data.kind == 0 ? 2 * Theme.touch + Theme.pad-tight : data.kind == 1 && data.switch ? root.switch-room : 0px;
    fill: data.editing ? Theme.accent.with-alpha(Theme.wash-light) : data.tinted && Theme.rows == RowStyle.fill ? Theme.row-fill(data.tint, Theme.surface, Theme.text, false) : Theme.surface;
    opacity: data.off ? Theme.dim : 1;
    RowMark {
        tint: data.tint;
        shown: data.tinted;
    }
    TouchArea {
        clicked => { root.tapped(); }
    }
    // The item's color mark takes room from the text beside it: at the left (and a dot) from the label, at the right
    // from the value, so the two never overlap.
    property <length> mark-room: data.tinted && Theme.rows != RowStyle.fill ? 2 * Theme.mark + Theme.pad-tight : 0px;
    property <length> label-room: Theme.rows == RowStyle.right ? 0px : root.mark-room;
    property <length> value-room: Theme.rows == RowStyle.right ? root.mark-room : 0px;
    // A row in columns: the widths are shares of what the gaps (the theme's padding) leave, the same in every row so they line up.
    property <bool> in-columns: data.columns.length == 4;
    property <length> col-gap: Theme.pad;
    property <length> col-room: root.width - 2 * Theme.pad - root.label-room - 3 * root.col-gap;
    property <[float]> col-share: [0.31, 0.13, 0.22, 0.34];
    for t[c] in data.columns: FitText {
        visible: root.in-columns;
        x: Theme.pad + root.label-room + (c > 0 ? root.col-share[0] * root.col-room + root.col-gap : 0px) + (c > 1 ? root.col-share[1] * root.col-room + root.col-gap : 0px) + (c > 2 ? root.col-share[2] * root.col-room + root.col-gap : 0px);
        width: root.col-share[c] * root.col-room;
        height: parent.height;
        text: t;
        ink: c == 1 ? Theme.muted : c == 3 ? Theme.muted : Theme.text;
        bold: c == 2;
        align: TextHorizontalAlignment.left;
    }
    if !root.in-columns: FitText {
        x: Theme.pad + root.label-room;
        width: parent.width * 0.4 - Theme.pad - root.label-room;
        height: parent.height;
        text: data.label;
        align: TextHorizontalAlignment.left;
    }
    if !root.in-columns: FitText {
        x: parent.width * 0.4 + Theme.pad;
        width: parent.width * 0.6 - 2 * Theme.pad - root.buttons - root.value-room;
        height: parent.height;
        text: data.value;
        ink: data.editing || data.on ? Theme.accent : data.role == 1 ? Theme.accent : data.role == 2 ? Theme.positive : data.role == 3 ? Theme.wire-notes : Theme.text;
        bold: true;
        align: TextHorizontalAlignment.right;
    }
    if data.kind == 1 && data.switch: Rectangle {
        x: parent.width - root.switch-width - Theme.pad;
        y: (parent.height - root.switch-height) / 2;
        width: root.switch-width;
        height: root.switch-height;
        border-radius: self.height / 2;
        background: data.on ? Theme.accent : Theme.raised;
        Rectangle {
            property <length> inset: Theme.hair * 2;
            x: data.on ? parent.width - self.width - self.inset : self.inset;
            y: self.inset;
            width: parent.height - 2 * self.inset;
            height: self.width;
            border-radius: self.height / 2;
            background: data.on ? Theme.on-accent : Theme.muted;
        }
    }
    if data.kind == 0: Button {
        x: parent.width - 2 * Theme.touch - Theme.pad-tight;
        width: Theme.touch;
        height: parent.height;
        text: "−";
        clicked => { root.step(-1); }
    }
    if data.kind == 0: Button {
        x: parent.width - Theme.touch;
        width: Theme.touch;
        height: parent.height;
        text: "+";
        clicked => { root.step(1); }
    }
    if data.failed: Rectangle {
        border-width: Theme.cursor-width;
        border-color: Theme.danger;
        border-radius: Theme.section-radius;
    }
    Cursor {
        shown: data.cursor;
        editing: data.cursor && data.editing;
    }
}

export component Part inherits Rectangle {
    // The sections' gap (none in a theme whose sections join); the read-only panel's line gap.
    property <length> gap: Theme.gap-between(Theme.gap);
    property <length> footer: Theme.touch;
    property <length> list-width: (self.width - 3 * Theme.margin) * 0.58;
    property <length> list-y: Theme.margin;
    property <length> list-height: self.height - list-y - footer - Theme.margin - Theme.gap;
    property <int> per-view: max(1, floor((list-height + gap) / (Theme.touch + gap)));
    property <length> line: Theme.body + Theme.margin;
    // A lane's key range as the strip over the keyboard, over the panel's lines.
    property <length> strip-height: StripState.shown ? Theme.body + Theme.pad-narrow + Theme.touch + Theme.pad : 0px;
    property <int> info-lines: max(1, floor((list-height - root.strip-height - 2 * Theme.pad-narrow) / line));
    changed per-view => { PartState.rows-per-view = per-view; PartState.resized(); }
    changed info-lines => { PartState.info-per-view = info-lines; PartState.resized(); }
    init => {
        PartState.rows-per-view = per-view;
        PartState.info-per-view = info-lines;
    }

    for row[i] in PartState.rows: Row {
        x: Theme.margin;
        y: root.list-y + i * (Theme.touch + root.gap);
        width: root.list-width;
        height: Theme.touch;
        data: row;
        tapped => { PartState.tapped(i); }
        step(by) => { PartState.step(i, by); }
    }
    Section {
        x: 2 * Theme.margin + root.list-width;
        y: root.list-y;
        width: root.width - self.x - Theme.margin;
        height: root.list-height;
        clip: true;
        if StripState.shown: KeyStrip {
            x: Theme.pad;
            y: Theme.pad-narrow;
            width: parent.width - 2 * Theme.pad;
            height: root.strip-height - Theme.pad;
        }
        for line[i] in PartState.info: Rectangle {
            x: Theme.pad-tight;
            y: Theme.pad-narrow + root.strip-height + i * root.line;
            width: parent.width - 2 * Theme.pad-tight;
            height: root.line;
            background: line.boxed ? Theme.raised : transparent;
            border-top-left-radius: line.first ? Theme.section-radius : 0px;
            border-top-right-radius: line.first ? Theme.section-radius : 0px;
            border-bottom-left-radius: line.last ? Theme.section-radius : 0px;
            border-bottom-right-radius: line.last ? Theme.section-radius : 0px;
        }
        for line[i] in PartState.info: FitText {
            x: Theme.pad;
            y: Theme.pad-narrow + root.strip-height + i * root.line;
            width: parent.width - 2 * Theme.pad;
            height: root.line;
            text: line.text;
            opacity: line.off ? Theme.dim : 1;
            ink: line.head ? Theme.muted : line.failed ? Theme.danger : line.role == 1 ? Theme.accent : line.role == 2 ? Theme.positive : line.role == 3 ? Theme.wire-notes : Theme.text;
            size: line.head ? Theme.small : Theme.body;
            bold: line.head;
            align: TextHorizontalAlignment.left;
        }
        if PartState.info-more: Button {
            x: parent.width - 2 * Theme.touch - Theme.pad-narrow;
            y: parent.height - Theme.touch - Theme.pad-tight;
            width: Theme.touch;
            height: Theme.touch;
            text: "▲";
            clicked => { PartState.info-scroll(-1); }
        }
        if PartState.info-more: Button {
            x: parent.width - Theme.touch - Theme.pad-tight;
            y: parent.height - Theme.touch - Theme.pad-tight;
            width: Theme.touch;
            height: Theme.touch;
            text: "▼";
            clicked => { PartState.info-scroll(1); }
        }
    }
    Text {
        x: Theme.margin;
        y: root.height - Theme.margin - root.footer;
        width: root.width - 2 * Theme.margin;
        height: root.footer;
        vertical-alignment: center;
        overflow: elide;
        font-size: Theme.small;
        color: Theme.muted;
        text: PartState.message == "" ? PartState.view : PartState.message + "   " + PartState.view;
    }
}
