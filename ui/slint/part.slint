// The Part screen (src/part.rs), the JUCE Part page's settings for one part: a list of settings on
// the left (each its name and value; a cursor is a focus border, a value being changed with the
// dial an accent one), what the part is made of on the right, read only.

import { Theme, Section, Button, Cursor, FitText, RowMark, RowStyle } from "theme.slint";
import { KeyStrip, StripState } from "strip.slint";
import { Loading } from "loading.slint";

export struct SettingData {
    label: string,
    value: string,
    kind: int, // 0 a value changed with the dial (and - +), 1 on or off, 2 an action, 3 a list
    on: bool,
    cursor: bool,
    editing: bool,
    switch: bool, // a kind 1 row drawn as a switch
    role: int, // a plugin's role: 1 an instrument, 2 an effect, 3 the rest, 0 not a plugin (the value's color)
    off: bool, // a plugin switched off: faint
    failed: bool, // a plugin that failed and is silent: outlined in the danger color
    busy: bool, // the engine is opening this item: a bar along the row's foot
    tint: color, // an item's own color, where the theme puts it (drawListRow): the whole row or a mark in it
    tinted: bool,
    detail: string, // a fluid row's description: the last of its parts to keep room
    warn: bool, // a trailing warning icon: the Performance does not fit this device (`reason` says why)
    star: bool, // a trailing star: a favorite
    reason: string,
    fluid: bool, // the row's name, value and detail share its width by priority: the name, then the value, then the detail
    columns: [string], // a row in columns (the Catalog's: name, version, publisher, state and summary), each shrunk then cut on its own
}

export struct InfoLine {
    head: bool,
    text: string,
    role: int,
    off: bool,
    failed: bool,
    // A line of one of the chain's ends (In, Out): drawn on a raised box with the lines of its end, rounded at the first
    // and the last.
    boxed: bool,
    first: bool,
    last: bool,
}

export global PartState {
    in property <string> name;
    in property <string> title; // what the list is while it is not the settings
    in property <[SettingData]> rows;
    in property <[InfoLine]> info;
    in property <string> view;
    in property <string> message;
    // The list's size and the first row shown, for its scroll bar (0: no bar); a drag or a tap on the bar asks for a row.
    in property <int> total;
    in property <int> first;
    callback scrolled(int);
    // How many rows the screen holds: set by the screen.
    in-out property <int> rows-per-view: 1;
    // The Library's rows closer: set by the Library (its choice, kept).
    in property <bool> compact;
    // How many lines of the read-only panel fit, and whether more are out of view: set by the screen.
    in-out property <int> info-per-view: 1;
    in property <bool> info-more;
    callback resized(); // the views' sizes changed (the window, or the theme's paddings and type): shown again
    callback info-scroll(int); // a view up (-1) or down (1)
    callback tapped(int);
    callback step(int, int); // a row and -1 or 1
}

export component Row inherits Section {
    in property <SettingData> data;
    divider: Theme.list-divider;
    border-radius: Theme.list-radius;
    callback tapped();
    callback step(int);
    // A finger drag on this row: once it passes the theme's drag threshold it is a scroll (`drag-move`,
    // the vertical offset since the press, anchored to the press so the list follows it), not a tap;
    // a press and a release within the threshold are a tap. The parent's `scrolled` is its own.
    callback drag-move(length);
    callback drag-end();
    property <length> press-y: 0px;
    property <bool> armed: false;
    property <bool> dragging: false;
    // A switch (kind 1) is drawn as one, left of its value text's end; its parts' sizes.
    property <length> switch-width: 38px;
    property <length> switch-height: 24px;
    property <length> switch-room: 56px;
    property <length> buttons: data.kind == 0 ? 2 * Theme.touch + Theme.pad-tight : data.kind == 1 && data.switch ? root.switch-room : 0px;
    fill: data.editing ? Theme.accent.with-alpha(Theme.wash-light) : data.tinted && Theme.rows == RowStyle.fill ? Theme.row-fill(data.tint, Theme.surface, Theme.text, false) : Theme.surface;
    opacity: data.off ? Theme.dim : 1;
    RowMark {
        tint: data.tint;
        shown: data.tinted;
    }
    TouchArea {
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.press-y = self.mouse-y;
                root.armed = true;
                root.dragging = false;
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                if (root.armed && !root.dragging && e.kind == PointerEventKind.up) {
                    root.tapped(); // a press and a release without a drag: a tap
                }
                root.armed = false;
                root.dragging = false;
                root.drag-end();
            }
        }
        moved => {
            if (root.armed && !root.dragging) {
                let dy = self.mouse-y - root.press-y;
                if (dy < -Theme.scroll-drag-threshold || dy > Theme.scroll-drag-threshold) {
                    root.dragging = true;
                }
            }
            if (root.dragging) {
                root.drag-move(self.mouse-y - root.press-y);
            }
        }
    }
    // The item's color mark takes room from the text beside it: at the left (and a dot) from the label, at the right
    // from the value, so the two never overlap.
    property <length> mark-room: data.tinted && Theme.rows != RowStyle.fill ? 2 * Theme.mark + Theme.pad-tight : 0px;
    property <length> label-room: Theme.rows == RowStyle.right ? 0px : root.mark-room;
    property <length> value-room: Theme.rows == RowStyle.right ? root.mark-room : 0px;
    // A row in columns: the widths are shares of what the gaps (the theme's padding) leave, the same in every row so they line up.
    property <bool> in-columns: data.columns.length == 4;
    property <length> col-gap: Theme.pad;
    property <length> col-room: root.width - 2 * Theme.pad - root.label-room - 3 * root.col-gap;
    property <[float]> col-share: [0.35, 0.10, 0.20, 0.35];
    for t[c] in data.columns: FitText {
        visible: root.in-columns;
        x: Theme.pad + root.label-room + (c > 0 ? root.col-share[0] * root.col-room + root.col-gap : 0px) + (c > 1 ? root.col-share[1] * root.col-room + root.col-gap : 0px) + (c > 2 ? root.col-share[2] * root.col-room + root.col-gap : 0px);
        width: root.col-share[c] * root.col-room;
        height: parent.height;
        text: t;
        ink: c == 1 ? Theme.muted : c == 3 ? Theme.muted : Theme.text;
        bold: c == 2;
        align: TextHorizontalAlignment.left;
    }
    // A fluid row: the name keeps what it needs (at its least, 70% of the type) before the value does, the value its natural
    // width before the detail gets any, and the detail what is left, if that is worth drawing.
    // The trailing icons of a fluid row, before the value: the warning, then the star at the end.
    property <length> mark-w: Theme.icon * 0.85;
    property <length> trail: (data.warn ? root.mark-w + Theme.pad-tight : 0px) + (data.star ? root.mark-w + Theme.pad-tight : 0px);
    accessible-role: list-item;
    accessible-label: data.label + (data.warn ? ", does not fit this device: " + data.reason : "") + (data.star ? ", favorite" : "");
    property <length> room: root.width - 2 * Theme.pad - root.label-room - root.value-room - root.buttons - root.trail;
    property <length> name-need: name-measure.preferred-width;
    property <length> value-need: value-measure.preferred-width;
    property <length> name-room: root.data.fluid ? min(root.name-need, max(root.room - root.value-need - Theme.pad, root.name-need * 0.7), root.room - min(root.value-need, root.room * 0.25) - Theme.pad) : root.width * 0.4 - Theme.pad - root.label-room;
    property <length> value-room-fluid: min(root.value-need, max(0px, root.room - root.name-room - Theme.pad));
    property <length> detail-room: root.room - root.name-room - root.value-room-fluid - 2 * Theme.pad;
    name-measure := Text {
        visible: false;
        font-size: Theme.body;
        text: root.data.label;
    }
    value-measure := Text {
        visible: false;
        font-size: Theme.body;
        font-weight: 700;
        text: root.data.value;
    }
    if !root.in-columns: FitText {
        x: Theme.pad + root.label-room;
        width: root.name-room;
        height: parent.height;
        text: data.label;
        align: TextHorizontalAlignment.left;
    }
    if !root.in-columns && root.data.fluid && root.data.detail != "" && root.detail-room >= 6 * Theme.small: Text {
        x: Theme.pad + root.label-room + root.name-room + Theme.pad;
        width: root.detail-room;
        height: parent.height;
        vertical-alignment: center;
        overflow: elide;
        font-size: Theme.small;
        color: Theme.muted;
        text: root.data.detail;
    }
    if !root.in-columns: FitText {
        x: root.data.fluid ? parent.width - Theme.pad - root.value-room - root.buttons - root.trail - root.value-room-fluid : parent.width * 0.4 + Theme.pad;
        width: root.data.fluid ? root.value-room-fluid : parent.width * 0.6 - 2 * Theme.pad - root.buttons - root.value-room;
        height: parent.height;
        text: data.value;
        ink: data.editing || data.on ? Theme.accent : data.role == 1 ? Theme.accent : data.role == 2 ? Theme.positive : data.role == 3 ? Theme.wire-notes : Theme.text;
        bold: true;
        align: TextHorizontalAlignment.right;
    }
    if data.star: Text {
        x: parent.width - Theme.pad - root.mark-w;
        width: root.mark-w;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: Theme.body;
        color: Theme.text;
        text: "★";
    }
    if data.warn: Image {
        x: parent.width - Theme.pad - root.mark-w - (data.star ? root.mark-w + Theme.pad-tight : 0px);
        y: (parent.height - self.height) / 2;
        width: root.mark-w;
        height: root.mark-w;
        source: @image-url("icons/triangle-alert.svg");
        colorize: Theme.warning;
    }
    if data.kind == 1 && data.switch: Rectangle {
        x: parent.width - root.switch-width - Theme.pad;
        y: (parent.height - root.switch-height) / 2;
        width: root.switch-width;
        height: root.switch-height;
        border-radius: self.height / 2;
        background: data.on ? Theme.accent : Theme.raised;
        Rectangle {
            property <length> inset: Theme.hair * 2;
            x: data.on ? parent.width - self.width - self.inset : self.inset;
            y: self.inset;
            width: parent.height - 2 * self.inset;
            height: self.width;
            border-radius: self.height / 2;
            background: data.on ? Theme.on-accent : Theme.muted;
        }
    }
    if data.kind == 0: Button {
        x: parent.width - 2 * Theme.touch - Theme.pad-tight;
        width: Theme.touch;
        height: parent.height;
        text: "−";
        clicked => { root.step(-1); }
    }
    if data.kind == 0: Button {
        x: parent.width - Theme.touch;
        width: Theme.touch;
        height: parent.height;
        text: "+";
        clicked => { root.step(1); }
    }
    if data.busy: Loading {
        x: Theme.pad-wide;
        y: parent.height - self.height - Theme.hair - Theme.cursor-width;
        width: parent.width - 2 * Theme.pad-wide;
    }
    if data.failed: Rectangle {
        border-width: Theme.cursor-width;
        border-color: Theme.danger;
        border-radius: Theme.section-radius;
    }
    Cursor {
        shown: data.cursor;
        editing: data.cursor && data.editing;
    }
}

// A list's scroll bar, a touch aid: a thin bar in a lane wider than it (the touch target), its thumb the view's share of the
// list (never shorter than `Theme.scroll-thumb-min`) at the view's place. A tap on the track or a drag asks for the view at
// that place (`scrolled`, a whole view's first row); it is not a cursor stop and draws nothing while the list fits.
export component ScrollBar inherits Rectangle {
    in property <int> total;
    in property <int> first;
    in property <int> per-view;
    callback scrolled(int);
    out property <length> thumb-h: min(root.height, max(Theme.scroll-thumb-min, root.height * root.per-view / max(1, root.total)));
    out property <length> thumb-y: (root.height - root.thumb-h) * min(1.0, root.first / max(1, root.total - root.per-view));
    function seek(y: length) {
        let f = min(1.0, max(0.0, (y - root.thumb-h / 2) / max(1px, root.height - root.thumb-h)));
        let page = floor(round(f * (root.total - root.per-view)) / root.per-view) * root.per-view;
        if (page != root.first) {
            root.scrolled(page);
        }
    }
    Rectangle {
        x: Theme.scroll-lead;
        width: Theme.scroll-bar;
        border-radius: Theme.scaled-radius(self.width);
        background: Theme.track;
        Rectangle {
            y: root.thumb-y;
            height: root.thumb-h;
            border-radius: parent.border-radius;
            background: Theme.muted;
        }
    }
    TouchArea {
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.seek(self.mouse-y);
            }
        }
        moved => {
            if (self.pressed) {
                root.seek(self.mouse-y);
            }
        }
    }
}

export component Part inherits Rectangle {
    // The list takes the whole width and the read-only panel is not drawn (the Library puts its sidebar or panel at the left).
    in property <bool> list-only;
    // The sections' gap (none in a theme whose sections join); the read-only panel's line gap.
    // The Library's list may be compact (its rows' gap and the footer line, ui/LIBRARY-APP.md); the other screens' never are.
    property <bool> dense: root.list-only && PartState.compact;
    property <length> gap: Theme.dense(Theme.list-gap, root.dense);
    property <length> footer: Theme.footer(root.dense);
    property <length> list-width: root.list-only ? self.width - 2 * Theme.margin : (self.width - 3 * Theme.margin) * 0.58;
    property <length> list-y: Theme.margin;
    out property <length> list-height: self.height - list-y - footer - Theme.margin - Theme.gap;
    property <int> per-view: max(1, floor((list-height + gap) / (Theme.touch + gap)));
    // A finger drag on a row scrolls the list: the anchor (the state the drag began at) and the row pitch it follows.
    property <bool> dz-on: false;
    property <int> dz-first0: 0;
    property <length> dz-y0: 0px;
    property <length> dz-pitch: Theme.touch + root.gap;
    function dz-move(dy: length) {
        if (!root.dz-on) { root.dz-on = true; root.dz-first0 = PartState.first; root.dz-y0 = dy; }
        let up = round((root.dz-y0 - dy) / root.dz-pitch);
        let target = max(0, min(root.dz-first0 + up, PartState.total - 1));
        if (target != PartState.first) { PartState.scrolled(target); }
    }
    function dz-end() {
        root.dz-on = false;
    }
    // The scroll bar, when the list is longer than the view: its own lane at the list's right edge, the rows narrower by it.
    property <bool> long: PartState.total > root.per-view;
    property <length> lane: root.long ? Theme.scroll-lane : 0px;
    out property <length> thumb-h: bar.thumb-h;
    out property <length> thumb-y: bar.thumb-y;
    out property <length> lane-x: root.list-width - root.lane + Theme.margin;
    property <length> line: Theme.body + Theme.margin;
    // A lane's key range as the strip over the keyboard, over the panel's lines.
    property <length> strip-height: StripState.shown ? Theme.body + Theme.pad-narrow + Theme.touch + Theme.pad : 0px;
    property <int> info-lines: max(1, floor((list-height - root.strip-height - 2 * Theme.pad-narrow) / line));
    changed per-view => { PartState.rows-per-view = per-view; PartState.resized(); }
    changed info-lines => { PartState.info-per-view = info-lines; PartState.resized(); }
    init => {
        PartState.rows-per-view = per-view;
        PartState.info-per-view = info-lines;
    }

    for row[i] in PartState.rows: Row {
        x: Theme.margin;
        y: root.list-y + i * (Theme.touch + root.gap);
        width: root.list-width - root.lane + (root.long ? Theme.scroll-overlap : 0px);
        height: Theme.touch;
        data: row;
        tapped => { PartState.tapped(i); }
        step(by) => { PartState.step(i, by); }
        drag-move(dy) => { root.dz-move(dy); }
        drag-end() => { root.dz-end(); }
    }
    bar := ScrollBar {
        visible: root.long;
        x: root.lane-x;
        y: root.list-y;
        width: Theme.scroll-lane;
        height: root.list-height;
        total: PartState.total;
        first: PartState.first;
        per-view: root.per-view;
        scrolled(page) => { PartState.scrolled(page); }
    }
    Section {
        visible: !root.list-only;
        x: 2 * Theme.margin + root.list-width;
        y: root.list-y;
        width: root.width - self.x - Theme.margin;
        height: root.list-height;
        clip: true;
        if StripState.shown: KeyStrip {
            x: Theme.pad;
            y: Theme.pad-narrow;
            width: parent.width - 2 * Theme.pad;
            height: root.strip-height - Theme.pad;
        }
        for line[i] in PartState.info: Rectangle {
            x: Theme.pad-tight;
            y: Theme.pad-narrow + root.strip-height + i * root.line;
            width: parent.width - 2 * Theme.pad-tight;
            height: root.line;
            background: line.boxed ? Theme.raised : transparent;
            border-top-left-radius: line.first ? Theme.section-radius : 0px;
            border-top-right-radius: line.first ? Theme.section-radius : 0px;
            border-bottom-left-radius: line.last ? Theme.section-radius : 0px;
            border-bottom-right-radius: line.last ? Theme.section-radius : 0px;
        }
        for line[i] in PartState.info: FitText {
            x: Theme.pad;
            y: Theme.pad-narrow + root.strip-height + i * root.line;
            width: parent.width - 2 * Theme.pad;
            height: root.line;
            text: line.text;
            opacity: line.off ? Theme.dim : 1;
            ink: line.head ? Theme.muted : line.failed ? Theme.danger : line.role == 1 ? Theme.accent : line.role == 2 ? Theme.positive : line.role == 3 ? Theme.wire-notes : Theme.text;
            size: line.head ? Theme.small : Theme.body;
            bold: line.head;
            align: TextHorizontalAlignment.left;
        }
        if PartState.info-more: Button {
            x: parent.width - 2 * Theme.touch - Theme.pad-narrow;
            y: parent.height - Theme.touch - Theme.pad-tight;
            width: Theme.touch;
            height: Theme.touch;
            text: "▲";
            clicked => { PartState.info-scroll(-1); }
        }
        if PartState.info-more: Button {
            x: parent.width - Theme.touch - Theme.pad-tight;
            y: parent.height - Theme.touch - Theme.pad-tight;
            width: Theme.touch;
            height: Theme.touch;
            text: "▼";
            clicked => { PartState.info-scroll(1); }
        }
    }
    Text {
        x: Theme.margin;
        y: root.height - Theme.margin - root.footer;
        width: root.width - 2 * Theme.margin;
        height: root.footer;
        vertical-alignment: center;
        overflow: elide;
        font-size: Theme.small;
        color: Theme.muted;
        text: PartState.message == "" ? PartState.view : PartState.message + "   " + PartState.view;
    }
}
