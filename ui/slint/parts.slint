// The Parts list (src/parts.rs), the JUCE Edit view's page 0 (hosts/standalone/PartsView.cpp): a row
// per part, then the shared buses and the plugins several parts are wired into, each with its name
// and sound, where it plays from, its chain, a level, a mute and a send per bus; under them the
// buttons that add a part or a bus and go to the Mixer, Controls and Routing. A cursor is a focus
// border round a cell of a row (the part, its level, its mute, a send) or a button; the dial moves
// along the cells, a press does what a tap does, a level being changed takes the accent border.
// How many rows a view holds is not counted here: the screen reads the sizes below and fills the
// height, so the window, the theme's spacing and the type scale all reflow it.

import { Theme, Section, Button, Cursor, Mark, SliderBar } from "theme.slint";

export struct PartRowData {
    kind: int, // 0 a part, 1 a bus, 2 a node several parts are wired into in Routing
    heading: bool, // "Shared buses" above this row
    number: string,
    name: string,
    sound: string,
    given: string, // notes the shared budget took from it
    chain-text: string, // the plugins in order, or what an empty chain says
    chain-empty: bool,
    input: string,
    keys: bool, // the key range is drawn under the input
    key-low: float,
    key-high: float,
    level: float,
    mute: bool,
    dim: bool, // muted, or silenced by another part's solo
    draining: bool,
    fed: string, // a shared row's second line
    cell: int, // the cell the cursor is on: 0 the part, 1 level, 2 mute, 3 and on the sends; -1 none
    editing: bool, // the dial changes the level or the send under the cursor
}

export struct ChipData {
    row: int, // the row of the view
    slot: int,
    count: int,
    name: string,
    role: int, // 0 notes and the like, 1 an instrument, 2 an effect
    off: bool,
    failed: bool,
}

export struct SendData {
    row: int,
    slot: int,
    level: float,
    cursor: bool,
    editing: bool,
}

export struct ToolData {
    label: string,
    enabled: bool,
    cursor: bool,
}

export global PartsState {
    in property <string> title;
    in property <[PartRowData]> rows;
    in property <[ChipData]> chips;
    in property <[SendData]> sends;
    in property <[string]> bus-names;
    in property <[ToolData]> tools;
    in property <bool> empty;
    in property <string> view;
    in property <string> message;
    // What the screen needs to fill the height with rows: set by the screen's component.
    in-out property <length> area-height: 0px;
    in-out property <length> row-pitch: 1px;
    in-out property <length> heading-pitch: 0px;
    in-out property <length> slack: 0px; // the gap that a view's last row needs no room for
    callback resized();
    callback back();
    callback open(int); // a row's part
    callback level(int, float); // a row, the slider's new place
    callback send(int, int, float); // a row, the send's place in it, the slider's new place
    callback held(int, int, bool); // a row, its cell, a finger on the slider or off it
    callback mute(int);
    callback tool(int);
}

// Where the cells of a row stand, by its width and the number of buses: the same for every row and
// for the column titles above them. Controls take at most a part of the width, their sliders
// shrinking to it; what is left is the part's, wide enough for its input and chain to have columns.
component Cells inherits Rectangle {
    in property <length> total;
    in property <int> buses;
    in property <bool> shared;
    property <length> pad: Theme.pad-narrow;
    property <length> level-ideal: 140px;
    property <length> send-ideal: 100px;
    out property <length> number-w: Theme.body * 1.6;
    property <length> ideal: level-ideal + Theme.touch + buses * send-ideal;
    out property <length> controls-w: shared ? 0px : min(ideal, total * 0.6);
    property <float> k: max(0.2, (controls-w - Theme.touch) / max(1px, ideal - Theme.touch));
    out property <length> controls-x: total - pad - controls-w;
    out property <length> level-x: controls-x;
    out property <length> level-w: level-ideal * k;
    out property <length> mute-x: level-x + level-w;
    out property <length> send-w: send-ideal * k;
    out property <length> sends-x: mute-x + Theme.touch + Theme.gap;
    out property <length> info-x: pad + number-w;
    out property <length> info-w: (shared ? total - pad : controls-x - Theme.gap) - info-x;
    out property <bool> wide: info-w >= 520px * Theme.font-scale;
    out property <length> name-w: wide ? info-w * 0.28 : info-w;
    out property <length> from-x: info-x + name-w + Theme.gap;
    out property <length> from-w: wide ? info-w * 0.26 : 0px;
    out property <length> chain-x: from-x + from-w + Theme.gap;
    out property <length> chain-w: wide ? info-w - name-w - from-w - 2 * Theme.gap : 0px;
}

// A plugin of the chain: its name in a box outlined by its role (an instrument, an effect, notes
// and the rest), faint when switched off, the danger color when it failed and is silent.
component Chip inherits Rectangle {
    in property <ChipData> data;
    opacity: data.off ? Theme.dim : 1;
    border-radius: Theme.radius;
    background: Theme.raised;
    border-width: data.failed ? Theme.cursor-width : Theme.hair;
    border-color: data.failed ? Theme.danger : data.role == 1 ? Theme.accent : data.role == 2 ? Theme.positive : Theme.wire-notes;
    Text {
        x: Theme.pad-tight;
        width: parent.width - 2 * Theme.pad-tight;
        height: parent.height;
        text: data.name;
        color: Theme.text;
        font-size: Theme.small;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A slider that follows a level: dragged or tapped it says where, a finger on it or off it is told.
component Level inherits Rectangle {
    in property <float> norm;
    in property <bool> cursor;
    in property <bool> editing;
    callback moved(float);
    callback held(bool);
    SliderBar {
        x: Theme.thumb / 2;
        width: parent.width - Theme.thumb;
        height: parent.height;
        norm: root.norm;
        lit: root.cursor;
    }
    touch := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.held(true); }
            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { root.held(false); }
        }
        moved => { root.moved(max(0, min(1, (touch.mouse-x - Theme.thumb / 2) / (root.width - Theme.thumb)))); }
        clicked => { root.moved(max(0, min(1, (touch.mouse-x - Theme.thumb / 2) / (root.width - Theme.thumb)))); }
    }
    Cursor {
        shown: root.cursor;
        editing: root.editing;
    }
}

component PartRow inherits Section {
    in property <PartRowData> data;
    in property <int> index;
    in property <int> buses;
    in property <[ChipData]> chips;
    in property <[SendData]> sends;
    callback open();
    callback level(float);
    callback send(int, float);
    callback held(int, bool);
    callback mute();
    cells := Cells {
        total: root.width;
        buses: root.buses;
        shared: data.kind == 2;
    }
    property <length> bar: Theme.pad-tight * 1.5;
    fill: data.dim ? Theme.surface.mix(Theme.background, 0.5) : Theme.surface;
    if data.draining || data.mute: Rectangle {
        border-radius: Theme.section-radius;
        background: (data.draining ? Theme.accent : Theme.danger).with-alpha(Theme.wash-light);
    }
    TouchArea {
        width: cells.info-x + cells.info-w + Theme.gap;
        clicked => { root.open(); }
    }
    Text {
        x: Theme.pad-narrow;
        width: cells.number-w;
        height: parent.height;
        text: data.number;
        color: Theme.muted;
        font-size: Theme.body;
        vertical-alignment: center;
    }
    if data.kind != 2: VerticalLayout {
        x: cells.info-x;
        width: cells.name-w;
        height: parent.height;
        alignment: center;
        Text {
            text: data.name;
            color: Theme.text;
            font-size: Theme.body;
            font-weight: 700;
            overflow: elide;
        }
        Text {
            text: cells.wide ? data.sound + data.given : data.chain-text + data.given + " · " + data.input;
            color: Theme.muted;
            font-size: Theme.small;
            overflow: elide;
        }
    }
    if data.kind == 2: VerticalLayout {
        x: cells.info-x;
        width: cells.info-w;
        height: parent.height;
        alignment: center;
        Text {
            text: data.name;
            color: Theme.text;
            font-size: Theme.body;
            font-weight: 700;
            overflow: elide;
        }
        Text {
            text: data.fed;
            color: Theme.muted;
            font-size: Theme.small;
            overflow: elide;
        }
    }
    if data.kind != 2 && cells.wide: VerticalLayout {
        x: cells.from-x;
        width: cells.from-w;
        height: parent.height;
        alignment: center;
        spacing: Theme.pad-tight;
        Text {
            text: data.input;
            color: Theme.text;
            font-size: Theme.small;
            overflow: elide;
        }
        if data.keys: Rectangle {
            height: root.bar;
            border-radius: self.height / 2;
            background: Theme.raised;
            Rectangle {
                x: parent.width * data.key-low;
                width: max(parent.width * (data.key-high - data.key-low), 2 * Theme.hair);
                border-radius: self.height / 2;
                background: Theme.accent-dim;
            }
        }
    }
    if data.kind != 2 && cells.wide && data.chain-empty: Text {
        x: cells.chain-x;
        width: cells.chain-w;
        height: parent.height;
        text: data.chain-text;
        color: Theme.muted;
        font-size: Theme.small;
        overflow: elide;
        vertical-alignment: center;
    }
    if data.kind != 2 && cells.wide: Rectangle {
        x: cells.chain-x;
        width: cells.chain-w;
        height: parent.height;
        clip: true;
        for chip in root.chips: Chip {
            property <length> pitch: min(150px, max(60px, cells.chain-w / max(1, chip.count)));
            visible: chip.row == root.index;
            x: chip.slot * self.pitch;
            y: Theme.pad-narrow;
            width: self.pitch - Theme.pad-tight;
            height: parent.height - 2 * Theme.pad-narrow;
            data: chip;
        }
    }
    if data.kind != 2: Level {
        x: cells.level-x;
        y: (parent.height - Theme.touch) / 2;
        width: cells.level-w - Theme.gap;
        height: Theme.touch;
        norm: data.level;
        cursor: data.cell == 1;
        editing: data.cell == 1 && data.editing;
        moved(f) => { root.level(f); }
        held(down) => { root.held(1, down); }
    }
    if data.kind != 2: Mark {
        x: cells.mute-x + (Theme.touch - self.width) / 2;
        y: (parent.height - Theme.touch) / 2;
        width: Theme.touch;
        height: Theme.touch;
        letter: "M";
        tint: Theme.danger;
        on: data.mute;
        clicked => { root.mute(); }
    }
    if data.kind != 2: Cursor {
        x: cells.mute-x;
        y: (parent.height - Theme.touch) / 2;
        width: Theme.touch;
        height: Theme.touch;
        shown: data.cell == 2;
    }
    for send in root.sends: Level {
        visible: send.row == root.index;
        x: cells.sends-x + send.slot * cells.send-w;
        y: (parent.height - Theme.touch) / 2;
        width: cells.send-w - Theme.gap;
        height: Theme.touch;
        norm: send.level;
        cursor: send.cursor;
        editing: send.editing;
        moved(f) => { root.send(send.slot, f); }
        held(down) => { root.held(3 + send.slot, down); }
    }
    if data.kind == 2: Cursor {
        shown: data.cell == 0;
    }
    if data.kind != 2: Cursor {
        x: Theme.pad-tight;
        y: Theme.pad-tight;
        width: cells.info-x + cells.info-w - Theme.pad-tight;
        height: parent.height - 2 * Theme.pad-tight;
        shown: data.cell == 0;
    }
}

// The column titles over the rows, in the rows' own columns.
component Titles inherits Rectangle {
    in property <int> buses;
    cells := Cells {
        total: root.width;
        buses: root.buses;
    }
    property <length> size: Theme.small;
    Text {
        x: cells.info-x;
        width: cells.name-w;
        height: parent.height;
        text: "Part";
        color: Theme.muted;
        font-size: root.size;
        vertical-alignment: center;
    }
    if cells.wide: Text {
        x: cells.from-x;
        width: cells.from-w;
        height: parent.height;
        text: "Plays from";
        color: Theme.muted;
        font-size: root.size;
        vertical-alignment: center;
    }
    if cells.wide: Text {
        x: cells.chain-x;
        width: cells.chain-w;
        height: parent.height;
        text: "Chain";
        color: Theme.muted;
        font-size: root.size;
        vertical-alignment: center;
    }
    Text {
        x: cells.level-x;
        width: cells.level-w - Theme.gap;
        height: parent.height;
        text: "Level";
        color: Theme.muted;
        font-size: root.size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        x: cells.mute-x;
        width: Theme.touch;
        height: parent.height;
        text: "Mute";
        color: Theme.muted;
        font-size: root.size;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    for name[i] in PartsState.bus-names: Text {
        x: cells.sends-x + i * cells.send-w;
        width: cells.send-w - Theme.gap;
        height: parent.height;
        text: cells.send-w >= 90px * Theme.font-scale ? "Send " + name : name;
        color: Theme.muted;
        font-size: root.size;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component Parts inherits Rectangle {
    // The sections' gap (none in a theme whose sections join).
    property <length> gap: Theme.gap-between(Theme.gap);
    property <length> header: Theme.touch;
    property <length> titles-height: Theme.small + Theme.pad-narrow;
    property <length> row-height: Theme.touch + 2 * Theme.pad-tight;
    property <length> heading-height: Theme.small + Theme.pad-narrow;
    property <length> footer: Theme.small + 2 * Theme.pad-tight;
    // The buttons under the list wrap onto more lines when they do not fit one.
    property <int> tools: PartsState.tools.length;
    property <int> across: max(1, min(tools, floor((self.width - 2 * Theme.margin + Theme.gap) / (Theme.button-width + Theme.gap))));
    property <int> lines: tools == 0 ? 0 : ceil(tools / across);
    property <length> tool-width: (self.width - 2 * Theme.margin - (across - 1) * Theme.gap) / across;
    property <length> tools-height: lines * Theme.touch + max(0, lines - 1) * Theme.gap;
    property <length> titles-y: Theme.margin + header + Theme.gap;
    property <length> list-y: titles-y + titles-height + Theme.gap;
    property <length> tools-y: self.height - Theme.margin - footer - Theme.gap - tools-height;
    property <length> list-height: max(0px, tools-y - Theme.gap - list-y);
    property <int> buses: PartsState.bus-names.length;
    changed list-height => { PartsState.area-height = list-height; PartsState.resized(); }
    changed row-height => { PartsState.row-pitch = row-height + gap; PartsState.slack = gap; PartsState.resized(); }
    changed heading-height => { PartsState.heading-pitch = heading-height + gap; PartsState.resized(); }
    changed gap => { PartsState.row-pitch = row-height + gap; PartsState.heading-pitch = heading-height + gap; PartsState.slack = gap; PartsState.resized(); }
    init => {
        PartsState.area-height = list-height;
        PartsState.row-pitch = row-height + gap;
        PartsState.heading-pitch = heading-height + gap;
        PartsState.slack = gap;
    }

    Button {
        x: Theme.margin;
        y: Theme.margin;
        width: Theme.button-width;
        height: root.header;
        text: "Back";
        clicked => { PartsState.back(); }
    }
    Text {
        x: Theme.margin + Theme.button-width + 2 * Theme.gap;
        y: Theme.margin;
        width: root.width - Theme.button-width - 2 * Theme.margin - 2 * Theme.gap;
        height: root.header;
        text: PartsState.title;
        color: Theme.text;
        font-size: Theme.title;
        font-weight: 700;
        overflow: elide;
        vertical-alignment: center;
    }
    if !PartsState.empty: Titles {
        x: Theme.margin;
        y: root.titles-y;
        width: root.width - 2 * Theme.margin;
        height: root.titles-height;
        buses: root.buses;
    }
    VerticalLayout {
        x: Theme.margin;
        y: root.list-y;
        width: root.width - 2 * Theme.margin;
        height: root.list-height;
        spacing: root.gap;
        alignment: start;
        for row[i] in PartsState.rows: VerticalLayout {
            spacing: root.gap;
            if row.heading: Text {
                height: root.heading-height;
                text: "Shared buses";
                color: Theme.muted;
                font-size: Theme.small;
                font-weight: 700;
                vertical-alignment: bottom;
            }
            PartRow {
                height: root.row-height;
                data: row;
                index: i;
                buses: root.buses;
                chips: PartsState.chips;
                sends: PartsState.sends;
                open => { PartsState.open(i); }
                level(f) => { PartsState.level(i, f); }
                send(k, f) => { PartsState.send(i, k, f); }
                held(cell, down) => { PartsState.held(i, cell, down); }
                mute => { PartsState.mute(i); }
            }
        }
    }
    if PartsState.empty: Text {
        x: Theme.margin;
        y: root.list-y;
        width: root.width - 2 * Theme.margin;
        height: root.list-height;
        text: "No parts yet. Add a part: it listens to the keyboard and plays to Main.";
        color: Theme.muted;
        font-size: Theme.body;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    for tool[i] in PartsState.tools: Rectangle {
        x: Theme.margin + mod(i, root.across) * (root.tool-width + Theme.gap);
        y: root.tools-y + floor(i / root.across) * (Theme.touch + Theme.gap);
        width: root.tool-width;
        height: Theme.touch;
        Button {
            enabled: tool.enabled;
            text: tool.label;
            clicked => { PartsState.tool(i); }
        }
        Cursor {
            shown: tool.cursor;
            corner: Theme.button-radius(Theme.touch);
        }
    }
    Text {
        x: Theme.margin;
        y: root.height - Theme.margin - root.footer;
        width: root.width - 2 * Theme.margin;
        height: root.footer;
        vertical-alignment: center;
        overflow: elide;
        font-size: Theme.small;
        color: Theme.muted;
        text: PartsState.message == "" ? PartsState.view : PartsState.message + "   " + PartsState.view;
    }
}
