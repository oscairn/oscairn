// SPDX-License-Identifier: AGPL-3.0-or-later
// The Play screen (src/play.rs), the JUCE Performance app's first view (hosts/standalone/PlayView.cpp)
// for the stage: the Performance's scenes along the top (Previous and Next at the ends when it came
// from the setlist), a strip per part and bus below (name and sound, level fader, a meter per
// channel, mute and solo), the master pinned at the right. A cursor is a focus border; the scene
// playing is an accent fill and edge. Colors, corners, edges, sliders and marks are the theme's.

import { Theme, Section, Button, Cursor, Mark, SliderBar, SectionStyle, FitText } from "theme.slint";
import { TileRow, GridTile } from "grid.slint";

export struct SceneData {
    number: int,
    name: string,
    filled: bool,
    add: bool, // the "+ Scene" tile after the last scene
    on: bool,
    cursor: bool,
}

export struct StripData {
    name: string,
    detail: string,
    fraction: float, // the fader's place, 0..1 (the level through the JUCE faders' skew)
    mute: bool,
    solo: bool,
    dim: bool, // muted, or silenced by another part's solo
    cursor: bool,
    editing: bool, // the dial changes its fader (the master's)
    mark-cursor: bool, // Learn: the cursor is on its M, not the strip
    channels: int, // meter bars: 0 none (the master), 1 or 2
    peak-a: float, // each 0..1 along -60..+6 dB
    peak-b: float,
}

// A button of the knob row's header: what the knobs follow (the Performance's controls, the selected part's own) and the bank.
export struct KnobButton {
    text: string,
    on: bool,
    cursor: bool,
    bank: bool, // the bank button, not one of the two that choose what the knobs follow
}

// Where Play puts its areas, in the screen's own pixels: published by the screen so the tests can check what each is given.
export struct PlayLayout {
    width: length,
    height: length,
    scene-width: length,
    scenes-height: length,
    hint-y: length,
    hint-height: length,
    knobs-y: length,
    knob-height: length,
    banner-y: length,
    banner-height: length,
    strips-y: length,
    strips-height: length,
    fader-travel: length, // the part strips' faders' travel
    footer-y: length,
    footer-height: length,
}

export global PlayState {
    in property <[SceneData]> scenes;
    in property <[StripData]> strips;
    in property <StripData> master;
    in property <bool> has-master;
    in property <bool> can-step; // the Performance is the setlist's: Previous and Next
    in property <string> view; // which parts show: "1–5 of 9"
    in property <string> message;
    in property <bool> hint; // no MIDI device: the line offering the on-screen keyboard
    in property <int> hint-cursor: -1; // which of its two links has the cursor
    // The knob row (src/row.rs): a tile for each knob under the device's screen, the bank's name and the buttons above it.
    in property <bool> has-knobs;
    in property <string> knob-bank;
    in property <[GridTile]> knobs;
    in property <[KnobButton]> knob-buttons;
    in property <length> knob-tile: 120px; // the grid's knob tile height (grid::KNOB_ROW)
    in-out property <length> knob-width: 300px; // the row's area, set by the screen: what the tiles are laid out for
    in-out property <length> knob-height: 120px;
    callback knob-grab(int, int); // a tile and its part: a drag begins
    callback knob-drag(int, int, float); // a tile, its part and the value from 0 to 1
    callback knob-release(int);
    callback knob-tap(int, int);
    callback knob-button(int);
    callback knob-resized(); // the row's area changed size: its tiles are laid out again
    // Learn: what to do next over the strips, with Default and Done.
    in property <bool> learning;
    in property <string> learn-text;
    in property <bool> learn-reset-shown;
    in property <bool> learn-reset-cursor;
    in property <bool> learn-done-cursor;
    callback learn-reset();
    callback learn-done();
    callback hint-keys();
    callback hint-dismiss();
    // How many part strips the screen holds besides the master: set by the screen.
    in-out property <int> strips-per-view: 1;
    callback resized(); // the strips' count changed (the window, or the theme's paddings): shown again
    callback scene-tapped(int);
    callback part-tapped(int); // a strip's name: select the part
    callback mute-tapped(int);
    callback solo-tapped(int);
    callback level(int, float); // a strip's row (-1 the master) and the fader's new place
    callback held(int, bool); // a finger on a fader or off it
    callback step(int);
    in-out property <PlayLayout> layout;
    callback scene-fit(int, bool); // a scene tile's name does not fit it (cut after shrinking to 70%), or fits
}

component Meter inherits Rectangle {
    in property <float> value;
    // -12 dB and -3 dB on the -60..+6 dB scale (the JUCE meters'): where the zones turn yellow and red.
    property <float> yellow: 0.7273;
    property <float> red: 0.8636;
    background: Theme.track;
    border-radius: self.width / 2;
    clip: true;
    Rectangle {
        x: 0;
        width: parent.width;
        height: parent.height * min(root.value, root.yellow);
        y: parent.height - self.height;
        background: Theme.positive;
    }
    Rectangle {
        x: 0;
        width: parent.width;
        height: parent.height * max(0, min(root.value, root.red) - root.yellow);
        y: parent.height * (1 - min(root.value, root.red));
        background: Theme.warning;
    }
    Rectangle {
        x: 0;
        width: parent.width;
        height: parent.height * max(0, root.value - root.red);
        y: parent.height * (1 - root.value);
        background: Theme.danger;
    }
}

component Strip inherits Section {
    in property <StripData> data;
    in property <bool> is-master;
    callback open-tapped();
    callback mute-tapped();
    callback solo-tapped();
    callback level(float);
    callback held(bool);
    // The strip's insides: the fader beside its meters (each a thin bar), the marks under them.
    property <length> fader-width: Theme.touch;
    property <length> meter-width: 7px;
    property <length> meter-pitch: 10px; // from one meter to the next
    property <length> meter-gap: Theme.pad-wide; // fader to meters
    property <length> meter-inset: Theme.pad-narrow; // the meters' ends from the fader's
    // The name and sound over the fader, the marks under it (their sides the screen's, smaller on a short strip).
    in property <length> top;
    in property <length> marks;
    property <length> bottom: root.is-master ? Theme.pad : root.marks + Theme.pad-narrow + Theme.pad-tight;
    property <length> pair-width: root.fader-width + root.meter-gap + root.meter-pitch + root.meter-width;
    Rectangle {
        opacity: data.dim ? Theme.dim : 1;
        FitText {
            x: Theme.pad;
            y: Theme.pad-narrow;
            width: parent.width - 2 * Theme.pad;
            height: Theme.body + Theme.pad-tight;
            text: data.name;
            ink: Theme.text;
            size: Theme.body;
            bold: true;
            align: left;
        }
        FitText {
            x: Theme.pad;
            y: Theme.pad-narrow + Theme.body + Theme.pad-tight;
            width: parent.width - 2 * Theme.pad;
            height: Theme.small + Theme.pad-tight;
            text: data.detail;
            ink: Theme.muted;
            size: Theme.small;
            align: left;
        }
        if !root.is-master: TouchArea {
            height: root.top - Theme.pad-tight;
            clicked => { root.open-tapped(); }
        }
        // The fader and its meters as a pair, centered above the marks.
        fader := Rectangle {
            x: (root.width - root.pair-width) / 2;
            y: root.top;
            width: root.fader-width;
            height: root.height - root.top - root.bottom;
            SliderBar {
                x: 0;
                y: Theme.thumb / 2;
                width: parent.width;
                height: parent.height - Theme.thumb;
                norm: data.fraction;
                upright: true;
                lit: data.cursor;
            }
            touch := TouchArea {
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) { root.held(true); }
                    if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { root.held(false); }
                }
                moved => { root.level(max(0, min(1, 1 - (touch.mouse-y - Theme.thumb / 2) / (fader.height - Theme.thumb)))); }
                clicked => { root.level(max(0, min(1, 1 - (touch.mouse-y - Theme.thumb / 2) / (fader.height - Theme.thumb)))); }
            }
        }
        if data.channels > 0: Meter {
            x: fader.x + fader.width + root.meter-gap;
            y: fader.y + root.meter-inset;
            width: root.meter-width;
            height: fader.height - 2 * root.meter-inset;
            value: data.peak-a;
        }
        if data.channels > 1: Meter {
            x: fader.x + fader.width + root.meter-gap + root.meter-pitch;
            y: fader.y + root.meter-inset;
            width: root.meter-width;
            height: fader.height - 2 * root.meter-inset;
            value: data.peak-b;
        }
        if !root.is-master: Mark {
            x: root.width / 2 - root.marks - Theme.pad-tight;
            y: root.height - root.marks - Theme.pad-narrow;
            width: root.marks;
            height: root.marks;
            letter: "M";
            tint: Theme.danger;
            on: data.mute;
            clicked => { root.mute-tapped(); }
        }
        if !root.is-master: Mark {
            x: root.width / 2 + Theme.pad-tight;
            y: root.height - root.marks - Theme.pad-narrow;
            width: root.marks;
            height: root.marks;
            letter: "S";
            tint: Theme.accent;
            on: data.solo;
            clicked => { root.solo-tapped(); }
        }
    }
    Cursor {
        shown: data.cursor && !data.mark-cursor;
        editing: data.editing;
    }
    if data.mark-cursor: Cursor {
        x: root.width / 2 - root.marks - Theme.pad-tight;
        y: root.height - root.marks - Theme.pad-narrow;
        width: root.marks;
        height: root.marks;
        corner: Theme.mark-radius(root.marks);
        shown: true;
    }
}

// A link of the hint line: its words in a tint, a touch target tall, a focus border for the cursor.
component HintLink inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    in property <bool> cursor;
    callback clicked();
    width: label.preferred-width + 2 * Theme.pad-narrow;
    label := Text {
        x: Theme.pad-narrow;
        height: parent.height;
        vertical-alignment: center;
        font-size: Theme.small;
        font-weight: 700;
        color: root.tint;
        text: root.text;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
    Cursor {
        shown: root.cursor;
        corner: Theme.field-radius(root.height);
    }
}

export component Play inherits Rectangle {
    // The sections' gap (none in a theme whose sections join).
    property <length> gap: Theme.gap-between(Theme.gap);
    // A touch target tall; taller when the theme's type is large enough that the number and the name would not fit stacked.
    property <length> scenes-height: max(Theme.touch, Theme.small + Theme.button * 1.25 + 2 * Theme.pad-tight);
    property <length> strip-min: Theme.button-width;
    property <length> strips-x: Theme.margin;
    property <length> strips-width: self.width - 2 * Theme.margin;
    // Strips across, the master's among them; the cell is the same whatever the parts shown.
    property <int> across: max(2, floor((strips-width + gap) / (strip-min + gap)));
    property <length> cell: (strips-width - (across - 1) * gap) / across;
    // The line offering the on-screen keyboard when no MIDI device is connected, over the strips.
    property <length> hint-y: Theme.margin + scenes-height + Theme.gap;
    property <length> hint-height: PlayState.hint ? Theme.touch + Theme.gap : 0px;
    // The knob row, as PlayView.cpp gives it: a quarter of the screen (the grid's tile height at most, 70% of it at
    // least), the tiles side by side and the buttons that choose what they follow in a column at the right.
    property <length> knobs-y: hint-y + hint-height;
    property <length> knob-row: PlayState.has-knobs ? min(PlayState.knob-tile, max(PlayState.knob-tile * 0.7, self.height / 4)) : 0px;
    property <int> buttons: PlayState.knob-buttons.length;
    property <bool> has-bank: buttons > 0 && PlayState.knob-buttons[buttons - 1].bank;
    property <bool> has-column: buttons - (has-bank ? 1 : 0) > 0;
    property <length> column-width: Theme.button-width;
    property <length> bank-width: Theme.button-width * 0.8;
    property <length> column-x: self.width - Theme.margin - column-width;
    property <length> bank-x: (has-column ? column-x - gap : self.width - Theme.margin) - bank-width;
    property <length> side-width: (has-column ? column-width + gap : 0px) + (has-bank ? bank-width + gap : 0px);
    property <length> knob-w: self.width - 2 * Theme.margin - side-width;
    property <length> pair-height: min(Theme.touch, (knob-row - gap) / 2);
    // Learn's line, over the strips, while it waits for a target.
    property <length> banner-y: knobs-y + knob-row + (PlayState.has-knobs ? Theme.gap : 0px);
    property <length> banner-height: PlayState.learning ? Theme.touch + Theme.gap : 0px;
    property <length> strips-y: banner-y + banner-height;
    // The line under the strips: the engine's refusals and which parts show, only when it has something to say.
    property <length> footer: (PlayState.message != "" || PlayState.view != "") ? Theme.small + 2 * Theme.pad-tight : 0px;
    property <length> footer-y: self.height - Theme.margin - footer;
    property <length> strips-height: max(0px, self.height - strips-y - Theme.margin - (footer > 0px ? footer + Theme.gap : 0px));
    // A strip: its name and sound over the fader, the marks (a touch target, less on a short strip) under it.
    property <length> strip-top: Theme.pad-narrow + Theme.body + Theme.pad-tight + Theme.small + Theme.pad-tight;
    property <length> marks: strips-height >= 4 * Theme.touch + 2 * Theme.pad ? Theme.touch : Theme.touch * 0.75;
    property <length> fader-travel: max(0px, strips-height - strip-top - marks - Theme.pad-narrow - Theme.pad-tight - Theme.thumb);
    property <length> step-width: PlayState.can-step ? Theme.button-width + Theme.gap : 0px;
    property <length> scene-width: (self.width - 2 * Theme.margin - 2 * step-width - 7 * gap) / 8;
    property <PlayLayout> layout: {
        width: self.width,
        height: self.height,
        scene-width: scene-width,
        scenes-height: scenes-height,
        hint-y: hint-y,
        hint-height: hint-height - (PlayState.hint ? Theme.gap : 0px),
        knobs-y: knobs-y,
        knob-height: knob-row,
        banner-y: banner-y,
        banner-height: banner-height - (PlayState.learning ? Theme.gap : 0px),
        strips-y: strips-y,
        strips-height: strips-height,
        fader-travel: fader-travel,
        footer-y: footer-y,
        footer-height: footer,
    };
    changed across => { PlayState.strips-per-view = across - 1; PlayState.resized(); }
    changed layout => { PlayState.layout = self.layout; }
    changed knob-w => {
        PlayState.knob-width = self.knob-w;
        PlayState.knob-resized();
    }
    changed knob-row => {
        PlayState.knob-height = self.knob-row;
        PlayState.knob-resized();
    }
    init => {
        PlayState.strips-per-view = across - 1;
        PlayState.knob-width = self.knob-w;
        PlayState.knob-height = self.knob-row;
        PlayState.layout = self.layout;
    }

    if PlayState.can-step: Button {
        x: Theme.margin;
        y: Theme.margin;
        width: Theme.button-width;
        height: root.scenes-height;
        text: "Previous";
        clicked => { PlayState.step(-1); }
    }
    if PlayState.can-step: Button {
        x: root.width - Theme.margin - Theme.button-width;
        y: Theme.margin;
        width: Theme.button-width;
        height: root.scenes-height;
        text: "Next";
        clicked => { PlayState.step(1); }
    }
    // The scenes: the one playing an accent wash and edge, a filled one a section, an empty one an outline.
    for scene[i] in PlayState.scenes: Section {
        x: Theme.margin + root.step-width + i * (root.scene-width + root.gap);
        y: Theme.margin;
        width: root.scene-width;
        height: root.scenes-height;
        fill: scene.on ? Theme.accent.with-alpha(Theme.wash-light) : scene.filled ? Theme.surface : transparent;
        border-width: scene.on ? Theme.cursor-width : scene.filled ? (Theme.sections == SectionStyle.joined ? 0px : Theme.edge-width) : Theme.hair;
        border-color: scene.on ? Theme.accent : scene.filled ? Theme.edge-color : Theme.track;
        Text {
            x: Theme.pad-narrow;
            y: Theme.pad-tight - Theme.hair;
            text: scene.number;
            color: Theme.muted;
            font-size: Theme.small;
        }
        // The name across the tile under its number: whole when it fits, 70% of its size before it is cut.
        name := FitText {
            x: Theme.pad-narrow;
            y: Theme.small;
            width: parent.width - 2 * Theme.pad-narrow;
            height: parent.height - Theme.small;
            text: scene.add ? "+ Scene" : scene.name;
            ink: scene.on ? Theme.accent : scene.add ? Theme.muted : Theme.text;
            size: scene.add ? Theme.small : Theme.button;
            bold: !scene.add;
        }
        property <bool> cut: name.cut;
        changed cut => { PlayState.scene-fit(i, self.cut); }
        init => { PlayState.scene-fit(i, self.cut); }
        Cursor {
            shown: scene.cursor;
        }
        if scene.filled || scene.add: TouchArea {
            clicked => { PlayState.scene-tapped(i); }
        }
    }

    if PlayState.hint: HorizontalLayout {
        x: Theme.margin;
        y: root.hint-y;
        width: root.width - 2 * Theme.margin;
        height: Theme.touch;
        spacing: Theme.pad-narrow;
        alignment: start;
        Text {
            vertical-alignment: center;
            font-size: Theme.small;
            color: Theme.muted;
            text: "No MIDI device.";
        }
        HintLink {
            text: "Open the on-screen keyboard";
            tint: Theme.accent;
            cursor: PlayState.hint-cursor == 0;
            clicked => { PlayState.hint-keys(); }
        }
        HintLink {
            text: "Dismiss";
            tint: Theme.muted;
            cursor: PlayState.hint-cursor == 1;
            clicked => { PlayState.hint-dismiss(); }
        }
    }

    // The knob row: a tile for each knob, and at the right the buttons that choose what they follow (the bank's beside).
    for b[i] in PlayState.knob-buttons: Button {
        x: b.bank ? root.bank-x : root.column-x;
        y: root.knobs-y + (b.bank ? (root.knob-row - self.height) / 2 : (root.knob-row - 2 * root.pair-height - root.gap) / 2 + i * (root.pair-height + root.gap));
        width: b.bank ? root.bank-width : root.column-width;
        height: b.bank ? min(Theme.touch, root.knob-row) : root.pair-height;
        text: b.text;
        on: b.on;
        clicked => { PlayState.knob-button(i); }
        Cursor {
            shown: b.cursor;
            corner: Theme.button-radius(parent.height);
        }
    }
    if PlayState.has-knobs: TileRow {
        x: Theme.margin;
        y: root.knobs-y;
        width: root.knob-w;
        height: root.knob-row;
        tiles: PlayState.knobs;
        grab(k, part) => { PlayState.knob-grab(k, part); }
        drag(k, part, norm) => { PlayState.knob-drag(k, part, norm); }
        release(k) => { PlayState.knob-release(k); }
        tap(k, stop) => { PlayState.knob-tap(k, stop); }
    }
    if PlayState.learning: Rectangle {
        x: Theme.margin;
        y: root.banner-y;
        width: root.width - 2 * Theme.margin;
        height: Theme.touch;
        background: Theme.accent.with-alpha(Theme.wash-light);
        border-radius: Theme.section-radius;
        Text {
            x: Theme.pad-wide;
            width: max(0px, parent.width - 2 * Theme.pad-wide - 2 * Theme.button-width - 2 * Theme.gap);
            height: parent.height;
            text: PlayState.learn-text;
            color: Theme.text;
            font-size: Theme.body;
            overflow: elide;
            vertical-alignment: center;
        }
        if PlayState.learn-reset-shown: Button {
            x: parent.width - 2 * Theme.button-width - Theme.gap - Theme.pad-narrow;
            y: Theme.pad-tight;
            width: Theme.button-width;
            height: parent.height - 2 * Theme.pad-tight;
            text: "Default";
            clicked => { PlayState.learn-reset(); }
            Cursor {
                shown: PlayState.learn-reset-cursor;
                corner: Theme.button-radius(parent.height);
            }
        }
        Button {
            x: parent.width - Theme.button-width - Theme.pad-narrow;
            y: Theme.pad-tight;
            width: Theme.button-width;
            height: parent.height - 2 * Theme.pad-tight;
            text: "Done";
            clicked => { PlayState.learn-done(); }
            Cursor {
                shown: PlayState.learn-done-cursor;
                corner: Theme.button-radius(parent.height);
            }
        }
    }

    for strip[i] in PlayState.strips: Strip {
        x: root.strips-x + i * (root.cell + root.gap);
        y: root.strips-y;
        width: root.cell;
        height: root.strips-height;
        data: strip;
        top: root.strip-top;
        marks: root.marks;
        open-tapped => { PlayState.part-tapped(i); }
        mute-tapped => { PlayState.mute-tapped(i); }
        solo-tapped => { PlayState.solo-tapped(i); }
        level(f) => { PlayState.level(i, f); }
        held(down) => { PlayState.held(i, down); }
    }
    if PlayState.has-master: Strip {
        x: root.strips-x + (root.across - 1) * (root.cell + root.gap);
        y: root.strips-y;
        width: root.cell;
        height: root.strips-height;
        is-master: true;
        top: root.strip-top;
        marks: root.marks;
        data: PlayState.master;
        level(f) => { PlayState.level(-1, f); }
        held(down) => { PlayState.held(-1, down); }
    }
    if !PlayState.has-master: Text {
        x: Theme.margin;
        y: root.strips-y;
        width: root.width - 2 * Theme.margin;
        height: root.strips-height;
        text: "No parts yet. Edit adds them.";
        color: Theme.muted;
        font-size: Theme.body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.footer > 0px: Text {
        x: Theme.margin;
        y: root.footer-y;
        width: root.width - 2 * Theme.margin;
        height: root.footer;
        vertical-alignment: center;
        overflow: elide;
        font-size: Theme.small;
        color: Theme.muted;
        text: PlayState.message == "" ? PlayState.view : PlayState.view == "" ? PlayState.message : PlayState.message + "   " + PlayState.view;
    }
}
