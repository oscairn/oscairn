// The Routing page (src/routing.rs), the JUCE Edit view's routing page (hosts/standalone/PartsView.cpp):
// the real graph as boxes in columns by signal flow with its wires, fitted to the space above a panel
// for what is chosen (what it connects to, each source's level into it). Every point of the drawing is
// laid out by src/wires.rs and scaled by the screen: the wires are paths in the pixels of the canvas
// (`fit: preserve`), the boxes sit at the same points, so a wire meets its port wherever the window is.
// Wires are drawn in the theme's wire colors: audio, notes, disabled, draining, unconnected, and the
// control color for the lines from a plugin's lane to a control or a parameter. A cursor is a focus
// border round a box or a panel cell; a value being changed takes the accent border.

import { Theme, Section, Button, Cursor, SliderBar } from "theme.slint";

export struct RoutingBox {
    x: float, // pixels of the canvas
    y: float,
    w: float,
    h: float,
    name: string,
    detail: string,
    chips: [string], // a collapsed part's plugins in order
    bright: bool, // faint when something else is chosen
    chosen: bool,
    off: bool, // a plugin switched off
    failed: bool, // a plugin that failed and is silent
    badge: bool, // wired in Routing too
    tint: int, // a part: 0 none, 1 draining, 2 muted
    cursor: bool,
    part: bool, // a collapsed part: drawn as one with its chips
    chevron: int, // 0 none, 1 expand, 2 collapse
}

export struct RoutingWire {
    commands: string, // the lines of the wire, in pixels of the canvas
    color: color,
    width: float,
    alpha: float,
}

export struct RoutingLink {
    commands: string,
    width: float,
    alpha: float, // how bright it is: faint when it does not touch what is chosen
    dot-x: float,
    dot-y: float,
}

export struct PanelCellData {
    kind: int, // 0 a button, 1 a toggle, 2 a slider, 3 a value the dial changes
    label: string,
    on: bool,
    value: float,
    width: float, // in units of a button's width
    enabled: bool,
    cursor: bool,
    editing: bool,
}

export struct PanelRowData {
    kind: int, // 0 words, 1 a title, 2 a control line (in the control color), 3 cells
    text: string,
    cells: [PanelCellData],
}

export global RoutingState {
    in property <[RoutingBox]> frames;
    in property <[RoutingBox]> boxes;
    in property <[RoutingBox]> controls;
    in property <[RoutingWire]> wires;
    in property <[RoutingLink]> links;
    in property <float> scale: 1; // the drawing's (the theme's type scale, at least 1), which its type is scaled by
    // The type of the drawing at scale 1: the theme's small size at its own scale, so no text of a box is under it.
    out property <length> base: Theme.small / Theme.font-scale;
    // The drawing is as large as it is laid out (it is not shrunk to fit the canvas) and scrolls in the canvas.
    in property <length> content-width: 0px;
    in property <length> content-height: 0px;
    in-out property <length> pan-x: 0px;
    in-out property <length> pan-y: 0px;
    in property <int> panel-need: 1; // rows the panel would show if it had the room
    in property <bool> frames-collapsible;
    in property <[PanelRowData]> panel;
    in property <bool> more-panel;
    in property <string> message;
    in property <string> view;
    // What the screen needs to fit the drawing and the panel: set by the screen's component.
    in-out property <length> canvas-width: 0px;
    in-out property <length> canvas-height: 0px;
    in-out property <length> canvas-x: 0px; // where the canvas starts in the screen
    in-out property <length> canvas-y: 0px;
    in-out property <int> panel-rows: 1; // rows a view of the panel holds
    in-out property <int> panel-units: 1; // button widths across the panel
    callback resized();
    callback tapped(int, int); // a kind (0 a frame, 1 a box, 2 a control) and its place in that list
    callback chevron(int, int); // a frame (0) or a box (1): expand or collapse
    callback panel-press(int, int); // a row of the view and a cell
    callback panel-moved(int, int, float); // a row, a cell, the slider's new place
    callback panel-held(int, int, bool);
    callback turn-panel(int);
}

component Chevron inherits Rectangle {
    in property <bool> down;
    background: Theme.raised;
    border-radius: self.width / 2;
    border-width: Theme.hair;
    border-color: Theme.border;
    Path {
        x: parent.width * 0.28;
        y: parent.height * 0.28;
        width: parent.width * 0.44;
        height: parent.height * 0.44;
        viewbox-width: 1;
        viewbox-height: 1;
        stroke: Theme.text;
        stroke-width: Theme.hair * 1.5;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: root.down ? "M 0.05 0.25 L 0.5 0.75 L 0.95 0.25" : "M 0.25 0.05 L 0.75 0.5 L 0.25 0.95";
    }
}

// An expanded part's frame, under the wires; its head (the name) is what is pressed.
component FrameBox inherits Rectangle {
    in property <RoutingBox> data;
    callback tapped();
    callback chevron();
    property <float> s: RoutingState.scale;
    property <length> head: 40px * s;
    opacity: data.bright ? 1 : 0.5;
    Rectangle {
        border-radius: Theme.section-radius;
        background: Theme.background.mix(Theme.surface, 0.45);
        border-width: data.chosen ? Theme.cursor-width : Theme.hair;
        border-color: data.chosen ? Theme.accent : Theme.border;
    }
    Text {
        x: 12px * root.s;
        y: 0;
        width: parent.width - 24px * root.s - (data.chevron > 0 ? 44px * root.s : 0px);
        height: root.head;
        text: data.name;
        color: Theme.text;
        font-size: RoutingState.base * 1.08 * root.s;
        font-weight: 700;
        overflow: elide;
        vertical-alignment: center;
    }
    TouchArea {
        height: root.head;
        clicked => { root.tapped(); }
    }
    if data.chevron > 0: Chevron {
        x: parent.width - 22px * root.s - self.width / 2;
        y: (root.head - self.height) / 2;
        width: 30px * root.s;
        height: 30px * root.s;
        down: true;
    }
    if data.chevron > 0: TouchArea {
        x: parent.width - 44px * root.s;
        height: root.head;
        width: 44px * root.s;
        clicked => { root.chevron(); }
    }
    Cursor {
        shown: data.cursor;
        always: false;
    }
}

// A plugin, or the graph's input or output.
component NodeBox inherits Rectangle {
    in property <RoutingBox> data;
    callback tapped();
    property <float> s: RoutingState.scale;
    opacity: (data.bright ? 1 : Theme.dim) * (data.off ? 0.55 : 1);
    Rectangle {
        border-radius: Theme.corner;
        background: data.chosen ? Theme.accent.with-alpha(Theme.wash) : Theme.surface;
        border-width: data.chosen ? Theme.cursor-width : Theme.hair;
        border-color: data.chosen ? Theme.accent : data.failed ? Theme.danger : Theme.border;
    }
    Text {
        x: 8px * root.s;
        y: 2px;
        width: parent.width - 16px * root.s;
        height: (parent.height - 4px) * 0.6;
        text: data.name;
        color: Theme.text;
        font-size: RoutingState.base * root.s;
        overflow: elide;
        vertical-alignment: bottom;
    }
    Text {
        x: 8px * root.s;
        y: 2px + (parent.height - 4px) * 0.6;
        width: parent.width - 16px * root.s;
        height: (parent.height - 4px) * 0.4;
        text: data.off ? (data.detail == "" ? "off" : data.detail + " · off") : data.detail;
        color: Theme.muted;
        font-size: RoutingState.base * root.s;
        overflow: elide;
        vertical-alignment: top;
    }
    if data.badge: Rectangle {
        x: parent.width - 12px;
        y: 5px;
        width: 7px;
        height: 7px;
        border-radius: self.width / 2;
        background: Theme.warning;
    }
    TouchArea {
        clicked => { root.tapped(); }
    }
    Cursor {
        shown: data.cursor;
        corner: Theme.corner;
    }
}

// A collapsed part: its name, what it is, its plugins as chips in order (as many as fit), and the chevron
// that expands it.
component PartBox inherits Rectangle {
    in property <RoutingBox> data;
    callback tapped();
    callback chevron();
    property <float> s: RoutingState.scale;
    opacity: data.bright ? 1 : Theme.dim;
    Rectangle {
        border-radius: Theme.section-radius;
        background: Theme.surface;
    }
    if data.tint > 0: Rectangle {
        border-radius: Theme.section-radius;
        background: (data.tint == 1 ? Theme.accent : Theme.danger).with-alpha(Theme.wash-light);
    }
    Rectangle {
        border-radius: Theme.section-radius;
        border-width: data.chosen ? Theme.cursor-width : Theme.hair;
        border-color: data.chosen ? Theme.accent : Theme.border;
    }
    Text {
        x: 12px * root.s;
        y: 8px * root.s;
        width: parent.width - 24px * root.s - 38px * root.s;
        height: (parent.height - 16px * root.s) / 2;
        text: data.detail == "" ? data.name : data.name + "  " + data.detail.to-uppercase();
        color: Theme.text;
        font-size: RoutingState.base * 1.08 * root.s;
        font-weight: 700;
        overflow: elide;
        vertical-alignment: bottom;
    }
    Rectangle {
        x: 12px * root.s;
        y: 8px * root.s + (parent.height - 16px * root.s) / 2 + 4px * root.s;
        width: parent.width - 24px * root.s - 38px * root.s;
        height: 20px * root.s;
        clip: true;
        HorizontalLayout {
            alignment: start;
            spacing: 2px * root.s;
            for chip[i] in data.chips: HorizontalLayout {
                spacing: 2px * root.s;
                if i > 0: Text {
                    text: "›";
                    color: Theme.muted;
                    font-size: RoutingState.base * root.s;
                    vertical-alignment: center;
                }
                Rectangle {
                    preferred-width: label.preferred-width + 14px * root.s;
                    background: Theme.raised;
                    border-radius: Theme.pad-tight * root.s;
                    label := Text {
                        x: 7px * root.s;
                        text: chip;
                        color: Theme.text;
                        font-size: RoutingState.base * root.s;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    TouchArea {
        clicked => { root.tapped(); }
    }
    if data.chevron > 0: Chevron {
        x: parent.width - 22px * root.s - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 30px * root.s;
        height: 30px * root.s;
        down: false;
    }
    if data.chevron > 0: TouchArea {
        x: parent.width - 44px * root.s;
        width: 44px * root.s;
        clicked => { root.chevron(); }
    }
    Cursor {
        shown: data.cursor;
    }
}

// A control a plugin's lane drives: a small pill under the graph.
component ControlPill inherits Rectangle {
    in property <RoutingBox> data;
    callback tapped();
    property <float> s: RoutingState.scale;
    border-radius: self.height / 2;
    background: Theme.surface;
    border-width: 1.5px;
    border-color: Theme.wire-control;
    Text {
        x: 10px * root.s;
        width: parent.width - 20px * root.s;
        height: parent.height;
        text: data.name;
        color: Theme.text;
        font-size: RoutingState.base * root.s;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { root.tapped(); }
    }
    Cursor {
        shown: data.cursor;
        corner: root.height / 2;
    }
}

// A cell of the panel: a button, a toggle, a slider or a value the dial changes.
component PanelCell inherits Rectangle {
    in property <PanelCellData> data;
    callback pressed();
    callback moved(float);
    callback held(bool);
    preferred-width: 150px * Theme.font-scale * data.width;
    min-width: data.kind == 2 ? 80px : 0px;
    horizontal-stretch: data.kind == 2 ? 2 : 0;
    if data.kind != 2: Button {
        text: data.label;
        on: data.kind == 1 && data.on;
        enabled: data.enabled;
        size: Theme.small;
        bold: data.kind != 3;
        clicked => { root.pressed(); }
    }
    if data.kind == 2: Rectangle {
        opacity: data.enabled ? 1 : Theme.disabled;
        SliderBar {
            x: Theme.thumb / 2;
            width: parent.width - Theme.thumb;
            height: parent.height;
            norm: data.value;
            lit: data.cursor;
        }
        touch := TouchArea {
            enabled: data.enabled;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) { root.held(true); }
                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { root.held(false); }
            }
            moved => { root.moved(max(0, min(1, (touch.mouse-x - Theme.thumb / 2) / (root.width - Theme.thumb)))); }
            clicked => { root.moved(max(0, min(1, (touch.mouse-x - Theme.thumb / 2) / (root.width - Theme.thumb)))); }
        }
    }
    Cursor {
        shown: data.cursor;
        editing: data.editing;
        corner: data.kind == 2 ? Theme.field-radius(root.height) : Theme.button-radius(root.height);
    }
}

export component Routing inherits Rectangle {
    // The sections' gap (none in a theme whose sections join).
    property <length> gap: Theme.gap-between(Theme.gap);
    property <length> footer: Theme.small + 2 * Theme.pad-tight;
    property <length> body-y: Theme.margin;
    property <length> body-bottom: self.height - Theme.margin - footer - Theme.gap;
    property <length> body-height: max(0px, body-bottom - body-y);
    // The drawing above, the panel for what is chosen below it. The panel takes the rows it has, a view of at
    // least two rows (the cap is two fifths of what is left, at most 60%); the drawing the rest.
    property <length> row-pitch: Theme.touch + gap;
    property <length> panel-need: max(1, RoutingState.panel-need) * row-pitch - gap + 2 * Theme.pad-tight;
    property <length> panel-cap: min(body-height * 0.6, max(2 * row-pitch - gap + 2 * Theme.pad-tight, body-height * 0.4));
    property <length> panel-height: min(panel-cap, panel-need);
    property <length> canvas-y: body-y;
    property <length> canvas-outer: max(0px, body-height - panel-height - gap);
    property <length> inset: Theme.pad-narrow;
    property <length> canvas-w: max(0px, self.width - 2 * Theme.margin - 2 * inset);
    property <length> canvas-h: max(0px, canvas-outer - 2 * inset);
    property <length> panel-y: canvas-y + canvas-outer + gap;
    // What a view holds is what the panel could have at most, so it does not wait on the panel taking its height.
    property <int> rows: max(1, floor((panel-cap - 2 * Theme.pad-tight + gap) / row-pitch));
    property <length> unit: 150px * Theme.font-scale;
    property <int> units: max(1, floor((self.width - 2 * Theme.margin - 2 * Theme.pad - 110px * Theme.font-scale) / (unit + Theme.gap)));
    property <length> pan-x: RoutingState.pan-x;
    property <length> pan-y: RoutingState.pan-y;
    changed canvas-w => { RoutingState.canvas-width = canvas-w; RoutingState.resized(); }
    changed canvas-h => { RoutingState.canvas-height = canvas-h; RoutingState.resized(); }
    changed rows => { RoutingState.panel-rows = rows; RoutingState.resized(); }
    changed units => { RoutingState.panel-units = units; RoutingState.resized(); }
    changed canvas-y => { RoutingState.canvas-y = canvas-y + inset; }
    changed pan-x => { view.content-x = -self.pan-x; }
    changed pan-y => { view.content-y = -self.pan-y; }
    init => {
        RoutingState.canvas-width = canvas-w;
        RoutingState.canvas-height = canvas-h;
        RoutingState.canvas-x = Theme.margin + inset;
        RoutingState.canvas-y = canvas-y + inset;
        RoutingState.panel-rows = rows;
        RoutingState.panel-units = units;
    }

    // The drawing: frames under the wires, the wires, the boxes, the control lines and their pills.
    view := Flickable {
        x: Theme.margin + root.inset;
        y: root.canvas-y + root.inset;
        width: root.canvas-w;
        height: root.canvas-h;
        content-width: RoutingState.content-width;
        content-height: RoutingState.content-height;
        changed content-x => { RoutingState.pan-x = -self.content-x; }
        changed content-y => { RoutingState.pan-y = -self.content-y; }
        for f[i] in RoutingState.frames: FrameBox {
            x: f.x * 1px;
            y: f.y * 1px;
            width: f.w * 1px;
            height: f.h * 1px;
            data: f;
            tapped => { RoutingState.tapped(0, i); }
            chevron => { RoutingState.chevron(0, i); }
        }
        for w in RoutingState.wires: Path {
            x: 0;
            y: 0;
            width: RoutingState.content-width;
            height: RoutingState.content-height;
            fit: preserve; // the commands are in pixels of the canvas: no scaling, no stroke inset
            stroke: w.color.with-alpha(w.alpha);
            stroke-width: w.width * 1px;
            commands: w.commands;
        }
        for b[i] in RoutingState.boxes: Rectangle {
            x: b.x * 1px;
            y: b.y * 1px;
            width: b.w * 1px;
            height: b.h * 1px;
            if b.part: PartBox {
                data: b;
                tapped => { RoutingState.tapped(1, i); }
                chevron => { RoutingState.chevron(1, i); }
            }
            if !b.part: NodeBox {
                data: b;
                tapped => { RoutingState.tapped(1, i); }
            }
        }
        for l in RoutingState.links: Path {
            x: 0;
            y: 0;
            width: RoutingState.content-width;
            height: RoutingState.content-height;
            fit: preserve;
            stroke: Theme.background.with-alpha(l.alpha * 0.9);
            stroke-width: (l.width + 3) * 1px;
            stroke-line-join: round;
            commands: l.commands;
        }
        for l in RoutingState.links: Path {
            x: 0;
            y: 0;
            width: RoutingState.content-width;
            height: RoutingState.content-height;
            fit: preserve;
            stroke: Theme.wire-control.with-alpha(l.alpha);
            stroke-width: l.width * 1px;
            stroke-line-join: round;
            commands: l.commands;
        }
        for l in RoutingState.links: Rectangle {
            x: l.dot-x * 1px - 3px * RoutingState.scale;
            y: l.dot-y * 1px - 3px * RoutingState.scale;
            width: 6px * RoutingState.scale;
            height: 6px * RoutingState.scale;
            border-radius: self.width / 2;
            background: Theme.wire-control.with-alpha(l.alpha);
        }
        for c[i] in RoutingState.controls: ControlPill {
            x: c.x * 1px;
            y: c.y * 1px;
            width: c.w * 1px;
            height: c.h * 1px;
            data: c;
            tapped => { RoutingState.tapped(2, i); }
        }
    }
    // What is chosen: its words and the cells a row of them holds, a view of rows at a time.
    Section {
        x: Theme.margin;
        y: root.panel-y;
        width: root.width - 2 * Theme.margin;
        height: root.panel-height;
        VerticalLayout {
            padding: Theme.pad-tight;
            padding-right: Theme.pad-tight + (RoutingState.more-panel ? 2 * Theme.touch + Theme.pad-tight : 0px);
            spacing: root.gap;
            alignment: start;
            for row[r] in RoutingState.panel: HorizontalLayout {
                height: Theme.touch;
                spacing: Theme.gap;
                if row.kind != 3: Text {
                    horizontal-stretch: 1;
                    text: row.text;
                    color: row.kind == 2 ? Theme.wire-control : row.kind == 1 ? Theme.muted : Theme.text;
                    font-size: row.kind == 1 ? Theme.small : Theme.body;
                    font-weight: row.kind == 1 ? 700 : 400;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if row.kind == 3: Text {
                    preferred-width: 110px * Theme.font-scale;
                    min-width: 40px;
                    horizontal-stretch: 1;
                    text: row.text;
                    color: Theme.text;
                    font-size: Theme.small;
                    overflow: elide;
                    vertical-alignment: center;
                }
                for cell[c] in row.cells: PanelCell {
                    data: cell;
                    pressed => { RoutingState.panel-press(r, c); }
                    moved(f) => { RoutingState.panel-moved(r, c, f); }
                    held(down) => { RoutingState.panel-held(r, c, down); }
                }
            }
        }
        if RoutingState.more-panel: Button {
            x: parent.width - 2 * Theme.touch - Theme.pad-tight;
            y: parent.height - Theme.touch - Theme.pad-tight;
            width: Theme.touch;
            height: Theme.touch;
            text: "▲";
            clicked => { RoutingState.turn-panel(-1); }
        }
        if RoutingState.more-panel: Button {
            x: parent.width - Theme.touch - Theme.pad-tight;
            y: parent.height - Theme.touch - Theme.pad-tight;
            width: Theme.touch;
            height: Theme.touch;
            text: "▼";
            clicked => { RoutingState.turn-panel(1); }
        }
    }
    Text {
        x: Theme.margin;
        y: root.height - Theme.margin - root.footer;
        width: root.width - 2 * Theme.margin;
        height: root.footer;
        vertical-alignment: center;
        overflow: elide;
        font-size: Theme.small;
        color: Theme.muted;
        text: RoutingState.message == "" ? RoutingState.view : RoutingState.message + "   " + RoutingState.view;
    }
}
