// SPDX-License-Identifier: AGPL-3.0-or-later
// The Setlist screen (src/setlist.rs): the setlists on the left, the open setlist's slots on the
// right, a view of them at a time (a grid as the setlist's display says, or a list), Previous and
// Next under them. Each pane's cursor is a border; the slot playing is marked apart from it.

import { Theme, Section, Button, Cursor, RowMark, RowStyle } from "theme.slint";
import { Loading } from "loading.slint";

export struct ListRow {
    name: string,
    cursor: bool,
    shown: bool, // the setlist open on the right
}

export struct SlotData {
    number: int,
    title: string,
    note: string, // why it does not open: a placeholder, not in the library
    tint: color,
    tinted: bool,
    empty: bool,
    opens: bool,
    playing: bool,
    opening: bool, // the engine is opening it now: a bar along the tile's foot
    cursor: bool,
}

// What the Setlist shows, set by setlist.rs.
export global SetlistState {
    in property <[ListRow]> setlists;
    in property <[SlotData]> slots;
    in property <string> name;
    in property <string> page;
    in property <string> view; // which slots of the page show: "1–12 of 30"
    in property <string> message;
    in property <bool> grid;
    in property <int> columns: 4;
    in property <int> rows: 3;
    in property <bool> can-previous;
    in property <bool> can-next;
    // How many rows of setlists, and how many slots, the screen holds: set by the screen.
    in-out property <int> list-rows: 1;
    in-out property <int> slots-per-view: 1;
    callback tapped-slot(int);
    callback tapped-setlist(int);
    callback step(int);
    callback play(); // open Play
    callback resized(); // the views' sizes changed (the window, or the theme's paddings): shown again
}

export component Setlist inherits Rectangle {
    // The sections' gap (none in a theme whose sections join); the list's width and a slot's row height (Setlist.cpp's).
    property <length> gap: Theme.gap-between(Theme.gap);
    property <length> row-height: Theme.touch;
    property <length> list-width: 280px;
    property <length> line: 24px; // the message line above the buttons
    property <length> number-column: 64px; // a list view's room for the slot's number
    property <length> slot-row: 56px; // a slot's height in the list view
    property <length> footer: Theme.touch + line + Theme.gap;
    property <length> slots-x: list-width + 2 * Theme.margin;
    property <length> slots-width: self.width - slots-x - Theme.margin;
    property <length> slots-height: self.height - footer - 2 * Theme.margin - Theme.gap;
    property <int> across: SetlistState.grid ? SetlistState.columns : 1;
    property <int> down: SetlistState.grid ? SetlistState.rows : max(1, floor((slots-height + gap) / (slot-row + gap)));
    property <length> cell-width: (slots-width - (across - 1) * gap) / across;
    property <length> cell-height: SetlistState.grid ? (slots-height - (down - 1) * gap) / down : slot-row;
    // The sizes setlist.rs pages by: settled whenever the screen's size or the setlist's display changes.
    changed down => { SetlistState.slots-per-view = across * down; SetlistState.resized(); }
    changed across => { SetlistState.slots-per-view = across * down; SetlistState.resized(); }
    changed height => { SetlistState.list-rows = max(1, floor((self.height - 2 * Theme.margin + gap) / (row-height + gap))); SetlistState.resized(); }
    init => {
        SetlistState.slots-per-view = across * down;
        SetlistState.list-rows = max(1, floor((self.height - 2 * Theme.margin + gap) / (row-height + gap)));
    }

    for row[i] in SetlistState.setlists: Section {
        x: Theme.margin;
        y: Theme.margin + i * (root.row-height + root.gap);
        width: root.list-width;
        height: root.row-height;
        fill: row.shown ? Theme.raised : Theme.surface;
        Text {
            x: Theme.pad-wide;
            width: parent.width - 2 * Theme.pad-wide;
            vertical-alignment: center;
            overflow: elide;
            font-size: Theme.body;
            font-weight: row.shown ? 700 : 400;
            color: Theme.text;
            text: row.name;
        }
        TouchArea {
            clicked => { SetlistState.tapped-setlist(i); }
        }
        Cursor {
            shown: row.cursor;
        }
    }

    for slot[i] in SetlistState.slots: Section {
        property <color> base: slot.playing ? Theme.raised : Theme.surface;
        property <bool> odd: !SetlistState.grid && mod(i, 2) == 1;
        property <color> lifted: Theme.row-base(self.base, self.odd);
        x: root.slots-x + mod(i, root.across) * (root.cell-width + root.gap);
        y: Theme.margin + floor(i / root.across) * (root.cell-height + root.gap);
        width: root.cell-width;
        height: root.cell-height;
        // The item's color where the theme puts it (drawListRow): the whole slot, or a mark in it.
        fill: slot.empty ? Theme.background : slot.tinted && Theme.rows == RowStyle.fill ? Theme.row-fill(slot.tint, self.lifted, Theme.text, self.odd) : self.lifted;
        RowMark {
            tint: slot.tint;
            shown: slot.tinted && !slot.empty;
        }
        // The slot playing: an accent edge on its left; the cursor: a focus border round it.
        if slot.playing: Rectangle {
            x: 0;
            width: Theme.mark;
            background: Theme.accent;
            border-radius: Theme.section-radius;
        }
        if !slot.empty: Text {
            x: Theme.pad-wide + Theme.pad-tight / 2;
            y: Theme.pad-tight + Theme.pad-tight / 2;
            text: slot.number;
            color: Theme.muted;
            font-size: Theme.small;
            font-weight: 700;
        }
        if !slot.empty: Text {
            x: SetlistState.grid ? Theme.pad-wide + Theme.pad-tight / 2 : root.number-column;
            width: parent.width - self.x - Theme.pad;
            height: parent.height;
            text: slot.note == "" ? slot.title : slot.title + "\n" + slot.note;
            color: slot.opens ? Theme.text : Theme.muted;
            font-size: SetlistState.grid ? Theme.title : Theme.body;
            font-weight: slot.playing ? 700 : 400;
            wrap: word-wrap;
            overflow: elide;
            horizontal-alignment: SetlistState.grid ? center : left;
            vertical-alignment: center;
        }
        if slot.opening: Loading {
            x: Theme.pad-wide;
            y: parent.height - self.height - Theme.pad-tight;
            width: parent.width - 2 * Theme.pad-wide;
        }
        TouchArea {
            clicked => { SetlistState.tapped-slot(i); }
        }
        Cursor {
            shown: slot.cursor;
        }
    }

    Text {
        x: root.slots-x;
        y: root.height - root.footer - Theme.margin;
        width: root.slots-width * 0.55;
        height: root.line;
        overflow: elide;
        font-size: Theme.small;
        color: Theme.muted;
        text: SetlistState.message;
    }
    // Which page of the setlist the slots are, and which of its slots.
    Text {
        x: root.slots-x + root.slots-width * 0.55;
        y: root.height - root.footer - Theme.margin;
        width: root.slots-width * 0.45;
        height: root.line;
        horizontal-alignment: right;
        overflow: elide;
        font-size: Theme.small;
        color: Theme.muted;
        text: SetlistState.page + "   " + SetlistState.view;
    }
    HorizontalLayout {
        x: root.slots-x;
        y: root.height - Theme.margin - Theme.touch;
        width: root.slots-width;
        height: Theme.touch;
        spacing: Theme.gap;
        Button {
            text: "Previous";
            enabled: SetlistState.can-previous;
            clicked => { SetlistState.step(-1); }
        }
        Button {
            text: "Next";
            enabled: SetlistState.can-next;
            clicked => { SetlistState.step(1); }
        }
        Button {
            text: "Play";
            clicked => { SetlistState.play(); }
        }
    }
}
