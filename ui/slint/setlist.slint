// SPDX-License-Identifier: AGPL-3.0-or-later
// The Setlist screen (src/setlist.rs): under the top bar one row, the setlist bar, a quarter taller than a touch
// target (the setlists' dropdown and the open setlist's banks' dropdown, sharing the room equally, then Previous and
// Next at the right end, which show the bank before or after); under it the shown bank's slots over the whole width,
// a view of them at a time (a grid as the setlist's display says, or a list). A slot's color is its whole box, its
// text black or white on it. The cursor is a border, on a stop of the bar or on a slot; the slot playing is marked
// apart from it.

import { Theme, Section, Button, Field, Cursor } from "theme.slint";
import { Loading } from "loading.slint";

// A stop of the setlist bar: a dropdown (what it shows now; a press opens its list) or a button.
export struct BarStop {
    text: string,
    drop: bool,
    enabled: bool,
    cursor: bool,
}

export struct SlotData {
    number: int,
    title: string,
    note: string, // why it does not open: a placeholder, not in the library
    tint: color, // its own color: the whole box
    tinted: bool,
    ink: color, // black or white, whichever reads better on the tint
    phfill: color, // a placeholder's box: its color at the theme's disabled strength over the surface
    placeholder: bool,
    empty: bool,
    opens: bool,
    playing: bool,
    opening: bool, // the engine is opening it now: a bar along the tile's foot
    cursor: bool,
}

// What the Setlist shows, set by setlist.rs.
export global SetlistState {
    in property <[BarStop]> bar;
    in property <[SlotData]> slots;
    in property <string> name;
    in property <int> count; // the slots of the bank shown
    in property <string> view; // which of them show: "1–12 of 30", drawn when they are not all in view
    in property <bool> grid;
    in property <int> columns: 4;
    in property <int> rows: 3;
    // How many slots the screen holds: set by the screen.
    in-out property <int> slots-per-view: 1;
    callback tapped-slot(int);
    callback tapped-stop(int);
    callback resized(); // the view's size changed (the window, or the theme's paddings): shown again
}

export component Setlist inherits Rectangle {
    // The sections' gap (none in a theme whose sections join); a list view's slot is a touch target and a margin over
    // and under it high, and its number has a touch target and the paddings.
    property <length> gap: Theme.gap-between(Theme.gap);
    property <length> number-column: Theme.touch + 2 * Theme.pad;
    property <length> slot-row: Theme.touch + 2 * Theme.margin;
    // The bar: Previous and Next the theme's small button at the right end, the two dropdowns halves of the rest.
    property <length> row-width: self.width - 2 * Theme.margin;
    property <length> step-width: Theme.button-width;
    property <length> drop-width: (root.row-width - 2 * root.step-width - 3 * Theme.margin) / 2;
    property <length> slots-y: Theme.margin + Theme.tall-row + Theme.gap;
    // The line under the slots that says which of the bank's show: only when they are not all in view.
    property <length> room: self.height - slots-y - Theme.margin;
    property <length> line: Theme.footer(true);
    property <bool> long: SetlistState.count > (SetlistState.grid ? SetlistState.columns * SetlistState.rows : max(1, floor((room + gap) / (slot-row + gap))));
    property <length> slots-height: root.long ? room - line - Theme.gap : room;
    property <int> across: SetlistState.grid ? SetlistState.columns : 1;
    property <int> down: SetlistState.grid ? SetlistState.rows : max(1, floor((slots-height + gap) / (slot-row + gap)));
    property <length> cell-width: (row-width - (across - 1) * gap) / across;
    property <length> cell-height: SetlistState.grid ? (slots-height - (down - 1) * gap) / down : slot-row;
    // The size setlist.rs pages by: settled whenever the screen's size or the setlist's display changes.
    changed down => { SetlistState.slots-per-view = across * down; SetlistState.resized(); }
    changed across => { SetlistState.slots-per-view = across * down; SetlistState.resized(); }
    init => {
        SetlistState.slots-per-view = across * down;
    }
    // A tile's name: the display size, then two steps down; each size's line, the list's headline's, the note's, and
    // the band the number has at the tile's top.
    property <length> s0: Theme.display;
    property <length> s1: Theme.display * 0.8;
    property <length> s2: Theme.display * 0.65;
    property <length> lh0: l0.preferred-height;
    property <length> lh1: l1.preferred-height;
    property <length> lh2: l2.preferred-height;
    property <length> lhl: ll.preferred-height;
    property <length> small-line: ls.preferred-height;
    property <length> band: ln.preferred-height + 2 * Theme.pad-tight;
    l0 := Text { visible: false; text: "X"; font-size: root.s0; font-weight: 700; }
    l1 := Text { visible: false; text: "X"; font-size: root.s1; font-weight: 700; }
    l2 := Text { visible: false; text: "X"; font-size: root.s2; font-weight: 700; }
    ll := Text { visible: false; text: "X"; font-size: Theme.headline; font-weight: 700; }
    ls := Text { visible: false; text: "X"; font-size: Theme.small; }
    ln := Text { visible: false; text: "0"; font-size: Theme.body; font-weight: 700; }

    for stop[i] in SetlistState.bar: Rectangle {
        x: Theme.margin + min(i, 2) * (root.drop-width + Theme.margin) + max(0, i - 2) * (root.step-width + Theme.margin);
        y: Theme.margin;
        width: stop.drop ? root.drop-width : root.step-width;
        height: Theme.tall-row;
        accessible-role: button;
        accessible-label: stop.text;
        accessible-enabled: stop.enabled;
        if stop.drop: Field {
            opacity: stop.enabled ? 1 : Theme.disabled;
            Text {
                x: Theme.pad;
                width: parent.width - 2 * Theme.pad - Theme.icon;
                height: parent.height;
                vertical-alignment: center;
                overflow: elide;
                font-size: Theme.title;
                color: Theme.text;
                text: stop.text;
            }
            Image {
                x: parent.width - Theme.pad - self.width;
                y: (parent.height - self.height) / 2;
                width: Theme.icon * 0.7;
                height: Theme.icon * 0.7;
                source: @image-url("icons/chevron-down.svg");
                colorize: Theme.muted;
            }
            TouchArea {
                enabled: stop.enabled;
                clicked => { SetlistState.tapped-stop(i); }
            }
        }
        if !stop.drop: Button {
            text: stop.text;
            size: Theme.title;
            enabled: stop.enabled;
            clicked => { SetlistState.tapped-stop(i); }
        }
        Cursor {
            corner: stop.drop ? Theme.field-radius(parent.height) : Theme.button-radius(parent.height);
            shown: stop.cursor;
        }
    }

    for slot[i] in SetlistState.slots: Section {
        property <color> base: slot.playing ? Theme.raised : Theme.surface;
        property <bool> odd: !SetlistState.grid && mod(i, 2) == 1;
        // What is written on the box: a placeholder the ink chosen for it (the theme's secondary where it reads on the
        // box), on its own color the ink that reads on it, else the theme's.
        property <color> ink: slot.placeholder ? slot.ink : slot.tinted ? slot.ink : slot.opens ? Theme.text : Theme.muted;
        x: Theme.margin + mod(i, root.across) * (root.cell-width + root.gap);
        y: root.slots-y + floor(i / root.across) * (root.cell-height + root.gap);
        width: root.cell-width;
        height: root.cell-height;
        fill: slot.empty ? Theme.background : slot.placeholder ? slot.phfill : slot.tinted ? slot.tint : Theme.row-base(self.base, self.odd);
        // The slot playing: an edge on its left (the accent; on a colored box its ink, which no color hides), its number
        // on a filled chip on a colored box, and its name bold. The cursor: a focus border round it.
        if slot.playing && !slot.tinted: Rectangle {
            x: 0;
            width: Theme.mark;
            background: Theme.accent;
            border-radius: Theme.section-radius;
        }
        // On a colored box the edge is a bar of its ink set inside it (inside the cursor's lines), the color round it.
        if slot.playing && slot.tinted: Rectangle {
            x: Theme.cursor-width + Theme.hair;
            y: self.x;
            width: Theme.mark;
            height: parent.height - 2 * self.y;
            background: slot.ink;
            border-radius: Theme.inner(self.x);
        }
        if !slot.empty: Rectangle {
            x: Theme.pad-wide - Theme.pad-tight / 2;
            y: SetlistState.grid ? Theme.pad-tight : (parent.height - self.height) / 2;
            width: number.preferred-width + 2 * Theme.pad-tight;
            height: number.preferred-height + Theme.pad-tight;
            border-radius: Theme.scaled-radius(self.height);
            background: slot.playing && slot.tinted ? slot.ink : transparent;
            number := Text {
                x: Theme.pad-tight;
                y: Theme.pad-tight / 2;
                text: slot.number;
                color: slot.tinted ? (slot.playing ? slot.tint : slot.ink) : Theme.muted;
                font-size: Theme.body;
                font-weight: 700;
            }
        }
        // A tile's name: under the number's band, the display size on up to two lines (broken at a word, then cut), a
        // step smaller only when the name does not fit the lines the tile has; the note (why it does not open) small at its foot.
        if !slot.empty && SetlistState.grid: Rectangle {
            property <length> note-h: slot.note == "" ? 0px : root.small-line;
            property <color> ink: parent.ink;
            x: Theme.pad;
            y: root.band;
            width: parent.width - 2 * Theme.pad;
            height: parent.height - root.band - Theme.pad-tight - self.note-h;
            f0 := Text { visible: false; width: parent.width; wrap: word-wrap; text: slot.title; font-size: root.s0; font-weight: 700; }
            f1 := Text { visible: false; width: parent.width; wrap: word-wrap; text: slot.title; font-size: root.s1; font-weight: 700; }
            f2 := Text { visible: false; width: parent.width; wrap: word-wrap; text: slot.title; font-size: root.s2; font-weight: 700; }
            // What the name needs at the size chosen; a size is a step smaller when the name does not fit the tile's
            // height or two lines there; the text shows up to two of its wrapped lines, cut after that.
            property <length> need: self.step == 0 ? f0.preferred-height : self.step == 1 ? f1.preferred-height : f2.preferred-height;
            property <int> step: f0.preferred-height <= min(self.height, 2 * root.lh0) + Theme.hair ? 0 : f1.preferred-height <= min(self.height, 2 * root.lh1) + Theme.hair ? 1 : 2;
            property <length> lh: self.step == 0 ? root.lh0 : self.step == 1 ? root.lh1 : root.lh2;
            tile-name := Text {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: min(parent.need, min(parent.height, 2 * parent.lh * 1.1));
                text: slot.title;
                color: parent.ink;
                font-size: parent.step == 0 ? root.s0 : parent.step == 1 ? root.s1 : root.s2;
                font-weight: slot.playing ? 700 : 500;
                wrap: word-wrap;
                overflow: elide;
                horizontal-alignment: center;
                vertical-alignment: top;
            }
            if slot.note != "": Text {
                y: tile-name.y + tile-name.height;
                width: parent.width;
                height: parent.note-h;
                text: slot.note;
                color: parent.ink;
                font-size: Theme.small;
                overflow: elide;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        // A list row's name: one line of the headline size, cut when it is longer; the note small under it.
        if !slot.empty && !SetlistState.grid: Rectangle {
            property <length> note-h: slot.note == "" ? 0px : root.small-line;
            property <color> ink: parent.ink;
            x: root.number-column;
            width: parent.width - self.x - Theme.pad;
            Text {
                y: (parent.height - self.height - parent.note-h) / 2;
                width: parent.width;
                height: root.lhl;
                text: slot.title;
                color: parent.ink;
                font-size: Theme.headline;
                font-weight: slot.playing ? 700 : 500;
                overflow: elide;
                vertical-alignment: center;
            }
            if slot.note != "": Text {
                y: (parent.height + root.lhl - parent.note-h) / 2;
                width: parent.width;
                height: parent.note-h;
                text: slot.note;
                color: parent.ink;
                font-size: Theme.small;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        if slot.opening: Loading {
            x: Theme.pad-wide;
            y: parent.height - self.height - Theme.pad-tight;
            width: parent.width - 2 * Theme.pad-wide;
        }
        TouchArea {
            clicked => { SetlistState.tapped-slot(i); }
        }
        // On a colored box the cursor has a second line inside it in the box's ink: the focus color alone could be the box's.
        if slot.cursor && slot.tinted && !Theme.bar-cursor: Rectangle {
            x: Theme.cursor-width;
            y: Theme.cursor-width;
            width: parent.width - 2 * Theme.cursor-width;
            height: parent.height - 2 * Theme.cursor-width;
            border-radius: Theme.inner(Theme.cursor-width);
            border-width: Theme.hair;
            border-color: slot.ink;
        }
        Cursor {
            shown: slot.cursor;
        }
    }
    if root.long: Text {
        x: Theme.margin;
        y: root.slots-y + root.down * (root.cell-height + root.gap) - root.gap + Theme.gap;
        width: root.row-width;
        height: root.line;
        vertical-alignment: center;
        overflow: elide;
        font-size: Theme.small;
        color: Theme.muted;
        text: SetlistState.view;
    }
}
