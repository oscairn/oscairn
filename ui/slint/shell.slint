// SPDX-License-Identifier: AGPL-3.0-or-later
// The shell's window: the top bar, the screen shown under it, and the engine's state when it is
// busy or gone. Keys go to shell.rs, which makes navigation actions of them.

import { Theme, Section, ButtonStyle, EdgeStyle, DepthStyle, SliderStyle, TabStyle, MarkStyle, SectionStyle, RowStyle } from "theme.slint";
import { Bar, BarAction, TopBar } from "topbar.slint";
import { Home, HomeState, TileData } from "home.slint";
import { Setlist, SetlistState, SlotData, ListRow } from "setlist.slint";
import { Play, PlayState, SceneData, StripData, KnobButton } from "play.slint";
import { Part, PartState, SettingData, InfoLine } from "part.slint";
import { Parts, PartsState, PartRowData, ChipData, SendData, ToolData } from "parts.slint";
import { Grid, GridState, GridTile, GridCard, GridHeading, GridPanel, GridPoint } from "grid.slint";
import { Keyboard, KeyboardState, KeyData } from "keyboard.slint";
import { Piano, PianoState, PianoKey, PianoBand, PianoControl } from "piano.slint";
export { Theme, ButtonStyle, EdgeStyle, DepthStyle, SliderStyle, TabStyle, MarkStyle, SectionStyle, RowStyle, Bar, BarAction, HomeState, TileData, SetlistState, SlotData, ListRow, PlayState, SceneData, StripData, KnobButton, PartState, SettingData, InfoLine, PartsState, PartRowData, ChipData, SendData, ToolData, KeyboardState, KeyData, PianoState, PianoKey, PianoBand, PianoControl, GridState, GridTile, GridCard, GridHeading, GridPanel, GridPoint }

export component Shell inherits Window {
    title: "Oscairn";
    preferred-width: 1280px;
    preferred-height: 720px;
    background: Theme.background;
    default-font-family: Theme.font-family;
    // Empty while the engine answers; else what is wrong ("busy 3.2 s", "lost: ...").
    in property <string> engine;
    // The screen shown: 0 Home; 1 Setlist; 2 a JUCE screen opening; 3 Play, 4 Part, 5 chain, 6 sounds, 7 a grid page, 8 a scene's setup, 9 the Parts list (`opening` names a JUCE screen).
    in property <int> screen;
    in property <string> opening;
    in property <bool> hands-over; // false: this shell cannot hand the display over (a computer)
    callback key(string) -> bool; // a key's text; true when it was taken
    callback key-released(string);
    out property <length> resources-x: bar.resources-x;
    out property <length> resources-width: bar.resources-width;
    out property <length> tempo-x: bar.tempo-x;
    out property <int> home-columns: home.columns;

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (root.key(event.text)) { return accept; }
            return reject;
        }
        key-released(event) => {
            root.key-released(event.text);
            return reject;
        }
    }
    bar := TopBar {
        y: 0;
        width: parent.width;
    }
    home := Home {
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
        visible: root.screen == 0;
    }
    Setlist {
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
        visible: root.screen == 1;
    }
    Play {
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
        visible: root.screen == 3;
    }
    Part {
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
        visible: (root.screen >= 4 && root.screen <= 6) || root.screen == 8;
    }
    Parts {
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
        visible: root.screen == 9;
    }
    Grid {
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
        visible: root.screen == 7;
    }
    if root.screen == 2: Text {
        y: Theme.bar-height;
        height: parent.height - Theme.bar-height;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: Theme.title;
        color: Theme.muted;
        text: root.hands-over ? "Opening " + root.opening + "..." : root.opening + " is not in this UI yet: open it in the Oscairn app. Escape goes back.";
    }
    if KeyboardState.open: Keyboard {
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
    }
    if PianoState.open: Piano {
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
    }
    if root.engine != "": Section {
        x: Theme.margin;
        y: Theme.bar-height + Theme.gap;
        width: parent.width - 2 * Theme.margin;
        height: Theme.touch;
        fill: Theme.danger;
        Text {
            x: Theme.pad-wide;
            width: parent.width - 2 * Theme.pad-wide;
            vertical-alignment: center;
            overflow: elide;
            font-size: Theme.body;
            color: Theme.background;
            text: "Engine " + root.engine;
        }
    }
}
