// SPDX-License-Identifier: AGPL-3.0-or-later
// The shell's window: the top bar, the screen shown under it, and the engine's state when it is
// busy or gone. Keys go to shell.rs, which makes navigation actions of them.

import { Theme, Section, ButtonStyle, EdgeStyle, DepthStyle, SliderStyle, TabStyle, TabPlacement, TabLabel, MarkStyle, SectionStyle, RowStyle } from "theme.slint";
import { Bar, BarAction, TopBar } from "topbar.slint";
import { Home, HomeState, TileData } from "home.slint";
import { Setlist, SetlistState, SlotData, ListRow } from "setlist.slint";
import { Play, PlayState, SceneData, StripData, KnobButton, PlayLayout } from "play.slint";
import { Part, PartState, SettingData, InfoLine } from "part.slint";
import { StripState, StripKey } from "strip.slint";
import { Parts, PartsState, PartRowData, ChipData, SendData, ToolData } from "parts.slint";
import { Mixer, MixerState, MixStrip } from "mixer.slint";
import { Controls, ControlsState, ControlRowData, TableRowData, TableCellData, ControlToolData } from "controls.slint";
import { Menu, MenuState, MenuRow } from "menu.slint";
import { Routing, RoutingState, RoutingBox, RoutingWire, RoutingLink, PanelCellData, PanelRowData } from "routing.slint";
import { Grid, GridState, GridTile, GridCard, GridHeading, GridPanel, GridPoint } from "grid.slint";
import { Keyboard, KeyboardState, KeyData } from "keyboard.slint";
import { Piano, PianoState, PianoKey, PianoBand, PianoControl } from "piano.slint";
import { Library, LibraryState } from "library.slint";
import { Settings, SettingsState } from "settings.slint";
import { Notice, NoticeState } from "notice.slint";
export { Theme, ButtonStyle, EdgeStyle, DepthStyle, SliderStyle, TabStyle, TabPlacement, TabLabel, MarkStyle, SectionStyle, RowStyle, Bar, BarAction, HomeState, TileData, SetlistState, SlotData, ListRow, PlayState, SceneData, StripData, KnobButton, PlayLayout, PartState, SettingData, InfoLine, PartsState, PartRowData, ChipData, SendData, ToolData, MixerState, MixStrip, ControlsState, ControlRowData, TableRowData, TableCellData, ControlToolData, MenuState, MenuRow, RoutingState, RoutingBox, RoutingWire, RoutingLink, PanelCellData, PanelRowData, KeyboardState, KeyData, StripState, StripKey, PianoState, PianoKey, PianoBand, PianoControl, GridState, GridTile, GridCard, GridHeading, GridPanel, GridPoint, LibraryState, NoticeState, SettingsState }

export component Shell inherits Window {
    title: "Oscairn";
    preferred-width: 1280px;
    preferred-height: 720px;
    background: Theme.background;
    default-font-family: Theme.font-family;
    // Empty while the engine answers; else what is wrong ("busy 3.2 s", "lost: ...").
    in property <string> engine;
    // The screen shown: 0 Home; 1 Setlist; 2 a JUCE screen opening; 3 Play, 4 Part, 5 chain, 6 sounds, 7 a grid page, 8 a scene's setup, 9 the Parts list, 10 the Mixer, 11 the Controls page, 12 Routing, 13 the Library, 14 the Settings app (`opening` names a JUCE screen).
    in property <int> screen;
    in property <string> opening;
    in property <bool> hands-over; // false: this shell cannot hand the display over (a computer)
    callback key(string) -> bool; // a key's text; true when it was taken
    callback key-released(string);
    out property <length> resources-x: bar.resources-x;
    out property <length> resources-width: bar.resources-width;
    out property <length> tempo-x: bar.tempo-x;
    out property <length> pill-x: bar.pill-x;
    out property <length> pill-width: bar.pill-width;
    out property <string> title-shown: bar.title-shown;
    out property <bool> title-shrunk: bar.title-shrunk;
    out property <bool> title-cut: bar.title-cut;
    out property <length> rec-width: bar.rec-width;
    out property <int> actions-mode: bar.actions-mode;
    out property <int> meters-mode: bar.meters-mode;
    out property <int> home-columns: home.columns;

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (root.key(event.text)) { return accept; }
            return reject;
        }
        key-released(event) => {
            root.key-released(event.text);
            return reject;
        }
    }
    bar := TopBar {
        y: 0;
        width: parent.width;
    }
    home := Home {
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
        visible: root.screen == 0;
    }
    Setlist {
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
        visible: root.screen == 1;
    }
    Play {
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
        visible: root.screen == 3;
    }
    // The Library's tabs, and the shared list screen in the area they leave.
    library := Library {
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
        visible: root.screen == 13;
    }
    // The Settings app's tabs, the same way.
    settings := Settings {
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
        visible: root.screen == 14;
    }
    Part {
        x: root.screen == 14 ? settings.content-x - Theme.margin : root.screen == 13 ? library.content-x - Theme.margin : 0px;
        y: Theme.bar-height + (root.screen == 14 ? settings.content-y - Theme.margin : root.screen == 13 ? library.content-y - Theme.margin : 0px);
        width: root.screen == 14 ? settings.content-width + 2 * Theme.margin : root.screen == 13 ? library.content-width + 2 * Theme.margin : parent.width;
        height: root.screen == 14 ? settings.content-height + 2 * Theme.margin : root.screen == 13 ? library.content-height + 2 * Theme.margin : parent.height - Theme.bar-height;
        visible: (root.screen >= 4 && root.screen <= 6) || root.screen == 8 || root.screen == 13 || root.screen == 14;
    }
    Parts {
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
        visible: root.screen == 9;
    }
    Mixer {
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
        visible: root.screen == 10;
    }
    Controls {
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
        visible: root.screen == 11;
    }
    Routing {
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
        visible: root.screen == 12;
    }
    Grid {
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
        visible: root.screen == 7;
    }
    if root.screen == 2: Text {
        y: Theme.bar-height;
        height: parent.height - Theme.bar-height;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: Theme.title;
        color: Theme.muted;
        text: root.hands-over ? "Opening " + root.opening + "..." : root.opening + " is not in this UI yet: open it in the Oscairn app. Escape goes back.";
    }
    // The screen above the overlay takes no touch while the keyboard is open.
    if KeyboardState.open: TouchArea {
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
    }
    if KeyboardState.open: Keyboard {
        width: parent.width;
        height: KeyboardState.keys-shown ? min(KeyboardState.overlay-height, parent.height - Theme.bar-height) : parent.height - Theme.bar-height;
        y: parent.height - self.height;
    }
    if PianoState.open: Piano {
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
    }
    if MenuState.open: Menu {
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
    }
    if NoticeState.open: Notice {
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
    }
    if root.engine != "": Section {
        x: Theme.margin;
        y: Theme.bar-height + Theme.gap;
        width: parent.width - 2 * Theme.margin;
        height: Theme.touch;
        fill: Theme.danger;
        Text {
            x: Theme.pad-wide;
            width: parent.width - 2 * Theme.pad-wide;
            vertical-alignment: center;
            overflow: elide;
            font-size: Theme.body;
            color: Theme.background;
            text: "Engine " + root.engine;
        }
    }
}
