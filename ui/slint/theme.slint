// SPDX-License-Identifier: AGPL-3.0-or-later
// The theme the screens draw with: everything a theme file can set (docs/theme.schema.json, the JUCE
// app's hosts/standalone/Theme.cpp, ui/THEME.md), set by theme.rs from the chosen theme.json; the
// values here are only what shows before that, the default built-in theme's. A screen draws
// nothing from a literal color, corner, edge or stroke: it asks this file. The `Theme` global is
// per window (every Shell has its own), never process-wide.
//
// What a theme has no property for lives here once, as named constants (sizes of touch targets and
// gaps, the type scale, alphas): see "no theme property" in THEME.md.
//
// Shared pieces drawn by the theme's style choices: Section (a card, a tile), Button, Field (a
// dropdown or value box), Mark (mute, solo), Thumb (sliders, knobs), TabStrip, RowMark (where an
// item's color goes in a list row).

// The built-in themes' font (Inter, SIL OFL 1.1: hosts/standalone/themes/*/fonts/OFL.txt), for
// when the theme's own font files cannot be read.
import "../../hosts/standalone/themes/oscairn-dark/fonts/Inter-Regular.ttf";
import "../../hosts/standalone/themes/oscairn-dark/fonts/Inter-Bold.ttf";

// The eight `style` choices, in the reference's order (ThemeStyle).
export enum ButtonStyle { rounded, pill }
export enum EdgeStyle { none, hairline, outlined }
export enum DepthStyle { flat, soft }
export enum SliderStyle { filled, line, cap }
export enum TabStyle { folder, segmented }
// Where two levels of tabs go on a screen: two strips (top), two columns at the left (side), or by the window's height (auto).
export enum TabPlacement { auto, top, side }
export enum MarkStyle { square, round }
export enum SectionStyle { separate, joined }
export enum RowStyle { left, right, dot, fill }

export global Theme {
    // Colors by role.
    in property <color> background: #111317;
    in property <color> surface: #1D2127;
    in property <color> raised: #2D333B;
    in property <color> border: #4A535E;
    in property <color> text: #F6F8FA;
    in property <color> muted: #B4BDC8;
    in property <color> accent: #FF9A45;
    in property <color> positive: #5AD9A4;
    in property <color> danger: #FF6B63;
    // A meter past three quarters (the JUCE meters' yellow unless the theme says).
    in property <color> warning: #e8c547;
    // The cursor's border (the accent unless the theme says).
    in property <color> focus: accent;
    // Tabs (src/palette.rs `tabs`): the selected tab's fill and its text, an unselected tab's fill and its text.
    in property <color> tab-on: accent;
    in property <color> tab-on-ink: on-accent;
    in property <color> tab-off: raised;
    in property <color> tab-off-ink: muted;
    // Text on the accent (JUCE's `contrasting`): black on a bright accent, white on a dark one.
    in property <color> on-accent: #000000;
    // The FM view's eight operator colors and the text that reads on each (src/palette.rs).
    in property <[color]> operators: [accent, accent, accent, accent, accent, accent, accent, accent];
    in property <[color]> operators-on: [on-accent, on-accent, on-accent, on-accent, on-accent, on-accent, on-accent, on-accent];
    // A background of perceived brightness under one half (JUCE's `darkTheme`).
    in property <bool> dark: true;
    // The lighter and the darker of the text and surface colors (the piano keys' two inks).
    in property <color> key-light: #F6F8FA;
    in property <color> key-dark: #1D2127;
    // The routing wires.
    in property <color> wire-audio: #8CC2FF;
    in property <color> wire-notes: #C29CFF;
    in property <color> wire-disabled: #6B7480;
    in property <color> wire-draining: #FF9A45;
    in property <color> wire-unconnected: #FF6B63;
    in property <color> wire-control: #6FE0A8;
    // The splash: the theme's image if it has one, the colors behind it and of its text.
    in property <color> splash-background: background;
    in property <color> splash-ink: text;
    in property <image> splash-image;
    in property <bool> has-splash-image;
    // Metrics and the font.
    in property <length> radius: 6px;
    in property <float> font-scale: 1;
    // A scale on the paddings and gaps below (the theme's `spacing`).
    in property <float> spacing: 1;
    in property <string> font-family: "Inter";
    // How controls are drawn.
    in property <ButtonStyle> buttons: ButtonStyle.pill;
    in property <EdgeStyle> edges: EdgeStyle.hairline;
    in property <DepthStyle> depth: DepthStyle.soft;
    in property <SliderStyle> sliders: SliderStyle.line;
    in property <TabStyle> tabs: TabStyle.segmented;
    in property <TabPlacement> tab-placement: TabPlacement.auto;
    in property <MarkStyle> marks: MarkStyle.square;
    in property <SectionStyle> sections: SectionStyle.separate;
    in property <RowStyle> rows: RowStyle.left;
    // A list row's color blended into its background, as much as text still reads on it (theme.rs).
    // Arguments: the row's own color, its background, the text's color, whether it is an odd row.
    pure callback row-fill(color, color, color, bool) -> color;
    // Not a theme setting but the window's state: the top bar has the cursor, so no screen draws its
    // own (only one cursor shows); set by the shell, never by a theme.
    in-out property <bool> bar-cursor: false;

    // The type scale: the JUCE touch scale (Theme.cpp `textSize`) times the font scale.
    out property <length> small: 13px * font-scale;
    out property <length> body: 16px * font-scale;
    out property <length> button: 15px * font-scale;
    out property <length> title: 20px * font-scale;
    // Sizes with no theme property: touch targets (RFC 0019).
    out property <length> bar-height: 48px;
    out property <length> touch: 44px;
    // Paddings and gaps, times the theme's spacing: the dense gap and margin (Theme.h), then the
    // insides: text from an edge, a card's padding, a control's inset, a tight inset.
    out property <length> gap: 4px * spacing;
    out property <length> margin: 6px * spacing;
    out property <length> pad: 10px * spacing;
    out property <length> pad-wide: 12px * spacing;
    out property <length> pad-narrow: 8px * spacing;
    out property <length> pad-tight: 4px * spacing;
    // A small button's width ("Back", "Previous") and the dropdown overlay's width.
    out property <length> button-width: 110px;
    out property <length> overlay-width: 420px;
    // A rail of tabs (the side placement, ui/TABS.md): fixed by the type and the spacing, five of the small type's size
    // and one and a half tight paddings across (71 at the touch scale), never more than a share of the screen's width.
    out property <length> rail-width: 5 * small + 1.5 * pad-tight;
    out property <float> side-share: 0.12;
    // A cursor's border and a cursor on the piano keys; the rule between neighbors.
    out property <length> cursor-width: 2px;
    out property <length> key-cursor-width: 3px;
    out property <length> hair: 1px;
    // A tab's fill from its box: room for the cursor's ring and a hair of gap.
    out property <length> tab-pad: cursor-width + hair;
    // A graph view's thin line (an operator's envelope, a routing wire) and a handle's diameter.
    out property <length> thin: 1.5px;
    out property <length> node: 12px;
    // A slider's thumb (JUCE: radius 8) and a knob's arc stroke.
    out property <length> thumb: 16px;
    out property <length> arc: 6px;
    // A row's color mark (6 wide, rounded by half) and the playing mark's width.
    out property <length> mark: 6px;
    // Alphas of the theme's colors: a selected row's wash, a lit scene's, a track behind a fill, a dimmed part.
    out property <float> wash: 0.25;
    out property <float> wash-light: 0.17;
    out property <float> wash-strong: 0.4; // a key held on, a stop on
    out property <float> track-alpha: 0.35;
    out property <float> dim: 0.45;
    out property <float> disabled: 0.4;
    // Derived as Theme.cpp does for the same things.
    // The piano's keys (Panel.cpp's Board): the two inks blended, a white key lighter on a light theme.
    out property <color> white-key: key-light.mix(key-dark, dark ? 0.74 : 0.94);
    out property <color> black-key: key-light.mix(key-dark, 0.12);
    out property <color> key-label: key-light.mix(key-dark, 0.35);
    out property <color> white-key-lit: accent.with-alpha(0.5);
    out property <color> black-key-lit: accent.darker(0.3);
    // A text keyboard's key: the surface lifted a step.
    out property <color> key-fill: surface.brighter(0.15);
    out property <length> key-radius: 4px; // a piano key's corners (Panel.cpp: 4 white, 3 black)
    out property <length> section-radius: sections == SectionStyle.joined ? 0px : radius + 2px; // drawSection
    out property <color> wash-color: accent.with-alpha(wash);
    out property <color> track: border.with-alpha(track-alpha);
    out property <color> rule: border.with-alpha(0.6);
    out property <color> accent-dim: accent.with-alpha(0.75); // a fill when not under the cursor
    out property <color> thumb-edge: border.with-alpha(0.8);
    out property <color> keys-white: text.with-alpha(0.75); // a key map's keys
    out property <color> zone-faint: muted.with-alpha(0.1); // a key map's zone that is not the one shown
    out property <color> scrim: background.with-alpha(0.7); // behind an open list
    // A rotary's disc and its pointer by the slider style (drawRotarySlider).
    out property <color> knob-disc: sliders == SliderStyle.filled ? raised : #ffffff;
    out property <color> knob-pointer: sliders == SliderStyle.filled ? text : background;
    out property <color> track-line: border.with-alpha(0.55); // a rotary's track, a line slider's
    out property <color> slider-track: sliders == SliderStyle.filled ? border : track-line;
    // drawEdge: nothing, a hairline (the border at 60%) or the border; a cursor is the accent, 2 px.
    out property <length> edge-width: edges == EdgeStyle.none ? 0px : hair;
    out property <color> edge-color: edges == EdgeStyle.outlined ? border : edges == EdgeStyle.hairline ? rule : transparent;
    // A joined section's line is always drawn, in the hairline or the full border.
    out property <color> joined-edge: edges == EdgeStyle.hairline ? rule : border;
    out property <color> shadow: dark ? #000000.with-alpha(0.35) : #000000.with-alpha(0.12);
    out property <color> thumb-shadow: dark ? #000000.with-alpha(0.45) : #000000.with-alpha(0.18);
    out property <length> shadow-offset: depth == DepthStyle.soft ? 1px : 0px;
    // A list row's background: alternate rows lighter (drawListRow).
    pure public function row-base(base: color, odd: bool) -> color {
        return odd ? base.mix(raised, 0.65) : base;
    }
    // The gap between sections: `separate`, or none when they join (sectionGap).
    pure public function gap-between(separate: length) -> length {
        return sections == SectionStyle.joined ? 0px : separate;
    }
    // buttonRadius and fieldRadius.
    pure public function button-radius(height: length) -> length {
        return buttons == ButtonStyle.pill ? height / 2 : radius;
    }
    pure public function field-radius(height: length) -> length {
        return buttons != ButtonStyle.pill ? min(height / 2, radius) : height <= 56px ? height / 2 : radius + 3px;
    }
    // A mark's corner (mute, solo): round, or the radius (at most 6 px and .28 of the side).
    pure public function mark-radius(side: length) -> length {
        return marks == MarkStyle.round ? side / 2 : min(min(6px, side * 0.28), radius);
    }
}

// A section: a card, a tile, a strip (drawSection). Separate: rounded, with the theme's edge.
// Joined: square, its line on the pixel it shares with the neighbors (the reference draws its top
// and left one pixel outside; here its right and bottom, so the outer ones stay inside the area).
export component Section inherits Rectangle {
    in property <color> fill: Theme.surface;
    background: root.fill;
    border-radius: Theme.section-radius;
    border-width: Theme.sections == SectionStyle.joined ? 0px : Theme.edge-width;
    border-color: Theme.edge-color;
    if Theme.sections == SectionStyle.joined: Rectangle {
        // One pixel past the right and bottom: the neighbor's first pixel, so two sections draw one line.
        width: parent.width + Theme.hair;
        height: parent.height + Theme.hair;
        border-width: Theme.hair;
        border-color: Theme.joined-edge;
    }
}

// A text in a box: as drawFittedText with a least scale of 0.7, a text too wide for its box shrinks to 70%
// before it is cut (`cut` says it still does not fit then).
export component FitText inherits Rectangle {
    in property <string> text;
    in property <color> ink: Theme.text;
    in property <length> size: Theme.body;
    in property <bool> bold;
    in property <TextHorizontalAlignment> align: TextHorizontalAlignment.center;
    out property <bool> cut: measure.preferred-width * 0.7 > self.width + 0.5px;
    measure := Text {
        visible: false;
        text: root.text;
        font-size: root.size;
        font-weight: root.bold ? 700 : 400;
    }
    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.ink;
        font-size: root.size * max(0.7, min(1.0, root.width / max(1px, measure.preferred-width)));
        font-weight: root.bold ? 700 : 400;
        horizontal-alignment: root.align;
        vertical-alignment: center;
        overflow: elide;
    }
}

// A cursor or a value being changed: the border round a control, in its own corners.
export component Cursor inherits Rectangle {
    in property <bool> shown;
    in property <bool> editing;
    // Drawn even while the top bar has the cursor: the bar's own, and an overlay's (the keyboards).
    in property <bool> always;
    in property <length> corner: Theme.section-radius;
    in property <length> stroke: Theme.cursor-width;
    property <bool> visible-now: (root.shown || root.editing) && (root.always || !Theme.bar-cursor);
    border-radius: root.corner;
    border-width: root.visible-now ? root.stroke : 0px;
    border-color: root.editing ? Theme.accent : Theme.focus;
}

// A button (drawButtonBackground): the theme's corners (pill or the radius), edge and shadow;
// raised, or the tint when on; brighter under a finger.
export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> on;
    in property <color> tint: Theme.accent;
    in property <color> ink: Theme.text;
    in property <bool> bold: true;
    in property <length> size: Theme.button;
    callback clicked();
    property <color> base: root.on ? root.tint : Theme.raised;
    if Theme.depth == DepthStyle.soft && root.enabled: Rectangle {
        y: Theme.shadow-offset;
        border-radius: Theme.button-radius(root.height);
        background: Theme.shadow;
    }
    Rectangle {
        border-radius: Theme.button-radius(root.height);
        background: !root.enabled ? root.base.with-alpha(Theme.disabled) : touch.pressed ? root.base.brighter(0.15) : touch.has-hover ? root.base.brighter(0.07) : root.base;
        border-width: Theme.edge-width;
        border-color: Theme.edge-color;
    }
    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: !root.enabled ? Theme.muted : root.on ? Theme.on-accent : root.ink;
        font-size: root.size;
        font-weight: root.bold ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A field (fieldRadius, drawEdge): a dropdown, a value box.
export component Field inherits Rectangle {
    in property <color> fill: Theme.surface;
    background: root.fill;
    border-radius: Theme.field-radius(root.height);
    border-width: Theme.edge-width;
    border-color: Theme.edge-color;
}

// Mute and solo (drawMark): a small square or round mark with its letter, filled in its color when on.
export component Mark inherits Rectangle {
    in property <string> letter;
    in property <bool> on;
    in property <color> tint;
    callback clicked();
    property <length> side: min(root.width, root.height);
    Rectangle {
        width: root.side;
        height: root.side;
        border-radius: Theme.mark-radius(root.side);
        background: root.on ? root.tint : Theme.border.with-alpha(0.5);
        Text {
            text: root.letter;
            color: root.on ? Theme.background : Theme.muted;
            font-size: root.side * 0.55;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// A slider's thumb or a knob's disc by the slider style (drawLinearSlider, drawRotarySlider):
// filled, an accent disc; line, a light disc; cap, a short bar across the track. `size` is the
// thumb's diameter; `upright` turns a cap across a vertical track.
export component Thumb inherits Rectangle {
    in property <length> size: 16px;
    in property <bool> upright;
    in property <bool> bar-cap: true; // a cap thumb is a bar (sliders); a knob's disc stays round
    property <bool> cap: Theme.sliders == SliderStyle.cap && root.bar-cap;
    property <length> w: root.cap ? (root.upright ? root.size * 1.375 : root.size * 0.625) : root.size;
    property <length> h: root.cap ? (root.upright ? root.size * 0.625 : root.size * 1.125) : root.size;
    property <length> corner: root.cap ? min(2px, Theme.radius) : root.size / 2;
    width: root.w;
    height: root.h;
    if Theme.depth == DepthStyle.soft && Theme.sliders != SliderStyle.filled: Rectangle {
        y: 1px;
        border-radius: root.corner;
        background: Theme.thumb-shadow;
    }
    Rectangle {
        border-radius: root.corner;
        background: Theme.sliders == SliderStyle.filled ? Theme.accent : #ffffff;
        border-width: Theme.sliders == SliderStyle.filled ? 0px : Theme.hair;
        border-color: Theme.thumb-edge;
    }
}

// The shell's one family of tabs (ui/TABS.md): TabBar is a row of tabs or a column of them, TabPages the
// two-level arrangement (pages, and under or beside them each page's tabs). Drawn only from the theme: the
// `tabs` style (segmented, a track with the selected tab lifted out of it; folder, tabs joined to the page
// they open), the colors, the radius, the spacing and the type.
//
// The selected tab is told by its fill (Theme.tab-on: 3 to 1 against an unselected tab's fill in every theme,
// src/palette.rs `tabs`), by bold type and by the text color that reads on the fill, never by an outline
// alone. The cursor is a ring round the whole box with a gap between it and the fill.
// A tab's label in a rail: its short form (what its name has that the rail's other names do not: ui/TABS.md) and
// that on two lines (the second empty where there is no space to break at).
export struct TabLabel {
    short: string,
    top: string,
    bottom: string,
}

// A tab's box by the theme's `tabs` style, over the whole of its parent: segmented, the selected one a piece lifted
// out of the track; folder, every tab a piece, rounded at the side away from the page (the top of a row's tabs, the
// left of a column's, rail's included), the selected one reaching the rule and the page past it, the others
// stopping short of it and sitting back. The cursor is a ring round the whole box.
component TabShape inherits Rectangle {
    in property <bool> selected;
    in property <bool> cursor;
    in property <bool> vertical;
    // How far the box goes past the edge the tab's own part ends at: a vertical folder's selected piece reaches over it,
    // to the page it opens, and the ring stays round the tab's own part.
    in property <length> reach;
    property <bool> segmented: Theme.tabs == TabStyle.segmented;
    property <length> inset: Theme.tab-pad;
    // A folder's unselected tab sits back from the edge the selected one reaches.
    property <length> back: 4px;
    if root.segmented && root.selected && Theme.depth == DepthStyle.soft: Rectangle {
        x: root.inset;
        y: root.inset + 1px;
        width: parent.width - 2 * root.inset;
        height: parent.height - 2 * root.inset;
        border-radius: Theme.radius + 1px;
        background: Theme.shadow;
    }
    if root.segmented && root.selected: Rectangle {
        x: root.inset;
        y: root.inset;
        width: parent.width - 2 * root.inset;
        height: parent.height - 2 * root.inset;
        border-radius: Theme.radius + 1px;
        background: Theme.tab-on;
    }
    if !root.segmented && !root.vertical: Rectangle {
        x: root.inset;
        y: root.selected ? root.inset : root.inset + root.back;
        width: parent.width - 2 * root.inset;
        height: (root.selected ? parent.height : parent.height - Theme.hair) - self.y;
        border-top-left-radius: Theme.radius + 1px;
        border-top-right-radius: Theme.radius + 1px;
        background: root.selected ? Theme.tab-on : Theme.tab-off;
        border-width: root.selected ? 0px : Theme.hair;
        border-color: Theme.rule;
    }
    if !root.segmented && root.vertical: Rectangle {
        x: root.selected ? root.inset : root.inset + root.back;
        y: root.inset;
        width: (root.selected ? parent.width : parent.width - root.reach - Theme.hair) - self.x;
        height: parent.height - 2 * root.inset;
        border-top-left-radius: Theme.radius + 1px;
        border-bottom-left-radius: Theme.radius + 1px;
        background: root.selected ? Theme.tab-on : Theme.tab-off;
        border-width: root.selected ? 0px : Theme.hair;
        border-color: Theme.rule;
    }
    Cursor {
        x: 0px;
        y: 0px;
        width: parent.width - root.reach;
        height: parent.height;
        shown: root.cursor;
        corner: Theme.radius + 2px;
    }
}

component TabItem inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> cursor;
    in property <bool> vertical;
    // The tab the strip keeps in view (the cursor's, else the selected one).
    in property <bool> active;
    callback clicked();
    callback reveal();
    property <length> inset: Theme.tab-pad;
    // A row's tab is as wide as its name in bold needs, at most four and a half touch targets; a longer name
    // shrinks to 70% of the type and is then cut (FitText).
    preferred-width: min(Theme.touch * 4.5, max(Theme.touch, probe.preferred-width + 2 * (Theme.pad-wide + Theme.tab-pad)));
    min-width: self.vertical ? 0px : self.preferred-width;
    max-width: self.vertical ? 100000px : self.preferred-width;
    changed active => { if self.active { root.reveal(); } }
    changed x => { if self.active { root.reveal(); } }
    changed y => { if self.active { root.reveal(); } }
    changed width => { if self.active { root.reveal(); } }
    changed height => { if self.active { root.reveal(); } }
    // The name's width in bold; sized apart so that it does not make the tab at least as wide as the name.
    probe := Text {
        visible: false;
        width: 0px;
        height: 0px;
        text: root.text;
        font-size: Theme.button;
        font-weight: 700;
    }
    TabShape {
        selected: root.selected;
        cursor: root.cursor;
        vertical: root.vertical;
    }
    FitText {
        x: root.inset + Theme.pad-wide;
        width: parent.width - 2 * (root.inset + Theme.pad-wide);
        height: parent.height;
        text: root.text;
        ink: root.selected ? Theme.tab-on-ink : Theme.tab-off-ink;
        size: Theme.button;
        bold: root.selected;
        align: root.vertical ? TextHorizontalAlignment.left : TextHorizontalAlignment.center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// The end of a strip that goes on: a box over the tabs cut there with an arrow, a touch scrolls toward them.
component TabMore inherits Rectangle {
    in property <string> glyph;
    in property <bool> last; // at the far end: its rule is on the side facing the tabs
    in property <bool> vertical;
    callback clicked();
    background: Theme.surface;
    Rectangle {
        x: root.vertical ? 0px : root.last ? 0px : parent.width - Theme.hair;
        y: root.vertical ? root.last ? 0px : parent.height - Theme.hair : 0px;
        width: root.vertical ? parent.width : Theme.hair;
        height: root.vertical ? Theme.hair : parent.height;
        background: Theme.rule;
    }
    Text {
        width: parent.width;
        height: parent.height;
        text: root.glyph;
        color: Theme.text;
        font-size: Theme.button;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// What the names of a row of tabs share (the heading), shown once at the start of the row in the dim color, when the
// whole names do not fit the row: a short cell, not a tab.
component TabHeading inherits Rectangle {
    in property <string> text;
    preferred-width: probe.preferred-width + 2 * Theme.pad-wide;
    probe := Text {
        visible: false;
        width: 0px;
        height: 0px;
        text: root.text;
        font-size: Theme.small;
    }
    Text {
        x: Theme.pad-wide;
        width: parent.width - 2 * Theme.pad-wide;
        height: parent.height;
        text: root.text;
        color: Theme.muted;
        font-size: Theme.small;
        vertical-alignment: center;
        overflow: elide;
    }
}

component HTabs inherits Rectangle {
    in property <[string]> names;
    in property <[TabLabel]> labels;
    in property <string> heading;
    in property <int> current;
    in property <int> cursor;
    in property <string> empty-name;
    callback picked(int);
    property <bool> segmented: Theme.tabs == TabStyle.segmented;
    property <int> keep: root.cursor >= 0 ? root.cursor : root.current;
    property <length> more: Theme.touch * 0.6;
    // A row whose whole names do not fit shows what they share once and each tab what differs.
    property <bool> short: root.heading != "" && root.labels.length == root.names.length && whole.preferred-width > root.width + 0.5px;
    property <length> content: row.preferred-width;
    out property <bool> over: root.content > root.width + 0.5px;
    function settle() {
        flick.content-x = min(0px, max(root.width - root.content, flick.content-x));
    }
    function reveal(x: length, w: length) {
        let margin = root.over ? root.more : 0px;
        if (x + flick.content-x < margin) {
            flick.content-x = min(0px, margin - x);
        } else if (x + w + flick.content-x > root.width - margin) {
            flick.content-x = max(root.width - root.content, root.width - margin - x - w);
        }
    }
    changed width => { root.settle(); }
    changed content => { root.settle(); }
    // The row with the whole names, unseen: how wide it would be.
    whole := HorizontalLayout {
        visible: false;
        width: self.preferred-width;
        height: 0px;
        alignment: start;
        for name in root.names: TabItem {
            text: name == "" ? root.empty-name : name;
        }
    }
    if !root.segmented: Rectangle {
        y: parent.height - Theme.hair;
        height: Theme.hair;
        background: Theme.rule;
    }
    flick := Flickable {
        width: parent.width;
        height: parent.height;
        content-width: root.content;
        interactive: root.over;
        if root.segmented: Rectangle {
            x: 0px;
            width: root.content;
            height: parent.height;
            border-radius: Theme.radius + 4px;
            background: Theme.tab-off;
        }
        row := HorizontalLayout {
            x: 0px;
            width: self.preferred-width;
            height: parent.height;
            alignment: start;
            if root.short: TabHeading {
                text: root.heading;
            }
            for name[i] in root.names: TabItem {
                text: root.short ? root.labels[i].short : name == "" ? root.empty-name : name;
                selected: i == root.current;
                cursor: i == root.cursor;
                active: i == root.keep;
                clicked => { root.picked(i); }
                reveal => { root.reveal(self.x, self.width); }
            }
        }
    }
    if root.over && flick.content-x < -0.5px: TabMore {
        x: 0px;
        width: root.more;
        height: parent.height;
        glyph: "‹";
        clicked => { flick.content-x = min(0px, flick.content-x + root.width * 0.7); }
    }
    if root.over && flick.content-x > root.width - root.content + 0.5px: TabMore {
        x: parent.width - root.more;
        width: root.more;
        height: parent.height;
        glyph: "›";
        last: true;
        clicked => { flick.content-x = max(root.width - root.content, flick.content-x - root.width * 0.7); }
    }
}

component VTabs inherits Rectangle {
    in property <[string]> names;
    in property <int> current;
    in property <int> cursor;
    in property <string> empty-name;
    in property <length> item;
    callback picked(int);
    property <bool> segmented: Theme.tabs == TabStyle.segmented;
    property <int> keep: root.cursor >= 0 ? root.cursor : root.current;
    property <length> more: Theme.touch * 0.6;
    property <length> content: root.names.length * root.item;
    out property <bool> over: root.content > root.height + 0.5px;
    function settle() {
        flick.content-y = min(0px, max(root.height - root.content, flick.content-y));
    }
    function reveal(y: length, h: length) {
        let margin = root.over ? root.more : 0px;
        if (y + flick.content-y < margin) {
            flick.content-y = min(0px, margin - y);
        } else if (y + h + flick.content-y > root.height - margin) {
            flick.content-y = max(root.height - root.content, root.height - margin - y - h);
        }
    }
    changed height => { root.settle(); }
    changed content => { root.settle(); }
    if !root.segmented: Rectangle {
        x: parent.width - Theme.hair;
        width: Theme.hair;
        background: Theme.rule;
    }
    flick := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: root.content;
        interactive: root.over;
        if root.segmented: Rectangle {
            y: 0px;
            width: parent.width;
            height: root.content;
            border-radius: Theme.radius + 4px;
            background: Theme.tab-off;
        }
        col := VerticalLayout {
            y: 0px;
            width: parent.width;
            height: root.content;
            alignment: start;
            for name[i] in root.names: TabItem {
                vertical: true;
                min-height: root.item;
                max-height: root.item;
                text: name == "" ? root.empty-name : name;
                selected: i == root.current;
                cursor: i == root.cursor;
                active: i == root.keep;
                clicked => { root.picked(i); }
                reveal => { root.reveal(self.y, self.height); }
            }
        }
    }
    if root.over && flick.content-y < -0.5px: TabMore {
        y: 0px;
        width: parent.width;
        height: root.more;
        vertical: true;
        glyph: "▲";
        clicked => { flick.content-y = min(0px, flick.content-y + root.height * 0.7); }
    }
    if root.over && flick.content-y > root.height - root.content + 0.5px: TabMore {
        y: parent.height - root.more;
        width: parent.width;
        height: root.more;
        vertical: true;
        last: true;
        glyph: "▼";
        clicked => { flick.content-y = max(root.height - root.content, flick.content-y - root.height * 0.7); }
    }
}

// How wide a rail's label needs to be at the small type in bold: on one line, or where it has a space to break at, on
// the wider of its two lines when that is narrower.
component RailNeed inherits Rectangle {
    in property <TabLabel> label;
    preferred-width: root.label.bottom == "" ? whole.preferred-width : min(whole.preferred-width, max(top.preferred-width, bottom.preferred-width));
    whole := Text {
        visible: false;
        width: 0px;
        height: 0px;
        text: root.label.short;
        font-size: Theme.small;
        font-weight: 700;
    }
    top := Text {
        visible: false;
        width: 0px;
        height: 0px;
        text: root.label.top;
        font-size: Theme.small;
        font-weight: 700;
    }
    bottom := Text {
        visible: false;
        width: 0px;
        height: 0px;
        text: root.label.bottom;
        font-size: Theme.small;
        font-weight: 700;
    }
}

// A tab of a rail: the whole width of the rail and its share of the height, its label horizontal, at the small type
// on one line or two (`fit` of it: 1 down to 70%, each line cut where it still does not fit).
component RailItem inherits Rectangle {
    in property <TabLabel> label;
    in property <bool> selected;
    in property <bool> cursor;
    in property <bool> active;
    in property <float> fit: 1.0;
    // The room for the text across, and for it on one line.
    in property <length> inner;
    // How far a folder's selected piece reaches past the rail's edge (this box is that much wider).
    in property <length> reach;
    callback clicked();
    callback reveal();
    property <length> size: Theme.small * root.fit;
    property <bool> one: root.label.bottom == "" || measure.preferred-width * root.fit <= root.inner + 0.5px;
    changed active => { if self.active { root.reveal(); } }
    changed y => { if self.active { root.reveal(); } }
    changed height => { if self.active { root.reveal(); } }
    measure := Text {
        visible: false;
        width: 0px;
        height: 0px;
        text: root.label.short;
        font-size: Theme.small;
        font-weight: 700;
    }
    TabShape {
        selected: root.selected;
        cursor: root.cursor;
        vertical: true;
        reach: root.reach;
    }
    // One line in the middle, or two meeting in it.
    Text {
        x: (root.width - root.reach - root.inner) / 2;
        y: 0px;
        width: root.inner;
        height: root.one ? parent.height : parent.height / 2;
        text: root.one ? root.label.short : root.label.top;
        color: root.selected ? Theme.tab-on-ink : Theme.tab-off-ink;
        font-size: root.size;
        font-weight: root.selected ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: root.one ? TextVerticalAlignment.center : TextVerticalAlignment.bottom;
        overflow: elide;
    }
    if !root.one: Text {
        x: (root.width - root.reach - root.inner) / 2;
        y: parent.height / 2;
        width: root.inner;
        height: parent.height / 2;
        text: root.label.bottom;
        color: root.selected ? Theme.tab-on-ink : Theme.tab-off-ink;
        font-size: root.size;
        font-weight: root.selected ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: TextVerticalAlignment.top;
        overflow: elide;
    }
    TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width - root.reach;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

// A rail: the side placement's column of tabs, from the top of its parent to the bottom, one continuous track. Its
// tabs share the height equally (each at least a touch target tall: with more than fit, the rail scrolls, an arrow box
// over each cut end). What the labels share is its heading at the top. The label is horizontal in the small type when
// every label fits the rail's width that way, else in 70% of it (a rotated label is not drawn: the software renderer
// does not rotate text, ui/TABS.md).
component Rail inherits Rectangle {
    in property <[TabLabel]> labels;
    in property <string> heading;
    in property <int> current;
    in property <int> cursor;
    // A folder's selected tab reaches this far past the rail's right edge, to the page it opens.
    in property <length> reach;
    callback picked(int);
    property <bool> segmented: Theme.tabs == TabStyle.segmented;
    property <length> over-edge: root.segmented ? 0px : root.reach;
    property <int> keep: root.cursor >= 0 ? root.cursor : root.current;
    property <length> more: Theme.touch * 0.6;
    out property <length> head: root.heading == "" ? 0px : Theme.small * 2;
    out property <length> room: max(0px, root.height - root.head);
    out property <length> item: max(Theme.touch, root.room / max(1, root.labels.length));
    property <length> content: root.labels.length * root.item;
    out property <bool> over: root.content > root.room + 0.5px;
    // The room for a label across: the rail less the tab's inset and the padding each side, so a bold label never
    // touches the tab's edges.
    property <length> inner: root.width - 2 * (Theme.tab-pad + Theme.pad-tight);
    // 1: the small type fits every label's width; else the least shrink that fits them all, at most to 70%.
    out property <float> fit: max(0.7, min(1.0, root.inner / max(1px, need.preferred-width)));
    callback fitted(float);
    changed fit => { root.fitted(root.fit); }
    init => { root.fitted(root.fit); }
    function settle() {
        flick.content-y = min(0px, max(root.room - root.content, flick.content-y));
    }
    function reveal(y: length, h: length) {
        let margin = root.over ? root.more : 0px;
        if (y + flick.content-y < margin) {
            flick.content-y = min(0px, margin - y);
        } else if (y + h + flick.content-y > root.room - margin) {
            flick.content-y = max(root.room - root.content, root.room - margin - y - h);
        }
    }
    changed room => { root.settle(); }
    changed content => { root.settle(); }
    need := VerticalLayout {
        width: 0px;
        height: 0px;
        for l in root.labels: RailNeed {
            label: l;
        }
    }
    // The track: a raised column where the tabs are lifted out of it, else the rule along the page's side.
    Rectangle {
        background: root.segmented ? Theme.tab-off : Theme.surface;
    }
    if !root.segmented: Rectangle {
        x: parent.width - Theme.hair;
        width: Theme.hair;
        background: Theme.rule;
    }
    if root.heading != "": FitText {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: root.head;
        text: root.heading;
        ink: Theme.muted;
        size: Theme.small;
    }
    flick := Flickable {
        x: 0px;
        y: root.head;
        width: parent.width + root.over-edge;
        height: root.room;
        content-height: root.content;
        interactive: root.over;
        for l[i] in root.labels: RailItem {
            x: 0px;
            y: i * root.item;
            width: root.width + root.over-edge;
            height: root.item;
            label: l;
            inner: root.inner;
            reach: root.over-edge;
            fit: root.fit;
            selected: i == root.current;
            cursor: i == root.cursor;
            active: i == root.keep;
            clicked => { root.picked(i); }
            reveal => { root.reveal(self.y, self.height); }
        }
    }
    if root.over && flick.content-y < -0.5px: TabMore {
        y: root.head;
        width: parent.width;
        height: root.more;
        vertical: true;
        glyph: "▲";
        clicked => { flick.content-y = min(0px, flick.content-y + root.room * 0.7); }
    }
    if root.over && flick.content-y > root.room - root.content + 0.5px: TabMore {
        y: parent.height - root.more;
        width: parent.width;
        height: root.more;
        vertical: true;
        last: true;
        glyph: "▼";
        clicked => { flick.content-y = max(root.room - root.content, flick.content-y - root.room * 0.7); }
    }
}

// A strip of tabs, or with `vertical` a column of them (each `item` tall), or with `rail` the side placement's rail
// (the full height of this component, the tabs sharing it). `current` is the selected one (-1: none), `cursor` the one
// the border cursor is on (-1: none); a tap says `picked`, nothing else changes. `labels` and `heading` (what the names
// share, shown once) are the short forms of a strip that overflows and of a rail, one label per name.
export component TabBar inherits Rectangle {
    in property <[string]> names;
    in property <[TabLabel]> labels;
    in property <string> heading;
    in property <int> current;
    in property <int> cursor: -1;
    in property <bool> vertical;
    in property <bool> rail;
    in property <length> reach;
    in property <length> item: Theme.touch;
    in property <string> empty-name: "General";
    callback picked(int);
    // A rail says how much of the small type its labels got (1, or down to 0.7).
    callback fitted(float);
    if !root.vertical && !root.rail: HTabs {
        width: parent.width;
        height: parent.height;
        names: root.names;
        labels: root.labels;
        heading: root.heading;
        current: root.current;
        cursor: root.cursor;
        empty-name: root.empty-name;
        picked(i) => { root.picked(i); }
    }
    if root.vertical && !root.rail: VTabs {
        width: parent.width;
        height: parent.height;
        names: root.names;
        current: root.current;
        cursor: root.cursor;
        empty-name: root.empty-name;
        item: root.item;
        picked(i) => { root.picked(i); }
    }
    if root.rail: Rail {
        width: parent.width;
        height: parent.height;
        labels: root.labels;
        heading: root.heading;
        current: root.current;
        cursor: root.cursor;
        reach: root.reach;
        picked(i) => { root.picked(i); }
        fitted(f) => { root.fitted(f); }
    }
}

// Two levels: pages, and under each the page's tabs (none for a page with fewer than two), placed as the theme says
// (`Theme.tab-placement`): `top` two strips stacked, the pages over the tabs, over the content; `side` two rails
// at the left, from the top of this component to its bottom, the pages' and then the tabs', the content after them;
// `auto` whichever of the two leaves the content the larger area at this size. This component is the whole of the
// screen below the bar; `reserve` is a height at the bottom the content leaves free (a message), not the rails.
// The content goes where the out properties say, in this component's own pixels.
export component TabPages inherits Rectangle {
    in property <[string]> pages;
    in property <[TabLabel]> page-labels;
    in property <string> page-heading;
    in property <int> page;
    in property <int> page-cursor: -1;
    in property <[string]> tabs;
    in property <[TabLabel]> tab-labels;
    in property <string> tab-heading;
    in property <int> tab;
    in property <int> tab-cursor: -1;
    in property <length> reserve;
    callback page-picked(int);
    callback tab-picked(int);
    // How much of the small type each rail's labels got: 1, or down to 0.7 (a rail the labels of which do not fit across).
    out property <float> pages-fit: 1.0;
    out property <float> tabs-fit: 1.0;
    property <bool> has-pages: root.pages.length > 1;
    property <bool> has-tabs: root.tabs.length > 1;
    // A rail's width: fixed by the theme's type and spacing, at most a share of the width.
    out property <length> rail: min(Theme.rail-width, root.width * Theme.side-share);
    property <length> rails: (root.has-pages ? root.rail : 0px) + (root.has-tabs ? root.rail : 0px) + (root.has-pages && root.has-tabs ? Theme.gap : 0px);
    property <length> rows: (root.has-pages ? Theme.touch + Theme.gap : 0px) + (root.has-tabs ? Theme.touch + Theme.gap : 0px);
    // The content's room in each placement, and the one that has more of it.
    property <length> side-x: root.rails > 0px ? root.rails + Theme.margin : Theme.margin;
    property <length> side-w: max(0px, root.width - root.side-x - Theme.margin);
    property <length> side-h: max(0px, root.height - 2 * Theme.margin - root.reserve);
    property <length> top-w: max(0px, root.width - 2 * Theme.margin);
    property <length> top-h: max(0px, root.height - 2 * Theme.margin - root.reserve - root.rows);
    out property <float> side-area: root.side-w / 1px * (root.side-h / 1px);
    out property <float> top-area: root.top-w / 1px * (root.top-h / 1px);
    // 0 two strips, 1 two rails.
    out property <int> mode: Theme.tab-placement == TabPlacement.top ? 0 : Theme.tab-placement == TabPlacement.side ? 1 : root.side-area > root.top-area ? 1 : 0;
    property <bool> side: root.mode == 1;
    out property <length> content-x: root.side ? root.side-x : Theme.margin;
    out property <length> content-y: root.side ? Theme.margin : Theme.margin + root.rows;
    out property <length> content-width: root.side ? root.side-w : root.top-w;
    out property <length> content-height: root.side ? root.side-h : root.top-h;
    if root.has-pages: TabBar {
        x: root.side ? 0px : Theme.margin;
        y: root.side ? 0px : Theme.margin;
        width: root.side ? root.rail : root.width - 2 * Theme.margin;
        height: root.side ? root.height : Theme.touch;
        rail: root.side;
        reach: root.has-tabs ? Theme.gap : Theme.margin;
        names: root.pages;
        labels: root.page-labels;
        heading: root.page-heading;
        current: root.page;
        cursor: root.page-cursor;
        picked(i) => { root.page-picked(i); }
        fitted(f) => { root.pages-fit = f; }
    }
    if root.has-tabs: TabBar {
        x: root.side ? (root.has-pages ? root.rail + Theme.gap : 0px) : Theme.margin;
        y: root.side ? 0px : Theme.margin + (root.has-pages ? Theme.touch + Theme.gap : 0px);
        width: root.side ? root.rail : root.width - 2 * Theme.margin;
        height: root.side ? root.height : Theme.touch;
        rail: root.side;
        reach: Theme.margin;
        names: root.tabs;
        labels: root.tab-labels;
        heading: root.tab-heading;
        current: root.tab;
        cursor: root.tab-cursor;
        picked(i) => { root.tab-picked(i); }
        fitted(f) => { root.tabs-fit = f; }
    }
}

// Where an item's color goes in a list row (drawListRow): a mark at the left or right end, a dot,
// or nothing here when the row itself is tinted (`Theme.row-fill`). `tint` is the item's color;
// `shown` false draws nothing.
export component RowMark inherits Rectangle {
    in property <color> tint;
    in property <bool> shown;
    if root.shown && Theme.rows == RowStyle.left: Rectangle {
        x: Theme.pad;
        y: root.height * 0.22;
        width: Theme.mark;
        height: root.height * 0.56;
        border-radius: Theme.mark / 2;
        background: root.tint;
    }
    if root.shown && Theme.rows == RowStyle.right: Rectangle {
        x: root.width - Theme.pad - Theme.mark;
        y: root.height * 0.22;
        width: Theme.mark;
        height: root.height * 0.56;
        border-radius: Theme.mark / 2;
        background: root.tint;
    }
    if root.shown && Theme.rows == RowStyle.dot: Rectangle {
        property <length> d: min(12px, root.height * 0.3);
        x: 13px - self.d / 2;
        y: (root.height - self.d) / 2;
        width: self.d;
        height: self.d;
        border-radius: self.d / 2;
        background: root.tint;
    }
}

// A slider's track, fill and thumbs by the slider style (drawLinearSlider), across or upright; a
// drawbar fills from the top. A range has two thumbs. Drawn over the whole of its box: the thumbs
// reach half their size past the ends, so a screen insets the box by `Theme.thumb / 2` each end.
export component SliderBar inherits Rectangle {
    in property <float> norm;
    in property <float> high: -1;
    in property <bool> bipolar;
    in property <bool> upright;
    in property <bool> from-top;
    in property <bool> lit;
    property <length> cross: upright ? self.width : self.height;
    // The track: 4 px (line), 3 (cap); filled, a quarter of the box's width, at most 6.
    property <length> thick: Theme.sliders == SliderStyle.cap ? 3px : Theme.sliders == SliderStyle.line ? 4px : min(6px, self.cross * 0.25);
    property <length> along: upright ? self.height : self.width;
    property <float> a: high >= 0 ? norm : bipolar ? min(norm, 0.5) : from-top ? 1 - norm : 0;
    property <float> b: high >= 0 ? high : bipolar ? max(norm, 0.5) : from-top ? 1 : norm;
    Rectangle {
        x: upright ? (parent.width - root.thick) / 2 : 0;
        y: upright ? 0 : (parent.height - root.thick) / 2;
        width: upright ? root.thick : parent.width;
        height: upright ? parent.height : root.thick;
        border-radius: root.thick / 2;
        background: Theme.slider-track;
    }
    // The fill: across from the left, upright from the bottom (a drawbar from the top).
    Rectangle {
        x: upright ? (parent.width - root.thick) / 2 : root.a * root.along;
        y: upright ? (1 - root.b) * root.along : (parent.height - root.thick) / 2;
        width: upright ? root.thick : (root.b - root.a) * root.along;
        height: upright ? (root.b - root.a) * root.along : root.thick;
        border-radius: root.thick / 2;
        background: root.lit ? Theme.accent : Theme.accent-dim;
    }
    // A centered range's middle.
    if root.bipolar && root.high < 0: Rectangle {
        x: upright ? (parent.width - self.width) / 2 : (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: upright ? 2 * root.thick + 2px : Theme.hair;
        height: upright ? Theme.hair : 2 * root.thick + 2px;
        background: Theme.muted;
    }
    for v[i] in root.high >= 0 ? [root.norm, root.high] : [root.from-top ? 1 - root.norm : root.norm]: Thumb {
        size: Theme.thumb;
        upright: root.upright;
        x: upright ? (parent.width - self.width) / 2 : v * root.along - self.width / 2;
        y: upright ? (1 - v) * root.along - self.height / 2 : (parent.height - self.height) / 2;
    }
}

// A level meter's bar: `value` is the place along -60..+6 dB, 0 to 1. The green turns yellow at
// -12 dB and red at -3 dB (the JUCE meters' zones, Icons.h).
export component Meter inherits Rectangle {
    in property <float> value;
    property <float> yellow: 0.7273;
    property <float> red: 0.8636;
    background: Theme.track;
    border-radius: self.width / 2;
    clip: true;
    Rectangle {
        x: 0;
        width: parent.width;
        height: parent.height * min(root.value, root.yellow);
        y: parent.height - self.height;
        background: Theme.positive;
    }
    Rectangle {
        x: 0;
        width: parent.width;
        height: parent.height * max(0, min(root.value, root.red) - root.yellow);
        y: parent.height * (1 - min(root.value, root.red));
        background: Theme.warning;
    }
    Rectangle {
        x: 0;
        width: parent.width;
        height: parent.height * max(0, root.value - root.red);
        y: parent.height * (1 - root.value);
        background: Theme.danger;
    }
}
