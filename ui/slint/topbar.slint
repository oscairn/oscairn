// SPDX-License-Identifier: AGPL-3.0-or-later
// The top bar (RFC 0030): Home, where the musician is, the open Performance and its scene, the
// tempo, and the resource section: CPU over RAM, each a bar, a percent, both or neither. Every
// part right of the Performance has a fixed width, so a changing figure never moves anything:
// an update repaints its own digits and bar and nothing else (src/tests.rs proves it).

import { Theme, Field } from "theme.slint";

// The section's columns, from the theme's small type: whole pixels, fixed for a theme.
global Columns {
    out property <length> cell: round(Theme.small * 0.62 / 1px) * 1px; // a digit
    out property <length> sign: round(Theme.small * 0.95 / 1px) * 1px; // "%"
    out property <length> label: round(Theme.small * 2.5 / 1px) * 1px; // "CPU", "RAM"
    out property <length> bar: round(Theme.small * 5 / 1px) * 1px;
    out property <length> percent: 3 * cell + sign;
    out property <length> row: round(Theme.small * 1.25 / 1px) * 1px;
    out property <length> meter: 6px; // a meter bar's thickness
    out property <length> icon: 24px; // the Home glyph
    out property <length> pill: 36px; // the Performance field's height
    out property <length> rec-text: round(Theme.small * 5.4 / 1px) * 1px; // "REC 99:59", fixed so the seconds never move it
    out property <length> rec-slow: round(Theme.small * 6 / 1px) * 1px; // "disk slow"
}

// A whole percent in fixed cells, a digit each ("  7%", " 42%", "100%"): tabular, whatever the font.
component Percent inherits Rectangle {
    in property <int> value;
    in property <bool> known;
    in property <color> ink;
    property <length> cell: Columns.cell;
    width: Columns.percent;
    for i in 3: Text {
        x: i * root.cell;
        width: root.cell;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: Theme.small;
        color: root.ink;
        text: !root.known ? (i == 2 ? "–" : "") : i == 0 ? (root.value >= 100 ? "1" : "") : i == 1 ? (root.value >= 10 ? "\{mod(floor(root.value / 10), 10)}" : "") : "\{mod(root.value, 10)}";
    }
    Text {
        x: 3 * root.cell;
        width: Columns.sign;
        horizontal-alignment: right;
        vertical-alignment: center;
        font-size: Theme.small;
        color: root.ink;
        text: "%";
    }
}

// One meter's row: its name, then its bar and its percent in the section's columns.
component Meter inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <bool> known;
    in property <int> level; // 0, 1 at 75%, 2 at 90%
    in property <bool> bar;
    in property <bool> percent;
    in property <length> percent-x;
    property <color> ink: level == 2 ? Theme.danger : level == 1 ? Theme.warning : Theme.muted;
    property <color> fill: level == 2 ? Theme.danger : level == 1 ? Theme.warning : Theme.accent;
    height: Columns.row;
    Text {
        x: 0;
        width: Columns.label;
        vertical-alignment: center;
        font-size: Theme.small;
        color: Theme.muted;
        text: root.label;
    }
    if root.bar: Rectangle {
        x: Columns.label;
        y: (parent.height - self.height) / 2;
        width: Columns.bar;
        height: Columns.meter;
        background: Theme.raised;
        Rectangle {
            x: 0;
            width: root.known ? parent.width * root.value / 100 : 0;
            background: root.fill;
        }
    }
    if root.percent: Percent {
        x: root.percent-x;
        value: root.value;
        known: root.known;
        ink: root.ink;
    }
}

// A take is recording (the JUCE record buttons' message, Recording.cpp): a filled dot and "REC m:ss"
// in the danger color, and "disk slow" when the writer is behind. Fixed widths, so the seconds
// changing repaint their own cells only. Shown by the top bar and on Play.
export component RecordingMark inherits Rectangle {
    out property <length> dot: Theme.small * 0.7;
    width: Bar.recording-width;
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: root.dot;
        height: root.dot;
        border-radius: root.dot / 2;
        background: Theme.danger;
    }
    Text {
        x: Theme.small;
        width: Columns.rec-text;
        vertical-alignment: center;
        font-size: Theme.small;
        font-weight: 700;
        color: Theme.danger;
        text: "REC " + Bar.recording-time;
    }
    if Bar.recording-behind: Text {
        x: Theme.small + Columns.rec-text + Theme.pad-narrow;
        width: Columns.rec-slow;
        vertical-alignment: center;
        font-size: Theme.small;
        color: Theme.danger;
        text: "disk slow";
    }
}

// What the top bar shows, set by shell.rs.
export global Bar {
    in property <bool> recording; // a take is recording
    in property <string> recording-time; // "m:ss"
    in property <bool> recording-behind; // its writer is behind: the disk is slow
    out property <length> recording-width: !recording ? 0px : Theme.small + Columns.rec-text + (recording-behind ? Theme.pad-narrow + Columns.rec-slow : 0px);
    in property <string> where: "Home";
    in property <bool> home-button;
    in property <string> performance;
    in property <string> scene;
    in property <string> tempo;
    in property <int> cpu;
    in property <bool> cpu-known;
    in property <int> cpu-level;
    in property <int> ram;
    in property <bool> ram-known;
    in property <int> ram-level;
    in property <bool> cpu-bar: true;
    in property <bool> cpu-percent: true;
    in property <bool> ram-bar: true;
    in property <bool> ram-percent: true;
    callback home();
}

export component TopBar inherits Rectangle {
    // Where the resource section and the tempo are, for the tests of their fixed widths.
    out property <length> resources-x: resources.x;
    out property <length> resources-width: resources.width;
    out property <length> tempo-x: tempo.x;
    property <bool> any-bar: Bar.cpu-bar || Bar.ram-bar;
    property <bool> any-percent: Bar.cpu-percent || Bar.ram-percent;
    property <bool> any: any-bar || any-percent;
    height: Theme.bar-height;
    background: Theme.background;
    // The JUCE bar's line under it.
    Rectangle {
        y: parent.height - Theme.hair;
        height: Theme.hair;
        background: Theme.track;
    }
    HorizontalLayout {
        padding-left: Theme.margin;
        padding-right: Theme.pad;
        spacing: Theme.pad-narrow;
        if Bar.home-button: TouchArea {
            width: Theme.touch;
            clicked => { Bar.home(); }
            Image {
                width: Columns.icon;
                height: Columns.icon;
                source: @image-url("../../hosts/standalone/icons/house.svg");
                colorize: Theme.text;
            }
        }
        Text {
            vertical-alignment: center;
            font-size: Theme.body;
            font-weight: 700;
            color: Theme.text;
            text: Bar.where;
        }
        // The open Performance and its scene: a pill, as wide as what is left.
        Rectangle {
            horizontal-stretch: 1;
            if Bar.performance != "": Field {
                y: (parent.height - self.height) / 2;
                height: Columns.pill;
                Text {
                    x: Theme.pad-wide;
                    width: parent.width - 2 * Theme.pad-wide;
                    vertical-alignment: center;
                    overflow: elide;
                    font-size: Theme.small;
                    color: Theme.text;
                    text: Bar.scene == "" ? Bar.performance : Bar.performance + "  ·  " + Bar.scene;
                }
            }
        }
        if Bar.recording: RecordingMark {}
        tempo := Text {
            width: round(Theme.small * 6.5 / 1px) * 1px;
            horizontal-alignment: right;
            vertical-alignment: center;
            font-size: Theme.small;
            color: Theme.muted;
            text: Bar.tempo;
        }
        resources := Rectangle {
            width: !root.any ? 0 : Columns.label + (root.any-bar ? Columns.bar + Theme.pad-narrow : 0) + (root.any-percent ? Columns.percent : 0);
            VerticalLayout {
                alignment: center;
                spacing: Theme.pad-tight;
                if Bar.cpu-bar || Bar.cpu-percent: Meter {
                    label: "CPU";
                    value: Bar.cpu;
                    known: Bar.cpu-known;
                    level: Bar.cpu-level;
                    bar: Bar.cpu-bar;
                    percent: Bar.cpu-percent;
                    percent-x: Columns.label + (root.any-bar ? Columns.bar + Theme.pad-narrow : 0);
                }
                if Bar.ram-bar || Bar.ram-percent: Meter {
                    label: "RAM";
                    value: Bar.ram;
                    known: Bar.ram-known;
                    level: Bar.ram-level;
                    bar: Bar.ram-bar;
                    percent: Bar.ram-percent;
                    percent-x: Columns.label + (root.any-bar ? Columns.bar + Theme.pad-narrow : 0);
                }
            }
        }
    }
}
