// SPDX-License-Identifier: AGPL-3.0-or-later
// The top bar (RFC 0030): Home, where the musician is, the open Performance and its scene, the
// tempo, and the resource section: CPU over RAM, each a bar, a percent, both or neither. Every
// part right of the Performance has a fixed width, so a changing figure never moves anything:
// an update repaints its own digits and bar and nothing else (src/tests.rs proves it).

import { Theme, Field, Button, Cursor, FitText } from "theme.slint";
import { Loading } from "loading.slint";

// The section's columns, from the theme's small type: whole pixels, fixed for a theme.
global Columns {
    out property <length> cell: round(Theme.small * 0.62 / 1px) * 1px; // a digit
    out property <length> sign: round(Theme.small * 0.95 / 1px) * 1px; // "%"
    out property <length> label: round(Theme.small * 2.5 / 1px) * 1px; // "CPU", "RAM"
    out property <length> bar: round(Theme.small * 5 / 1px) * 1px;
    out property <length> percent: 3 * cell + sign;
    out property <length> row: round(Theme.small * 1.25 / 1px) * 1px;
    out property <length> meter: 6px; // a meter bar's thickness
    out property <length> icon: 24px; // the Home glyph
    out property <length> pill: 36px; // the Performance field's height
    out property <length> rec-text: round(Theme.small * 5.4 / 1px) * 1px; // "REC 99:59", fixed so the seconds never move it
    out property <length> action: 36px; // an action button's height
    out property <length> action-max: 2 * Theme.button-width; // its widest, a long edit's name elided
    out property <length> rec-slow: round(Theme.small * 6 / 1px) * 1px; // "disk slow"
    out property <length> rec-slow-short: round(Theme.small * 3 / 1px) * 1px; // "slow", on the narrowest bar
    out property <length> pill-min: round(Theme.small * 9 / 1px) * 1px; // the Performance's name keeps at least this
    out property <length> pill-comfort: round(Theme.small * 16 / 1px) * 1px; // the room the name has before anything is folded away
}

// A whole percent in fixed cells, a digit each ("  7%", " 42%", "100%"): tabular, whatever the font.
component Percent inherits Rectangle {
    in property <int> value;
    in property <bool> known;
    in property <color> ink;
    property <length> cell: Columns.cell;
    width: Columns.percent;
    for i in 3: Text {
        x: i * root.cell;
        width: root.cell;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: Theme.small;
        color: root.ink;
        text: !root.known ? (i == 2 ? "–" : "") : i == 0 ? (root.value >= 100 ? "1" : "") : i == 1 ? (root.value >= 10 ? "\{mod(floor(root.value / 10), 10)}" : "") : "\{mod(root.value, 10)}";
    }
    Text {
        x: 3 * root.cell;
        width: Columns.sign;
        horizontal-alignment: right;
        vertical-alignment: center;
        font-size: Theme.small;
        color: root.ink;
        text: "%";
    }
}

// One meter's row: its name, then its bar and its percent in the section's columns.
component Meter inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <bool> known;
    in property <int> level; // 0, 1 at 75%, 2 at 90%
    in property <bool> bar;
    in property <bool> percent;
    in property <length> percent-x;
    in property <bool> labeled: true; // a narrow bar drops the names before it cuts a meter
    in property <length> label-width: Columns.label;
    in property <length> bar-width: Columns.bar;
    property <color> ink: level == 2 ? Theme.danger : level == 1 ? Theme.warning : Theme.muted;
    property <color> fill: level == 2 ? Theme.danger : level == 1 ? Theme.warning : Theme.accent;
    height: Columns.row;
    if root.labeled: Text {
        x: 0;
        width: Columns.label;
        vertical-alignment: center;
        font-size: Theme.small;
        color: Theme.muted;
        text: root.label;
    }
    if root.bar: Rectangle {
        x: root.label-width;
        y: (parent.height - self.height) / 2;
        width: root.bar-width;
        height: Columns.meter;
        background: Theme.raised;
        Rectangle {
            x: 0;
            width: root.known ? parent.width * root.value / 100 : 0;
            background: root.fill;
        }
    }
    if root.percent: Percent {
        x: root.percent-x;
        value: root.value;
        known: root.known;
        ink: root.ink;
    }
}

// A take is recording (the JUCE record buttons' message, Recording.cpp): a filled dot and "REC m:ss"
// in the danger color, and "disk slow" when the writer is behind. Fixed widths, so the seconds
// changing repaint their own cells only. Shown by the top bar, once (Play has no mark of its own).
export component RecordingMark inherits Rectangle {
    out property <length> dot: Theme.small * 0.7;
    in property <bool> short; // "slow" for "disk slow": the narrowest bar's last saving
    width: Bar.recording-width - (root.short && Bar.recording-behind ? Columns.rec-slow - Columns.rec-slow-short : 0px);
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: root.dot;
        height: root.dot;
        border-radius: root.dot / 2;
        background: Theme.danger;
    }
    Text {
        x: Theme.small;
        width: Columns.rec-text;
        vertical-alignment: center;
        font-size: Theme.small;
        font-weight: 700;
        color: Theme.danger;
        text: "REC " + Bar.recording-time;
    }
    if Bar.recording-behind: Text {
        x: Theme.small + Columns.rec-text + Theme.pad-narrow;
        width: root.short ? Columns.rec-slow-short : Columns.rec-slow;
        vertical-alignment: center;
        font-size: Theme.small;
        color: Theme.danger;
        text: root.short ? "slow" : "disk slow";
    }
}

// The title: the path of what is open, as long as it fits. A path too long for the room loses its leading
// parts (the options the bar is given, longest first); the shortest left is then set at 70% of the type, and only then cut.
component PathTitle inherits Rectangle {
    in property <[string]> options;
    in property <string> notice; // what the last action said: in the title's place for a while
    in property <color> ink: Theme.text;
    in property <length> size: Theme.body;
    in property <bool> bold: true;
    in property <TextHorizontalAlignment> align: TextHorizontalAlignment.left;
    property <length> room: root.width;
    property <int> n: root.notice != "" ? 1 : min(4, root.options.length);
    property <string> t0: root.notice != "" ? root.notice : root.options.length > 0 ? root.options[0] : "";
    property <string> t1: root.options.length > 1 ? root.options[1] : "";
    property <string> t2: root.options.length > 2 ? root.options[2] : "";
    property <string> t3: root.options.length > 3 ? root.options[3] : "";
    property <length> w0: m0.preferred-width;
    property <length> w1: m1.preferred-width;
    property <length> w2: m2.preferred-width;
    property <length> w3: m3.preferred-width;
    // The longest option that fits whole; else the last, at 70%.
    out property <int> at: n > 0 && w0 <= room + 0.5px ? 0 : n > 1 && w1 <= room + 0.5px ? 1 : n > 2 && w2 <= room + 0.5px ? 2 : n > 3 && w3 <= room + 0.5px ? 3 : -1;
    out property <bool> shrunk: at < 0 && n > 0;
    out property <bool> cut: at < 0 && n > 0 && (n == 1 ? w0 : n == 2 ? w1 : n == 3 ? w2 : w3) * 0.7 > room + 0.5px;
    out property <string> shown: at == 0 ? t0 : at == 1 ? t1 : at == 2 ? t2 : at == 3 ? t3 : n == 1 ? t0 : n == 2 ? t1 : n == 3 ? t2 : t3;
    m0 := Text { visible: false; text: root.t0; font-size: root.size; font-weight: root.bold ? 700 : 400; }
    m1 := Text { visible: false; text: root.t1; font-size: root.size; font-weight: root.bold ? 700 : 400; }
    m2 := Text { visible: false; text: root.t2; font-size: root.size; font-weight: root.bold ? 700 : 400; }
    m3 := Text { visible: false; text: root.t3; font-size: root.size; font-weight: root.bold ? 700 : 400; }
    Text {
        width: parent.width;
        height: parent.height;
        text: root.shown;
        color: root.ink;
        font-size: root.size * (root.shrunk ? 0.7 : 1.0);
        font-weight: root.bold ? 700 : 400;
        horizontal-alignment: root.align;
        vertical-alignment: center;
        overflow: elide;
    }
}

// One action of the screen shown (undo, save, ...): a button; `cursor` is the focus border.
export struct BarAction {
    label: string,
    enabled: bool,
    cursor: bool,
    icon: int, // 0 none, 1 undo, 2 redo: what a narrow bar draws in place of the words
    on: bool, // a toggle of the screen that is on (lit)
}

component ActionButton inherits Rectangle {
    in property <BarAction> data;
    in property <length> cap: Columns.action-max; // the widest it gets, a long edit's name elided
    in property <bool> compact; // an icon in place of the words where it has one
    // Record (3) and Capture (4) are icons always; Undo and Redo only in a narrow bar.
    property <bool> icon-only: (root.compact && root.data.icon > 0) || root.data.icon >= 3;
    callback clicked();
    width: root.icon-only ? Columns.action : min(measure.preferred-width + 2 * Theme.pad-wide, root.cap);
    measure := Text {
        visible: false;
        font-size: Theme.button;
        font-weight: 700;
        text: root.data.label;
    }
    Button {
        y: (parent.height - self.height) / 2;
        height: Columns.action;
        text: root.icon-only ? "" : root.data.label;
        enabled: root.data.enabled;
        on: root.data.on;
        clicked => { root.clicked(); }
    }
    // Record: a ring in the danger color, filled while a take records.
    if root.data.icon == 3: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Columns.icon * 0.6;
        height: self.width;
        border-radius: self.width / 2;
        border-width: Theme.cursor-width;
        border-color: Theme.danger;
        background: root.data.on ? Theme.danger : transparent;
        opacity: root.data.enabled ? 1 : Theme.disabled;
    }
    if root.icon-only && root.data.icon != 3: Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Columns.icon * 0.85;
        height: Columns.icon * 0.85;
        source: root.data.icon == 1 ? @image-url("../../hosts/standalone/icons/undo-2.svg") : root.data.icon == 2 ? @image-url("../../hosts/standalone/icons/redo-2.svg") : @image-url("../../hosts/standalone/icons/history.svg");
        colorize: Theme.text;
        opacity: root.data.enabled ? 1 : Theme.disabled;
    }
    Cursor {
        y: (parent.height - Columns.action) / 2;
        height: Columns.action;
        corner: Theme.button-radius(Columns.action);
        shown: root.data.cursor;
        always: true;
    }
}

// What the top bar shows, set by shell.rs.
export global Bar {
    in property <[BarAction]> actions; // what the screen shown offers
    in property <bool> pill-cursor; // the cursor is on the Performance's name (Save As New)
    in property <string> notice; // what the last action said ("Saved"), in the name's place for a while
    // A wait the player expects ("Loading Dusk Choir"): a chip at the title's right edge while it lasts, with the engine's
    // progress when it reports one (0..1; negative: none, the bar sweeps). The name beside it stays.
    in property <string> loading;
    in property <float> loading-progress: -1;
    callback action(int);
    // A bar too narrow for its actions folds them into one "More" (a menu of them): set by the bar, which the shell reads.
    in-out property <bool> more;
    in property <bool> more-cursor;
    callback more-tapped();
    callback more-changed();
    callback pill-tapped();
    in property <bool> recording; // a take is recording
    in property <string> recording-time; // "m:ss"
    in property <bool> recording-behind; // its writer is behind: the disk is slow
    out property <length> recording-width: !recording ? 0px : Theme.small + Columns.rec-text + (recording-behind ? Theme.pad-narrow + Columns.rec-slow : 0px);
    // Where the musician is, as the path of what is open, longest first: each option drops one more leading
    // part and starts "… › " (the bar picks the longest that fits, then shrinks the shortest to 70%, then cuts).
    in property <[string]> path;
    // The title is the Performance's name (Play): a field, a tap on it is Save As New.
    in property <bool> title-field;
    in property <bool> home-button;
    // Back: the screen has somewhere to go back to; the cursor on it.
    in property <bool> back;
    in property <bool> back-cursor;
    callback back-tapped();
    in property <string> performance;
    in property <string> scene;
    in property <string> tempo;
    in property <int> cpu;
    in property <bool> cpu-known;
    in property <int> cpu-level;
    in property <int> ram;
    in property <bool> ram-known;
    in property <int> ram-level;
    in property <bool> cpu-bar: true;
    in property <bool> cpu-percent: true;
    in property <bool> ram-bar: true;
    in property <bool> ram-percent: true;
    callback home();
}

export component TopBar inherits Rectangle {
    // Where the resource section and the tempo are, for the tests of their fixed widths.
    out property <length> resources-x: resources.x;
    out property <length> resources-width: resources.width;
    out property <length> tempo-x: tempo.x;
    out property <length> pill-x: pill.x;
    out property <length> pill-width: pill.width;
    // The title as drawn: which of the path's options, whether it is at 70% of the type, whether that is cut.
    out property <string> title-shown: title.shown;
    out property <bool> title-shrunk: title.shrunk;
    out property <bool> title-cut: title.cut;
    // What a narrow bar gives up, in this order: the actions (their words, undo and redo first, then all of them folded
    // into "More") while the name keeps its comfortable room; then the name's room down to its least; then the
    // meters' names, then their bars' length. The recording mark and the tempo stay.
    out property <int> actions-mode: n-actions == 0 ? 0 : room-for(w-full, res-full, rec-full) >= title-comfort ? 0 : room-for(w-icons, res-full, rec-full) >= title-comfort ? 1 : 2;
    // Then, in a bar still too narrow (a roomy theme's type and spacing), a slow disk's words are shortened ("slow"), and
    // last of all the meters' bars go and their percents stay (mode 3).
    out property <int> meters-mode: actions-mode < 2 ? 0 : room-for(w-more, res-full, rec-full) >= Columns.pill-min ? 0 : room-for(w-more, res-nolabel, rec-full) >= Columns.pill-min ? 1 : room-for(w-more, res-narrow, rec-short-w) >= Columns.pill-min ? 2 : any-percent ? 3 : 2;
    out property <bool> rec-short: meters-mode >= 2 && room-for(w-more, res-narrow, rec-full) < Columns.pill-min;
    property <length> rec-short-w: Bar.recording-behind ? rec-full - (Columns.rec-slow - Columns.rec-slow-short) : rec-full;
    out property <length> rec-width: rec-short ? rec-short-w : rec-full;
    property <bool> bars-ok: meters-mode < 3;
    property <bool> bars-shown: any-bar && bars-ok;
    // The room the name wants before the actions give up their words: the title as it is written, up to the comfortable
    // room, and never less than the least (a short title such as "Routing" leaves its room to the actions).
    property <length> title-comfort: max(Columns.pill-min, min(Columns.pill-comfort, title-measure.preferred-width + (Bar.title-field ? 2 * Theme.pad-wide : 0px)));
    property <bool> any-bar: Bar.cpu-bar || Bar.ram-bar;
    property <bool> any-percent: Bar.cpu-percent || Bar.ram-percent;
    property <bool> any: any-bar || any-percent;
    property <int> n-actions: Bar.actions.length;
    // The items' spacing: a bar narrow for the type (a roomy theme on a small screen) spaces them by the least.
    property <length> gap: root.width < 48 * Theme.small ? Theme.pad-tight : Theme.pad-narrow;
    property <length> label-w: meters-mode == 0 ? Columns.label : 0px;
    property <length> bar-w: meters-mode == 2 ? Columns.bar / 2 : Columns.bar;
    property <length> percent-at: label-w + (bars-shown ? bar-w + gap : 0px);
    property <length> res-full: any ? Columns.label + (any-bar ? Columns.bar + gap : 0px) + (any-percent ? Columns.percent : 0px) : 0px;
    property <length> res-nolabel: any ? res-full - Columns.label : 0px;
    property <length> res-narrow: any ? (any-bar ? Columns.bar / 2 + gap : 0px) + (any-percent ? Columns.percent : 0px) : 0px;
    property <length> rec-full: Bar.recording-width;
    property <length> res-now: any ? percent-at + (any-percent ? Columns.percent : 0px) : 0px;
    property <length> w-full: n-actions > 0 ? full.preferred-width : 0px;
    property <length> w-icons: n-actions > 0 ? icons.preferred-width : 0px;
    property <length> w-more: n-actions > 0 ? more-measure.preferred-width + 2 * Theme.pad-wide : 0px;
    property <length> back-w: Bar.back ? back-measure.preferred-width + 2 * Theme.pad-wide : 0px;
    property <length> tempo-width: round(Theme.small * 5.8 / 1px) * 1px;
    // The items of the line: Home's button, Back, the title (the rest), the actions, the recording mark, the tempo, the meters.
    property <int> items: (Bar.home-button ? 1 : 0) + (Bar.back ? 1 : 0) + 1 + (n-actions > 0 ? 1 : 0) + (Bar.recording ? 1 : 0) + 1 + (any ? 1 : 0);
    // What the name has of the line when the actions take `actions` and the meters `meters`.
    pure function room-for(actions: length, meters: length, rec: length) -> length {
        return root.width - Theme.margin - Theme.pad - (Bar.home-button ? Theme.touch : 0px) - back-w - actions - rec - tempo-width - meters - (items - 1) * gap;
    }
    // The wait's chip: as wide as its words, never more than half the title's room; the title gives it that room.
    property <length> chip-width: Bar.loading == "" ? 0px : min(chip-measure.preferred-width, pill.width * 0.5);
    property <length> chip-room: Bar.loading == "" ? 0px : chip-width + Theme.pad-wide;
    height: Theme.bar-height;
    background: Theme.background;
    changed actions-mode => { Bar.more = self.actions-mode == 2; Bar.more-changed(); }
    init => { Bar.more = self.actions-mode == 2; }
    title-measure := Text {
        visible: false;
        font-size: Bar.title-field ? Theme.small : Theme.body;
        font-weight: Bar.title-field ? 400 : 700;
        text: Bar.path.length > 0 ? Bar.path[0] : "";
    }
    chip-measure := Text {
        visible: false;
        font-size: Theme.small;
        text: Bar.loading;
    }
    back-measure := Text {
        visible: false;
        font-size: Theme.button;
        font-weight: 700;
        text: "Back";
    }
    more-measure := Text {
        visible: false;
        font-size: Theme.button;
        font-weight: 700;
        text: "More";
    }
    // The actions as they would be at full size and with icons, only to know how wide they come to.
    Rectangle {
        visible: false;
        width: 0px;
        height: 0px;
        full := HorizontalLayout {
            spacing: root.gap;
            for action in Bar.actions: ActionButton {
                data: action;
                cap: min(Columns.action-max, root.width * 0.16);
            }
        }
        icons := HorizontalLayout {
            spacing: root.gap;
            for action in Bar.actions: ActionButton {
                data: action;
                compact: true;
                cap: min(Columns.action-max, root.width * 0.16);
            }
        }
    }
    // The JUCE bar's line under it.
    Rectangle {
        y: parent.height - Theme.hair;
        height: Theme.hair;
        background: Theme.track;
    }
    HorizontalLayout {
        padding-left: Theme.margin;
        padding-right: Theme.pad;
        spacing: root.gap;
        if Bar.home-button: TouchArea {
            width: Theme.touch;
            clicked => { Bar.home(); }
            Image {
                width: Columns.icon;
                height: Columns.icon;
                source: @image-url("../../hosts/standalone/icons/house.svg");
                colorize: Theme.text;
            }
        }
        if Bar.back: ActionButton {
            data: { label: "Back", enabled: true, cursor: Bar.back-cursor, icon: 0, on: false };
            clicked => { Bar.back-tapped(); }
        }
        // The title: the path of what is open, as wide as what is left (at least `pill-min`); on Play the
        // Performance's name in a field, where a tap is Save As New.
        pill := Rectangle {
            horizontal-stretch: 1;
            min-width: Columns.pill-min;
            if Bar.title-field: Field {
                y: (parent.height - self.height) / 2;
                height: Columns.pill;
                TouchArea {
                    clicked => { Bar.pill-tapped(); }
                }
                Cursor {
                    corner: Theme.field-radius(parent.height);
                    shown: Bar.pill-cursor;
                    always: true;
                }
            }
            title := PathTitle {
                x: Bar.title-field ? Theme.pad-wide : 0px;
                width: parent.width - 2 * self.x - root.chip-room;
                height: parent.height;
                options: Bar.path;
                notice: Bar.notice;
                size: Bar.title-field ? Theme.small : Theme.body;
                bold: !Bar.title-field;
                ink: Bar.notice == "" ? Theme.text : Theme.accent;
            }
            if Bar.loading != "": Loading {
                x: parent.width - self.width - (Bar.title-field ? Theme.pad-wide : 0px);
                y: (parent.height - self.height) / 2;
                width: root.chip-width;
                text: Bar.loading;
                progress: Bar.loading-progress;
            }
        }
        if root.n-actions > 0 && root.actions-mode < 2: HorizontalLayout {
            spacing: root.gap;
            for action[i] in Bar.actions: ActionButton {
                data: action;
                compact: root.actions-mode == 1;
                cap: min(Columns.action-max, root.width * 0.16); // a narrow bar elides a long name sooner
                clicked => { Bar.action(i); }
            }
        }
        if root.n-actions > 0 && root.actions-mode == 2: ActionButton {
            data: { label: "More", enabled: true, cursor: Bar.more-cursor, icon: 0, on: false };
            clicked => { Bar.more-tapped(); }
        }
        if Bar.recording: RecordingMark {
            short: root.rec-short;
        }
        tempo := Text {
            width: root.tempo-width;
            horizontal-alignment: right;
            vertical-alignment: center;
            font-size: Theme.small;
            color: Theme.muted;
            text: Bar.tempo;
        }
        resources := Rectangle {
            width: root.res-now;
            VerticalLayout {
                alignment: center;
                spacing: Theme.pad-tight;
                if (Bar.cpu-bar && root.bars-ok) || Bar.cpu-percent: Meter {
                    label: "CPU";
                    value: Bar.cpu;
                    known: Bar.cpu-known;
                    level: Bar.cpu-level;
                    bar: Bar.cpu-bar && root.bars-ok;
                    percent: Bar.cpu-percent;
                    percent-x: root.percent-at;
                    labeled: root.meters-mode == 0;
                    label-width: root.label-w;
                    bar-width: root.bar-w;
                }
                if (Bar.ram-bar && root.bars-ok) || Bar.ram-percent: Meter {
                    label: "RAM";
                    value: Bar.ram;
                    known: Bar.ram-known;
                    level: Bar.ram-level;
                    bar: Bar.ram-bar && root.bars-ok;
                    percent: Bar.ram-percent;
                    percent-x: root.percent-at;
                    labeled: root.meters-mode == 0;
                    label-width: root.label-w;
                    bar-width: root.bar-w;
                }
            }
        }
    }
}
